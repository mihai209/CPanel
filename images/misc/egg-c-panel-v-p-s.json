{
    "_comment": "Custom CPanel VPS egg using a GHCR-hosted proot runtime and downloadable Debian/Ubuntu rootfs archives.",
    "meta": {
        "version": "PTDL_v2",
        "update_url": null
    },
    "exported_at": "2026-03-31T22:00:00+03:00",
    "name": "CPanel VPS",
    "author": "mihai209@rocky.mihai209.cv",
    "description": "A custom VPS-style egg for CPanel using a GHCR-hosted proot runtime and downloadable Debian/Ubuntu rootfs archives. This keeps a real rootfs tree under /home/container/rootfs without depending on images.linuxcontainers.org.",
    "features": null,
    "docker_images": {
        "GHCR Rootfs Runtime": "ghcr.io/mihai209/cpanel-vps:rootfs"
    },
    "file_denylist": [],
    "startup": "./run.sh",
    "config": {
        "files": "{\r\n    \"vps.config\": {\r\n        \"parser\": \"properties\",\r\n        \"find\": {\r\n            \"internalip\": \"{{server.build.default.ip}}\",\r\n            \"port\": \"{{server.build.default.port}}\",\r\n            \"port2\": \"{{server.build.env.PORT2}}\",\r\n            \"port3\": \"{{server.build.env.PORT3}}\",\r\n            \"port4\": \"{{server.build.env.PORT4}}\",\r\n            \"port5\": \"{{server.build.env.PORT5}}\",\r\n            \"port6\": \"{{server.build.env.PORT6}}\",\r\n            \"port7\": \"{{server.build.env.PORT7}}\",\r\n            \"port8\": \"{{server.build.env.PORT8}}\",\r\n            \"port9\": \"{{server.build.env.PORT9}}\",\r\n            \"port10\": \"{{server.build.env.PORT10}}\",\r\n            \"port11\": \"{{server.build.env.PORT11}}\",\r\n            \"port12\": \"{{server.build.env.PORT12}}\",\r\n            \"port13\": \"{{server.build.env.PORT13}}\",\r\n            \"port14\": \"{{server.build.env.PORT14}}\",\r\n            \"port15\": \"{{server.build.env.PORT15}}\",\r\n            \"port16\": \"{{server.build.env.PORT16}}\",\r\n            \"port17\": \"{{server.build.env.PORT17}}\",\r\n            \"port18\": \"{{server.build.env.PORT18}}\",\r\n            \"port19\": \"{{server.build.env.PORT19}}\",\r\n            \"port20\": \"{{server.build.env.PORT20}}\",\r\n            \"hostname\": \"{{server.build.env.VPS_HOSTNAME}}\",\r\n            \"timezone\": \"{{server.build.env.TIMEZONE}}\",\r\n            \"distro\": \"{{server.build.env.VPS_DISTRO}}\",\r\n            \"release\": \"{{server.build.env.VPS_RELEASE}}\"\r\n        }\r\n    }\r\n}",
        "startup": "{\r\n    \"done\": \"CPanel VPS Runtime\"\r\n}",
        "logs": "{}",
        "stop": "exit"
    },
    "scripts": {
        "installation": {
            "script": "#!/bin/bash\r\ncd /mnt/server/\r\necho \"Preparing CPanel VPS proot runtime...\"\r\n",
            "container": "ghcr.io/mihai209/cpanel-vps:rootfs",
            "entrypoint": "bash"
        }
    },
    "variables": [
        {
            "name": "Quick OS Preset",
            "description": "Fast preset selector for the rootfs image. This auto-fills VPS_DISTRO and VPS_RELEASE in the startup page.",
            "env_variable": "VPS_PRESET",
            "default_value": "ubuntu|24.04",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|string|max:32",
            "field_type": "select",
            "options": [
                {
                    "label": "Ubuntu 24.04",
                    "value": "ubuntu|24.04"
                },
                {
                    "label": "Debian 12",
                    "value": "debian|12"
                }
            ]
        },
        {
            "name": "VPS Distro",
            "description": "Allowed values: ubuntu or debian.",
            "env_variable": "VPS_DISTRO",
            "default_value": "ubuntu",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|string|max:16",
            "field_type": "text"
        },
        {
            "name": "VPS Release",
            "description": "Example: 24.04 for Ubuntu or 12 for Debian.",
            "env_variable": "VPS_RELEASE",
            "default_value": "24.04",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|string|max:16",
            "field_type": "text"
        },
        {
            "name": "VPS Hostname",
            "description": "Prompt/display hostname inside the VPS shell.",
            "env_variable": "VPS_HOSTNAME",
            "default_value": "my-vps",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|string|max:32",
            "field_type": "text"
        },
        {
            "name": "Timezone",
            "description": "Display timezone value stored in the VPS config.",
            "env_variable": "TIMEZONE",
            "default_value": "UTC",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|string|max:64",
            "field_type": "text"
        },
        {
            "name": "Rootfs Base URL",
            "description": "Base URL that serves your Debian/Ubuntu rootfs archives.",
            "env_variable": "ROOTFS_BASE_URL",
            "default_value": "https://github.com/mihai209/cpanel-vps-rootfs/releases/download",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|string|max:191",
            "field_type": "text"
        },
