<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= (settings.brandName || 'CPanel' ).toUpperCase() %> - Connector(s) Health
    </title>
    <%- include('../partials/favicon') %>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
            rel="stylesheet">
        <link rel="stylesheet" href="/css/style.css">
        <style>
            .connect-info-page {
                padding-bottom: 2rem;
            }

            .min-w-0 {
                min-width: 0;
            }

            .connect-info-intro {
                background: linear-gradient(135deg, rgba(67, 97, 238, 0.14), rgba(16, 185, 129, 0.08));
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 1.25rem;
                padding: 1rem 1.1rem;
            }

            .node-card {
                background: var(--dashboard-card-bg, #16161d);
                border: 1px solid var(--glass-border, rgba(255, 255, 255, 0.08));
                backdrop-filter: blur(16px);
                border-radius: 1.25rem;
                transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
                position: relative;
                overflow: hidden;
                min-height: 100%;
                box-shadow: 0 18px 42px rgba(0, 0, 0, 0.22);
            }

            .node-card:hover {
                transform: translateY(-4px);
                border-color: rgba(96, 165, 250, 0.28);
                background: var(--dashboard-hover-bg, #1b1b24);
            }

            .node-card-body {
                display: flex;
                flex-direction: column;
                gap: 1rem;
                height: 100%;
            }

            .node-head {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                gap: 0.85rem;
            }

            .node-title-wrap {
                min-width: 0;
            }

            .node-title-wrap h5,
            .node-title-wrap .small {
                overflow-wrap: anywhere;
                word-break: break-word;
            }

            .node-status-badge {
                display: inline-flex;
                align-items: center;
                white-space: nowrap;
                padding: 0.35rem 0.85rem;
                border-radius: 999px;
                font-size: 0.7rem;
                font-weight: 700;
                letter-spacing: 0.05em;
                flex-shrink: 0;
            }

            .status-online {
                background: rgba(16, 185, 129, 0.1);
                color: #10b981;
                border: 1px solid rgba(16, 185, 129, 0.2);
            }

            .status-offline {
                background: rgba(239, 68, 68, 0.1);
                color: #ef4444;
                border: 1px solid rgba(239, 68, 68, 0.2);
            }

            .metric-progress {
                height: 8px;
                background: rgba(255, 255, 255, 0.05);
                border-radius: 999px;
                margin-top: 0.5rem;
                overflow: hidden;
            }

            .metric-label {
                font-size: 0.75rem;
                font-weight: 600;
                color: rgba(255, 255, 255, 0.45);
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }

            .metric-value {
                font-size: 0.95rem;
                font-weight: 700;
                color: #fff;
            }

            .node-icon-bg {
                width: 48px;
                height: 48px;
                border-radius: 1rem;
                background: rgba(99, 102, 241, 0.1);
                color: #6366f1;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.5rem;
                border: 1px solid rgba(99, 102, 241, 0.2);
                flex-shrink: 0;
            }

            .info-bits-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 0.65rem;
            }

            .info-bit {
                background: rgba(255, 255, 255, 0.03);
                border-radius: 0.85rem;
                padding: 0.8rem;
                border: 1px solid rgba(255, 255, 255, 0.05);
            }

            .diag-grid {
                display: grid;
                grid-template-columns: 1fr;
                gap: 0.65rem;
            }

            .diag-item {
                background: rgba(255, 255, 255, 0.03);
                border: 1px solid rgba(255, 255, 255, 0.05);
                border-radius: 0.9rem;
                padding: 0.8rem 0.9rem;
                min-width: 0;
            }

            .diag-top {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                gap: 0.75rem;
                margin-bottom: 0.3rem;
            }

            .diag-name {
                font-size: 0.78rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                color: rgba(255, 255, 255, 0.68);
                overflow-wrap: anywhere;
            }

            .diag-badge {
                border-radius: 999px;
                padding: 0.2rem 0.55rem;
                font-size: 0.68rem;
                font-weight: 700;
                letter-spacing: 0.04em;
                border: 1px solid transparent;
                white-space: nowrap;
                flex-shrink: 0;
            }

            .diag-badge-ok {
                color: #10b981;
                background: rgba(16, 185, 129, 0.12);
                border-color: rgba(16, 185, 129, 0.24);
            }

            .diag-badge-warn {
                color: #f59e0b;
                background: rgba(245, 158, 11, 0.12);
                border-color: rgba(245, 158, 11, 0.24);
            }

            .diag-badge-fail {
                color: #ef4444;
                background: rgba(239, 68, 68, 0.12);
                border-color: rgba(239, 68, 68, 0.24);
            }

            .diag-summary {
                font-size: 0.9rem;
                color: #fff;
                font-weight: 600;
                overflow-wrap: anywhere;
            }

            .diag-detail {
                margin-top: 0.2rem;
                color: rgba(255, 255, 255, 0.62);
                font-size: 0.8rem;
                line-height: 1.45;
                overflow-wrap: anywhere;
            }

            .diag-meta {
                margin-top: 0.35rem;
                color: rgba(255, 255, 255, 0.45);
                font-size: 0.74rem;
                line-height: 1.45;
                word-break: break-word;
                white-space: pre-wrap;
            }

            .triage-box {
                background: rgba(255, 255, 255, 0.04);
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 0.95rem;
                padding: 0.9rem 1rem;
            }

            .triage-box.is-ok {
                border-color: rgba(16, 185, 129, 0.25);
                background: rgba(16, 185, 129, 0.08);
            }

            .triage-box.is-warning {
                border-color: rgba(245, 158, 11, 0.25);
                background: rgba(245, 158, 11, 0.08);
            }

            .triage-box.is-critical {
                border-color: rgba(239, 68, 68, 0.25);
                background: rgba(239, 68, 68, 0.08);
            }

            .toolbar-chip {
                display: inline-flex;
                align-items: center;
                gap: 0.45rem;
                background: rgba(255, 255, 255, 0.04);
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 999px;
                padding: 0.45rem 0.8rem;
                color: rgba(255, 255, 255, 0.76);
                text-decoration: none;
            }

            .node-footer {
                margin-top: auto;
                padding-top: 0.9rem;
                border-top: 1px solid rgba(255, 255, 255, 0.08);
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                flex-wrap: wrap;
            }

            @media (min-width: 1400px) {
                .diag-grid {
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                }
            }

            @media (max-width: 767.98px) {
                .node-head {
                    flex-direction: column;
                    align-items: stretch;
                }

                .node-status-badge {
                    width: fit-content;
                }

                .info-bits-grid {
                    grid-template-columns: 1fr;
                }
            }
        </style>
    <link rel="stylesheet" href="/css/mobile-layout.css">
</head>

<body>
    <%- include ('../partials/error-modal') %>
        <div class="admin-wrapper">
            <%- include('../partials/admin-sidebar') %>

                <div class="admin-content">
                    <div class="admin-header">
                        <div>
                            <h4 class="mb-0 text-light fw-normal">Connector(s) Health</h4>
                            <small class="text-muted">Real-time infrastructure monitoring</small>
                        </div>
                        <div class="breadcrumb-admin">
                            <a href="/admin/overview">Admin</a> <span class="mx-2">&gt;</span> <span
                                class="text-light">Connector(s) Health</span>
                        </div>
                    </div>

                    <div class="container-fluid py-4 px-lg-4 connect-info-page">
                        <% if (success) { %>
                            <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i><%= success %></div>
                        <% } %>
                        <% if (error) { %>
                            <div class="alert alert-danger"><i class="bi bi-x-circle me-2"></i><%= error %></div>
                        <% } %>

                        <div class="connect-info-intro mb-4">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                                <div>
                                    <div class="text-light fw-semibold">Connector diagnostics overview</div>
                                    <div class="text-muted small">CPU, allocations, storage pressure, runtime checks, and connector heartbeat diagnostics in one place.</div>
                                </div>
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <form method="GET" action="/admin/connect-info" class="d-flex align-items-center gap-2">
                                        <select name="health" class="form-select form-select-sm bg-dark text-light border-secondary">
                                            <option value="all" <%= healthFilter === 'all' ? 'selected' : '' %>>All connectors</option>
                                            <option value="online" <%= healthFilter === 'online' ? 'selected' : '' %>>Online only</option>
                                            <option value="offline" <%= healthFilter === 'offline' ? 'selected' : '' %>>Offline only</option>
                                            <option value="issues" <%= healthFilter === 'issues' ? 'selected' : '' %>>Needs attention</option>
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-light">Filter</button>
                                    </form>
                                    <a href="/admin/connect-info?health=<%= encodeURIComponent(healthFilter || 'all') %>&export=json" class="toolbar-chip">
                                        <i class="bi bi-download"></i> Export JSON
                                    </a>
                                    <div class="text-muted small">
                                        Auto-refreshes every 30 seconds while the tab is visible.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row g-4">
                            <% if (connectorCards && connectorCards.length> 0) { %>
                                <% connectorCards.forEach(card=> { %>
                                    <% const conn = card.connector; const statusData=card.statusData; const isOnline=card.isOnline; const triage = card.triage || { severity: 'warning', title: 'No triage available', summary: 'No diagnostics summary generated.', nextAction: 'Wait for the next heartbeat.', failedChecks: [] }; const usage=statusData ? statusData.usage : null;
                                        const diagnostics=statusData && statusData.diagnostics && statusData.diagnostics.checks ? statusData.diagnostics.checks : {};
                                        const diagnosticEntries=Object.entries(diagnostics);
                                        const nodeUsage = card.nodeStats || nodeStats[conn.id] || {};
                                        const memAllocated = Number(nodeUsage.memoryAllocatedGb || 0);
                                        const diskAllocated = Number(nodeUsage.diskAllocatedGb || 0);
                                        const serverCount = Number(nodeUsage.servers || 0);
                                        const allocationCount = Number(nodeUsage.allocations || 0);
                                    %>
                                        <div class="col-xl-4 col-md-6">
                                            <div class="node-card p-4">
                                                <div class="node-card-body">
                                                <div class="node-head">
                                                    <div class="d-flex align-items-center gap-3 min-w-0">
                                                        <div class="node-icon-bg">
                                                            <i class="bi bi-cpu-fill"></i>
                                                        </div>
                                                        <div class="node-title-wrap">
                                                            <h5 class="mb-0 fw-bold text-light">
                                                                <%= conn.name %>
                                                            </h5>
                                                            <span class="text-muted small">
                                                                <%= conn.fqdn %>
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <span
                                                        class="node-status-badge <%= isOnline ? 'status-online' : 'status-offline' %>">
                                                        <i class="bi bi-circle-fill me-1 small"></i>
                                                        <%= isOnline ? 'ONLINE' : 'OFFLINE' %>
                                                    </span>
                                                </div>

                                                <!-- Hardware Metrics -->
                                                <div>
                                                    <div class="row g-3">
                                                        <!-- CPU -->
                                                        <div class="col-12">
                                                            <div class="d-flex justify-content-between mb-1">
                                                                <span class="metric-label">CPU Usage</span>
                                                                <span class="metric-value">
                                                                    <%= (usage && usage.cpu) ? usage.cpu.toFixed(1) : 0
                                                                        %>%
                                                                </span>
                                                            </div>
                                                            <div class="metric-progress progress">
                                                                <div class="progress-bar bg-info"
                                                                    style="width: <%= (usage && usage.cpu) ? usage.cpu : 0 %>%">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <!-- RAM -->
                                                        <div class="col-12">
                                                            <div class="d-flex justify-content-between mb-1">
                                                                <span class="metric-label">RAM Allocated</span>
                                                                <span class="metric-value">
                                                                    <%= memAllocated.toFixed(1) %> / <%= Number(conn.totalMemory || 0).toFixed(1) %> GB
                                                                </span>
                                                            </div>
                                                            <div class="metric-progress progress">
                                                                <% const memUsed=memAllocated; const
                                                                    memTotal=Number(conn.totalMemory || 0); const
                                                                    ramPct=memTotal> 0 ? (memUsed / memTotal * 100) : 0;
                                                                    %>
                                                                    <div class="progress-bar bg-primary"
                                                                        style="width: <%= Math.min(ramPct, 100) %>%">
                                                                    </div>
                                                            </div>
                                                        </div>
                                                        <!-- Disk -->
                                                        <div class="col-12">
                                                            <div class="d-flex justify-content-between mb-1">
                                                                <span class="metric-label">Disk Allocated</span>
                                                                <span class="metric-value">
                                                                    <%= diskAllocated.toFixed(1) %> / <%= Number(conn.totalDisk || 0).toFixed(1) %> GB
                                                                </span>
                                                            </div>
                                                            <div class="metric-progress progress">
                                                                <% const diskUsed=diskAllocated; const
                                                                    diskTotal=Number(conn.totalDisk || 0); const
                                                                    diskPct=diskTotal> 0 ? (diskUsed / diskTotal * 100)
                                                                    : 0; %>
                                                                    <div class="progress-bar bg-warning"
                                                                        style="width: <%= Math.min(diskPct, 100) %>%">
                                                                    </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Secondary Info -->
                                                <div class="info-bits-grid">
                                                    <div>
                                                        <div class="info-bit text-center">
                                                            <span class="d-block metric-label">Servers</span>
                                                            <span class="metric-value fs-5">
                                                                <%= serverCount %>
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <div>
                                                        <div class="info-bit text-center">
                                                            <span class="d-block metric-label">Allocations</span>
                                                            <span class="metric-value fs-5">
                                                                <%= allocationCount %>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div>
                                                    <div class="triage-box is-<%= triage.severity === 'critical' ? 'critical' : (triage.severity === 'ok' ? 'ok' : 'warning') %> mb-3">
                                                        <div class="d-flex justify-content-between align-items-start gap-3">
                                                            <div>
                                                                <div class="metric-label mb-1">Issue triage</div>
                                                                <div class="text-light fw-semibold"><%= triage.title %></div>
                                                                <div class="diag-detail mt-1"><%= triage.summary %></div>
                                                                <div class="diag-meta mt-2"><%= triage.nextAction %></div>
                                                            </div>
                                                            <% if (Array.isArray(triage.failedChecks) && triage.failedChecks.length > 0) { %>
                                                                <span class="diag-badge diag-badge-<%= triage.severity === 'critical' ? 'fail' : 'warn' %>"><%= triage.failedChecks.length %> issue(s)</span>
                                                            <% } %>
                                                        </div>
                                                    </div>
                                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                                        <span class="metric-label">Connector Diagnostics</span>
                                                        <% if (statusData && statusData.diagnostics && statusData.diagnostics.generatedAt) { %>
                                                            <span class="small text-muted">
                                                                Updated <%= new Date(statusData.diagnostics.generatedAt).toLocaleTimeString() %>
                                                            </span>
                                                        <% } %>
                                                    </div>
                                                    <% if (diagnosticEntries.length > 0) { %>
                                                        <div class="diag-grid">
                                                            <% diagnosticEntries.forEach(([diagKey, diag]) => { %>
                                                                <% const diagStatus = String((diag && diag.status) || 'warn').toLowerCase(); %>
                                                                <% const diagLabel = diagKey.replace(/_/g, ' '); %>
                                                                <div class="diag-item">
                                                                    <div class="diag-top">
                                                                        <span class="diag-name"><%= diagLabel %></span>
                                                                        <span class="diag-badge diag-badge-<%= ['ok', 'warn', 'fail'].includes(diagStatus) ? diagStatus : 'warn' %>">
                                                                            <%= diagStatus.toUpperCase() %>
                                                                        </span>
                                                                    </div>
                                                                    <div class="diag-summary"><%= (diag && diag.summary) || 'No summary' %></div>
                                                                    <% if (diag && diag.detail) { %>
                                                                        <div class="diag-detail"><%= diag.detail %></div>
                                                                    <% } %>
                                                                    <% if (diag && diag.metadata) { %>
                                                                        <div class="diag-meta"><%= JSON.stringify(diag.metadata) %></div>
                                                                    <% } %>
                                                                </div>
                                                            <% }) %>
                                                        </div>
                                                    <% } else { %>
                                                        <div class="info-bit">
                                                            <span class="text-muted small">No diagnostics received yet. Wait for the next connector heartbeat.</span>
                                                        </div>
                                                    <% } %>
                                                </div>

                                                <div class="node-footer">
                                                    <div class="small">
                                                        <span class="text-muted">Last Seen:</span>
                                                        <span class="text-light opacity-75">
                                                            <%= statusData ? new
                                                                Date(statusData.lastSeen).toLocaleTimeString() : 'Never'
                                                                %>
                                                        </span>
                                                    </div>
                                                    <div class="d-flex flex-wrap gap-2">
                                                        <form method="POST" action="/admin/connectors/<%= conn.id %>/run-diagnostics" class="d-inline">
                                                            <input type="hidden" name="redirect" value="/admin/connect-info?health=<%= encodeURIComponent(healthFilter || 'all') %>">
                                                            <button type="submit" class="btn btn-sm btn-outline-light rounded-pill px-3" <%= card.canRunDiagnostics ? '' : 'disabled' %>>
                                                                <i class="bi bi-arrow-repeat me-1"></i> Run Diagnostics Now
                                                            </button>
                                                        </form>
                                                        <a href="/admin/connectors/<%= conn.id %>/manage"
                                                            class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                            <i class="bi bi-gear-fill me-1"></i> Configure
                                                        </a>
                                                    </div>
                                                </div>
                                                </div>
                                            </div>
                                        </div>
                                        <% }); %>
                                            <% } else { %>
                                                <div class="col-12 text-center py-5">
                                                    <img src="/assets/rocky.png" alt="Rocky"
                                                        style="width: 200px; opacity: 0.3;" class="mb-4">
                                                    <h5 class="text-muted italic">No connectors detected in the network.
                                                    </h5>
                                                </div>
                                                <% } %>
                        </div>
                    </div>

                    <%- include('../partials/footer') %>
                </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" data-turbo-eval="false"></script>
        <script>
            // Auto-refresh logic can be added here if needed for peak real-time feels
            setTimeout(() => {
                if (!document.hidden) location.reload();
            }, 30000);
        </script>
</body>

</html>
