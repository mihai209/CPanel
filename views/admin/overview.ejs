<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= (settings.brandName || 'CPanel').toUpperCase() %><%= locals.title ? ' - ' + title.toUpperCase() : '' %> - Overview</title>
    <%- include('../partials/favicon') %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <%
        const safeStats = stats || { users: 0, servers: 0, locations: 0, databases: 0, nodes: 0 };
        const totalInventory = Math.max(1, Number(safeStats.servers || 0) + Number(safeStats.users || 0) + Number(safeStats.databases || 0) + Number(safeStats.locations || 0));
        const serverShare = Math.max(8, Math.min(88, Math.round((Number(safeStats.servers || 0) / totalInventory) * 100) || 24));
        const userShare = Math.max(8, Math.min(88, Math.round((Number(safeStats.users || 0) / totalInventory) * 100) || 32));
        const dataShare = Math.max(8, Math.min(88, Math.round((Number(safeStats.databases || 0) / totalInventory) * 100) || 18));
        const locationShare = Math.max(8, Math.min(88, Math.round((Number(safeStats.locations || 0) / totalInventory) * 100) || 12));
        const redisReady = Boolean(redisInfo && redisInfo.enabled && redisInfo.ready);
        const redisEnabled = Boolean(redisInfo && redisInfo.enabled);
        const versionTone = String(versionStatus && versionStatus.type || 'info');
        const versionIcon = versionTone === 'success' ? 'bi-check-circle-fill' : (versionTone === 'warning' ? 'bi-arrow-repeat' : 'bi-exclamation-octagon-fill');
        const healthScore = Math.max(34, Math.min(96,
            40
            + (redisReady ? 18 : (redisEnabled ? 10 : 0))
            + (Number(safeStats.locations || 0) > 0 ? 10 : 0)
            + (Number(safeStats.servers || 0) > 0 ? 14 : 0)
            + (Number(safeStats.users || 0) > 0 ? 8 : 0)
            + (versionTone === 'success' ? 8 : (versionTone === 'warning' ? 2 : -8))
        ));
        const bars = [
            { label: 'Server Fleet', value: Number(safeStats.servers || 0), tone: 'blue' },
            { label: 'Users', value: Number(safeStats.users || 0), tone: 'amber' },
            { label: 'Databases', value: Number(safeStats.databases || 0), tone: 'teal' },
            { label: 'Locations', value: Number(safeStats.locations || 0), tone: 'violet' },
            { label: 'Nodes', value: Number(safeStats.nodes || 0), tone: 'slate' }
        ];
        const maxBar = Math.max(1, ...bars.map((entry) => Number(entry.value || 0)));
        const activityFeed = [
            {
                icon: 'bi-hdd-stack',
                title: `${safeStats.servers || 0} active server records`,
                text: 'Provisioning, power actions, and runtime changes are managed from one surface.'
            },
            {
                icon: 'bi-people',
                title: `${safeStats.users || 0} panel users`,
                text: 'Subusers, ownership, and access flow are visible without leaving admin mode.'
            },
            {
                icon: 'bi-database',
                title: `${safeStats.databases || 0} databases tracked`,
                text: 'Persistent data inventory stays visible next to compute and connector posture.'
            }
        ];
    %>
    <style>
        :root {
            --surface-0: #09111f;
            --surface-1: #101a2f;
            --surface-2: #16233d;
            --surface-3: #1b2c4b;
            --line: rgba(255, 255, 255, 0.08);
            --line-strong: rgba(116, 155, 255, 0.28);
            --text-main: #f5f7ff;
            --text-dim: #96a6c8;
            --blue: #4f7cff;
            --blue-soft: rgba(79, 124, 255, 0.18);
            --amber: #ffbf4d;
            --amber-soft: rgba(255, 191, 77, 0.16);
            --teal: #39d4c3;
            --teal-soft: rgba(57, 212, 195, 0.16);
            --violet: #9080ff;
            --violet-soft: rgba(144, 128, 255, 0.16);
            --slate: #8ea5cf;
            --danger: #ff7272;
            --success: #35d38a;
            --shell-radius: 34px;
            --card-radius: 26px;
            --card-shadow: 0 20px 60px rgba(0, 0, 0, 0.28);
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            min-height: 100%;
            height: 100%;
        }

        body {
            margin: 0;
            color: var(--text-main);
            font-family: 'Manrope', system-ui, sans-serif;
            background:
                radial-gradient(circle at 15% 12%, rgba(106, 142, 255, 0.42), transparent 24%),
                radial-gradient(circle at 82% 10%, rgba(67, 206, 255, 0.14), transparent 18%),
                linear-gradient(180deg, #4a79ff 0%, #3564e5 17%, #101a2f 52%, #09111f 100%);
            overflow: hidden;
        }

        .admin-app-shell {
            min-height: 100vh;
            height: 100vh;
            display: flex;
        }

        .admin-view {
            flex: 1;
            min-width: 0;
            height: 100vh;
            padding: 20px 22px 18px;
            overflow: hidden;
        }

        .overview-shell {
            max-width: 1480px;
            margin: 0 auto;
            height: calc(100vh - 38px);
            display: flex;
            flex-direction: column;
            background: rgba(8, 13, 24, 0.72);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: var(--shell-radius);
            box-shadow: var(--card-shadow);
            backdrop-filter: blur(18px);
            overflow: hidden;
        }

        .overview-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 1rem 1.25rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            background: linear-gradient(180deg, rgba(255,255,255,0.035), rgba(255,255,255,0.01));
        }

        .overview-title h1 {
            margin: 0;
            font-family: 'Space Grotesk', system-ui, sans-serif;
            font-size: clamp(1.9rem, 3vw, 2.6rem);
            line-height: 1;
            letter-spacing: -0.05em;
            font-weight: 700;
        }

        .overview-title p {
            margin: 0.45rem 0 0;
            color: var(--text-dim);
            font-size: 0.96rem;
        }

        .toolbar-cluster {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        .toolbar-btn,
        .toolbar-chip {
            min-height: 44px;
            border-radius: 16px;
            border: 1px solid rgba(255,255,255,0.08);
            background: rgba(255,255,255,0.035);
            color: var(--text-main);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            padding: 0 1rem;
            gap: 0.6rem;
            font-weight: 700;
        }

        .toolbar-btn.icon-only {
            width: 44px;
            padding: 0;
            font-size: 1rem;
        }

        .toolbar-chip img {
            width: 32px;
            height: 32px;
            object-fit: cover;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.08);
        }

        .overview-body {
            flex: 1;
            min-height: 0;
            padding: 1rem 1.1rem 0.85rem;
            overflow: hidden;
        }

        .overview-grid {
            display: grid;
            grid-template-columns: minmax(0, 2.15fr) minmax(330px, 0.95fr);
            gap: 1rem;
            align-items: stretch;
            height: 100%;
        }

        .main-lane,
        .side-lane {
            display: grid;
            gap: 1rem;
            min-height: 0;
        }

        .panel-card {
            position: relative;
            overflow: hidden;
            background: linear-gradient(180deg, rgba(255,255,255,0.035), rgba(255,255,255,0.014));
            border: 1px solid var(--line);
            border-radius: var(--card-radius);
            padding: 1rem;
        }

        .panel-card::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(140deg, rgba(255,255,255,0.04), transparent 38%);
            pointer-events: none;
        }

        .hero-card {
            display: grid;
            grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.92fr);
            gap: 1rem;
            padding: 1.1rem;
            background:
                radial-gradient(circle at top left, rgba(79, 124, 255, 0.24), transparent 33%),
                linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.015));
        }

        .hero-tag {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 0.4rem 0.75rem;
            border-radius: 999px;
            border: 1px solid rgba(255,255,255,0.08);
            background: rgba(255,255,255,0.04);
            color: #c9d7ff;
            font-size: 0.78rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .hero-copy h2 {
            margin: 0.7rem 0 0;
            font-family: 'Space Grotesk', system-ui, sans-serif;
            font-size: clamp(1.55rem, 2.5vw, 2.15rem);
            line-height: 1;
            letter-spacing: -0.06em;
            font-weight: 700;
        }

        .hero-copy p {
            margin: 0.7rem 0 0;
            max-width: 60ch;
            color: var(--text-dim);
            font-size: 0.9rem;
            line-height: 1.55;
        }

        .hero-actions {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
            margin-top: 0.9rem;
        }

        .hero-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            min-height: 42px;
            padding: 0 0.85rem;
            border-radius: 15px;
            border: 1px solid rgba(255,255,255,0.08);
            color: var(--text-main);
            text-decoration: none;
            font-weight: 800;
            background: rgba(255,255,255,0.04);
        }

        .hero-btn.primary {
            background: linear-gradient(135deg, rgba(79,124,255,0.92), rgba(110,144,255,0.9));
            border-color: rgba(128, 160, 255, 0.4);
            box-shadow: 0 14px 28px rgba(54, 96, 212, 0.28);
        }

        .hero-side {
            display: grid;
            gap: 1rem;
            align-content: space-between;
        }

        .rocky-portrait {
            min-height: 160px;
            border-radius: 24px;
            border: 1px solid rgba(255,255,255,0.07);
            background:
                radial-gradient(circle at 28% 25%, rgba(255,255,255,0.18), transparent 22%),
                linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.015));
            display: grid;
            place-items: center;
            overflow: hidden;
        }

        .rocky-portrait img {
            width: min(100%, 180px);
            object-fit: contain;
            filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.32));
        }

        .status-strip {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.85rem;
        }

        .status-pill {
            display: grid;
            gap: 0.25rem;
            padding: 0.75rem 0.85rem;
            border-radius: 18px;
            border: 1px solid rgba(255,255,255,0.07);
            background: rgba(255,255,255,0.03);
        }

        .status-pill small {
            color: var(--text-dim);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            font-size: 0.68rem;
            font-weight: 800;
        }

        .status-pill strong {
            font-size: 1rem;
            font-weight: 800;
        }

        .metric-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 0.8rem;
        }

        .metric-card {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 0.8rem;
            align-items: center;
            min-height: 124px;
        }

        .eyebrow {
            color: rgba(255,255,255,0.58);
            text-transform: uppercase;
            letter-spacing: 0.12em;
            font-size: 0.68rem;
            font-weight: 800;
        }

        .metric-icon {
            width: 38px;
            height: 38px;
            border-radius: 15px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            margin-bottom: 0.55rem;
            border: 1px solid rgba(255,255,255,0.08);
            background: rgba(255,255,255,0.05);
        }

        .metric-value {
            margin-top: 0.35rem;
            font-family: 'Space Grotesk', system-ui, sans-serif;
            font-size: clamp(1.5rem, 2vw, 2rem);
            line-height: 1;
            letter-spacing: -0.05em;
            font-weight: 700;
        }

        .metric-note {
            margin-top: 0.35rem;
            color: var(--text-dim);
            font-size: 0.83rem;
        }

        .ring {
            --size: 72px;
            --value: 50;
            --fill: var(--blue);
            width: var(--size);
            height: var(--size);
            border-radius: 50%;
            display: grid;
            place-items: center;
            position: relative;
            background: conic-gradient(var(--fill) calc(var(--value) * 1%), rgba(255,255,255,0.06) 0);
        }

        .ring::before {
            content: '';
            width: calc(var(--size) - 18px);
            height: calc(var(--size) - 18px);
            border-radius: 50%;
            background: #111b30;
            border: 1px solid rgba(255,255,255,0.05);
        }

        .ring span {
            position: absolute;
            font-size: 0.82rem;
            font-weight: 800;
            color: var(--text-main);
        }

        .section-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 0.75rem;
        }

        .section-head h3 {
            margin: 0;
            font-size: 1.08rem;
            font-weight: 800;
        }

        .section-head p,
        .section-kicker {
            margin: 0.25rem 0 0;
            color: var(--text-dim);
            font-size: 0.84rem;
        }

        .health-badge {
            min-height: 38px;
            padding: 0 0.8rem;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
            border: 1px solid rgba(255,255,255,0.08);
            background: rgba(255,255,255,0.035);
            font-weight: 800;
            white-space: nowrap;
        }

        .pulse-chart {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 0.7rem;
            align-items: end;
            min-height: 220px;
            padding-top: 0.35rem;
        }

        .chart-col {
            display: grid;
            gap: 0.7rem;
            justify-items: center;
        }

        .chart-stack {
            width: min(74px, 100%);
            min-height: 150px;
            display: flex;
            align-items: end;
            justify-content: center;
            padding: 0.6rem 0;
            border-radius: 22px;
            background:
                repeating-linear-gradient(
                    to top,
                    rgba(255,255,255,0.04) 0,
                    rgba(255,255,255,0.04) 1px,
                    transparent 1px,
                    transparent 34px
                );
        }

        .chart-bar {
            width: 18px;
            border-radius: 999px;
            min-height: 18px;
            box-shadow: 0 10px 24px rgba(0,0,0,0.22);
        }

        .chart-bar.blue { background: linear-gradient(180deg, #6a94ff, #4676ff); }
        .chart-bar.amber { background: linear-gradient(180deg, #ffd16b, #ffb53a); }
        .chart-bar.teal { background: linear-gradient(180deg, #5ce4d8, #2bc9b7); }
        .chart-bar.violet { background: linear-gradient(180deg, #b39cff, #8771ff); }
        .chart-bar.slate { background: linear-gradient(180deg, #c2d2f5, #8fa7d5); }

        .chart-label {
            text-align: center;
            font-size: 0.86rem;
            color: var(--text-dim);
        }

        .chart-value {
            font-size: 1rem;
            font-weight: 800;
        }

        .inventory-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 0.7rem;
        }

        .inventory-card {
            padding: 0.8rem;
            border-radius: 18px;
            border: 1px solid rgba(255,255,255,0.07);
            background: rgba(255,255,255,0.03);
            display: grid;
            gap: 0.5rem;
        }

        .inventory-card strong {
            font-size: 0.96rem;
            font-weight: 800;
        }

        .inventory-bar {
            width: 100%;
            height: 9px;
            overflow: hidden;
            border-radius: 999px;
            background: rgba(255,255,255,0.06);
        }

        .inventory-bar > span {
            display: block;
            height: 100%;
            border-radius: inherit;
        }

        .inventory-card.blue .inventory-bar > span { background: linear-gradient(90deg, #4676ff, #6a94ff); }
        .inventory-card.amber .inventory-bar > span { background: linear-gradient(90deg, #ffb53a, #ffd16b); }
        .inventory-card.teal .inventory-bar > span { background: linear-gradient(90deg, #2bc9b7, #5ce4d8); }
        .inventory-card.violet .inventory-bar > span { background: linear-gradient(90deg, #8771ff, #b39cff); }

        .flash-list {
            display: grid;
            gap: 0.65rem;
        }

        .flash-note {
            display: flex;
            align-items: flex-start;
            gap: 0.75rem;
            padding: 0.85rem 0.95rem;
            border-radius: 18px;
            border: 1px solid rgba(255,255,255,0.07);
            background: rgba(255,255,255,0.03);
        }

        .flash-note i {
            font-size: 1.05rem;
            margin-top: 0.1rem;
        }

        .flash-note strong {
            display: block;
            font-size: 0.95rem;
            font-weight: 800;
        }

        .flash-note span {
            display: block;
            margin-top: 0.25rem;
            color: var(--text-dim);
            font-size: 0.82rem;
            line-height: 1.45;
        }

        .flash-note.success { border-color: rgba(53,211,138,0.28); background: rgba(53,211,138,0.08); }
        .flash-note.error { border-color: rgba(255,114,114,0.28); background: rgba(255,114,114,0.08); }
        .flash-note.warning { border-color: rgba(255,191,77,0.28); background: rgba(255,191,77,0.08); }
        .flash-note.info { border-color: rgba(79,124,255,0.28); background: rgba(79,124,255,0.08); }

        .health-dial-card {
            display: grid;
            gap: 0.8rem;
        }

        .dial-wrap {
            display: grid;
            place-items: center;
            padding: 0.1rem 0 0;
        }

        .dial {
            --dial-value: 70;
            width: 180px;
            aspect-ratio: 1 / 0.64;
            position: relative;
            overflow: hidden;
        }

        .dial::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 220px 220px 0 0;
            background: conic-gradient(from 180deg, rgba(255,191,77,0.95) 0deg 62deg, rgba(79,124,255,0.95) 62deg 180deg, rgba(255,255,255,0.07) 180deg 360deg);
            mask: radial-gradient(circle at 50% 100%, transparent 0 47%, #000 48% 100%);
            -webkit-mask: radial-gradient(circle at 50% 100%, transparent 0 47%, #000 48% 100%);
        }

        .dial-center {
            position: absolute;
            inset: auto 0 0;
            text-align: center;
            padding-bottom: 0.3rem;
        }

        .dial-center strong {
            display: block;
            font-family: 'Space Grotesk', system-ui, sans-serif;
            font-size: 1.6rem;
            line-height: 1;
        }

        .dial-center span {
            display: block;
            margin-top: 0.25rem;
            color: var(--text-dim);
            font-size: 0.88rem;
        }

        .mini-list {
            display: grid;
            gap: 0.65rem;
        }

        .mini-row {
            display: grid;
            grid-template-columns: auto 1fr;
            gap: 0.85rem;
            align-items: start;
            padding: 0.8rem;
            border-radius: 18px;
            border: 1px solid rgba(255,255,255,0.07);
            background: rgba(255,255,255,0.03);
        }

        .mini-icon {
            width: 38px;
            height: 38px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.06);
            color: var(--text-main);
            font-size: 1rem;
        }

        .mini-row strong {
            display: block;
            font-size: 0.95rem;
            font-weight: 800;
        }

        .mini-row span {
            display: block;
            margin-top: 0.2rem;
            color: var(--text-dim);
            font-size: 0.82rem;
            line-height: 1.45;
        }

        .actions-card {
            display: grid;
            gap: 0.65rem;
        }

        .action-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            text-decoration: none;
            color: var(--text-main);
            padding: 0.85rem 0.95rem;
            border-radius: 18px;
            border: 1px solid rgba(255,255,255,0.07);
            background: rgba(255,255,255,0.03);
        }

        .action-copy strong {
            display: block;
            font-size: 0.95rem;
            font-weight: 800;
        }

        .action-copy span {
            display: block;
            margin-top: 0.2rem;
            color: var(--text-dim);
            font-size: 0.82rem;
        }

        .action-arrow {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(255,255,255,0.08);
            background: rgba(255,255,255,0.04);
        }

        .redis-callout {
            padding: 0.85rem 0.95rem;
            border-radius: 18px;
            border: 1px dashed rgba(255, 191, 77, 0.28);
            background: rgba(255, 191, 77, 0.08);
        }

        .redis-callout strong {
            display: block;
            font-size: 0.95rem;
            font-weight: 800;
        }

        .redis-callout span {
            display: block;
            margin-top: 0.25rem;
            color: #f5d28b;
            font-size: 0.82rem;
            line-height: 1.45;
        }

        .footer-wrap {
            margin-top: auto;
            padding: 0 1.1rem 0.9rem;
            flex-shrink: 0;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            background: linear-gradient(180deg, rgba(255,255,255,0.015), rgba(255,255,255,0.005));
        }

        @media (max-width: 1320px) {
            body {
                overflow: auto;
            }

            .admin-app-shell,
            .admin-view {
                height: auto;
            }

            .overview-grid {
                grid-template-columns: 1fr;
                height: auto;
            }

            .hero-card {
                grid-template-columns: 1fr;
            }

            .overview-shell {
                height: auto;
            }

            .overview-body {
                overflow: visible;
            }
        }

        @media (max-width: 1080px) {
            .metric-grid,
            .inventory-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @media (max-width: 760px) {
            .admin-view {
                padding: 18px 14px 18px;
            }

            .overview-topbar,
            .overview-body,
            .footer-wrap {
                padding-left: 1rem;
                padding-right: 1rem;
            }

            .overview-topbar {
                flex-direction: column;
                align-items: stretch;
            }

            .toolbar-cluster {
                justify-content: flex-start;
            }

            .metric-grid,
            .inventory-grid,
            .status-strip,
            .pulse-chart {
                grid-template-columns: 1fr;
            }

            .pulse-chart {
                min-height: auto;
            }

            .chart-stack {
                min-height: 120px;
                width: 100%;
            }

            .chart-bar {
                width: 42px;
            }
        }
    </style>
</head>
<body>
    <div class="admin-app-shell">
        <%- include('../partials/admin-sidebar') %>
        <div class="admin-view">
            <div class="overview-shell">
                <header class="overview-topbar">
                    <div class="overview-title">
                        <h1>Operations Overview</h1>
                        <p>One surface for platform health, inventory posture, and connector-side decisions.</p>
                    </div>
                    <div class="toolbar-cluster">
                        <a href="/admin/incidents" class="toolbar-btn icon-only" title="Incident Center">
                            <i class="bi bi-bell"></i>
                        </a>
                        <a href="/admin/service-health-checks" class="toolbar-btn icon-only" title="Health Checks">
                            <i class="bi bi-heart-pulse"></i>
                        </a>
                        <a href="/admin/sentry-seeker" class="toolbar-btn icon-only" title="Sentry Seeker">
                            <i class="bi bi-shield-lock"></i>
                        </a>
                        <div class="toolbar-chip">
                            <img src="<%= user.avatarUrl || `https://www.gravatar.com/avatar/${user.gravatarHash}?d=retro` %>" alt="Avatar">
                            <span>@<%= user.username %></span>
                        </div>
                    </div>
                </header>

                <div class="overview-body">
                    <div class="overview-grid">
                        <section class="main-lane">
                            <div class="panel-card hero-card">
                                <div class="hero-copy">
                                    <span class="hero-tag"><i class="bi bi-command"></i> Admin Surface</span>
                                    <h2>Run the panel like an ops deck, not a settings dump.</h2>
                                    <p>
                                        This view condenses runtime inventory, version posture, Redis state, and high-level platform movement into a single board. It is meant for fast scanning first, deeper admin work second.
                                    </p>
                                    <div class="hero-actions">
                                        <a href="/admin/connectors" class="hero-btn primary">
                                            <i class="bi bi-diagram-3"></i>
                                            Manage Connectors
                                        </a>
                                        <a href="/admin/servers" class="hero-btn">
                                            <i class="bi bi-hdd-stack"></i>
                                            Open Servers
                                        </a>
                                        <a href="/admin/users" class="hero-btn">
                                            <i class="bi bi-people"></i>
                                            Review Users
                                        </a>
                                    </div>
                                </div>
                                <div class="hero-side">
                                    <div class="rocky-portrait">
                                        <img src="/assets/welcoming-rocky.png" alt="Rocky assistant mascot">
                                    </div>
                                    <div class="status-strip">
                                        <div class="status-pill">
                                            <small>Version</small>
                                            <strong><%= versionTone === 'success' ? 'Current build looks aligned' : (versionTone === 'warning' ? 'Update available' : 'Remote check failed') %></strong>
                                        </div>
                                        <div class="status-pill">
                                            <small>Cache</small>
                                            <strong><%= redisReady ? 'Redis ready' : (redisEnabled ? 'Redis configured, not ready' : 'Redis not configured') %></strong>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="metric-grid">
                                <article class="panel-card metric-card">
                                    <div>
                                        <div class="metric-icon" style="color: var(--blue);"><i class="bi bi-hdd-stack"></i></div>
                                        <div class="eyebrow">Server Fleet</div>
                                        <div class="metric-value"><%= safeStats.servers %></div>
                                        <div class="metric-note">Provisioned game and service containers tracked from admin.</div>
                                    </div>
                                    <div class="ring" style="--value:<%= serverShare %>; --fill: var(--blue);"><span><%= serverShare %>%</span></div>
                                </article>
                                <article class="panel-card metric-card">
                                    <div>
                                        <div class="metric-icon" style="color: var(--amber);"><i class="bi bi-people"></i></div>
                                        <div class="eyebrow">Accounts</div>
                                        <div class="metric-value"><%= safeStats.users %></div>
                                        <div class="metric-note">Owners, admins, and subuser relationships under one identity layer.</div>
                                    </div>
                                    <div class="ring" style="--value:<%= userShare %>; --fill: var(--amber);"><span><%= userShare %>%</span></div>
                                </article>
                                <article class="panel-card metric-card">
                                    <div>
                                        <div class="metric-icon" style="color: var(--teal);"><i class="bi bi-database"></i></div>
                                        <div class="eyebrow">Data Services</div>
                                        <div class="metric-value"><%= safeStats.databases %></div>
                                        <div class="metric-note">Persistent stores available across server inventory and admin tools.</div>
                                    </div>
                                    <div class="ring" style="--value:<%= dataShare %>; --fill: var(--teal);"><span><%= dataShare %>%</span></div>
                                </article>
                                <article class="panel-card metric-card">
                                    <div>
                                        <div class="metric-icon" style="color: var(--violet);"><i class="bi bi-geo-alt"></i></div>
                                        <div class="eyebrow">Locations</div>
                                        <div class="metric-value"><%= safeStats.locations %></div>
                                        <div class="metric-note">Allocation groups and connector geography available to schedule against.</div>
                                    </div>
                                    <div class="ring" style="--value:<%= locationShare %>; --fill: var(--violet);"><span><%= locationShare %>%</span></div>
                                </article>
                            </div>

                            <section class="panel-card">
                                <div class="section-head">
                                    <div>
                                        <h3>Platform Motion</h3>
                                        <p>Relative board built from your current inventory. It is intentionally operational, not a fake accounting chart.</p>
                                    </div>
                                    <div class="health-badge">
                                        <i class="bi bi-activity"></i>
                                        Health Score <%= healthScore %>%
                                    </div>
                                </div>
                                <div class="pulse-chart">
                                    <% bars.forEach((entry) => { %>
                                        <div class="chart-col">
                                            <div class="chart-stack">
                                                <div class="chart-bar <%= entry.tone %>" style="height: <%= Math.max(18, Math.round((entry.value / maxBar) * 200) || 18) %>px;"></div>
                                            </div>
                                            <div class="chart-value"><%= entry.value %></div>
                                            <div class="chart-label"><%= entry.label %></div>
                                        </div>
                                    <% }) %>
                                </div>
                            </section>

                            <section class="panel-card">
                                <div class="section-head">
                                    <div>
                                        <h3>Inventory Mix</h3>
                                        <p>How the current control surface is distributed across the main operational buckets.</p>
                                    </div>
                                </div>
                                <div class="inventory-grid">
                                    <div class="inventory-card blue">
                                        <div class="eyebrow">Servers</div>
                                        <strong><%= serverShare %>% of visible inventory</strong>
                                        <div class="inventory-bar"><span style="width:<%= serverShare %>%"></span></div>
                                    </div>
                                    <div class="inventory-card amber">
                                        <div class="eyebrow">Users</div>
                                        <strong><%= userShare %>% of visible inventory</strong>
                                        <div class="inventory-bar"><span style="width:<%= userShare %>%"></span></div>
                                    </div>
                                    <div class="inventory-card teal">
                                        <div class="eyebrow">Databases</div>
                                        <strong><%= dataShare %>% of visible inventory</strong>
                                        <div class="inventory-bar"><span style="width:<%= dataShare %>%"></span></div>
                                    </div>
                                    <div class="inventory-card violet">
                                        <div class="eyebrow">Locations</div>
                                        <strong><%= locationShare %>% of visible inventory</strong>
                                        <div class="inventory-bar"><span style="width:<%= locationShare %>%"></span></div>
                                    </div>
                                </div>
                            </section>
                        </section>

                        <aside class="side-lane">
                            <section class="panel-card">
                                <div class="section-head">
                                    <div>
                                        <h3>Version & Signals</h3>
                                        <div class="section-kicker">Short operational readout for admin decisions.</div>
                                    </div>
                                </div>
                                <div class="flash-list">
                                    <div class="flash-note <%= versionTone %>">
                                        <i class="bi <%= versionIcon %>"></i>
                                        <div>
                                            <strong>Panel version state</strong>
                                            <span><%= versionStatus && versionStatus.message ? versionStatus.message : 'Version state unavailable.' %></span>
                                        </div>
                                    </div>
                                    <% if (success) { %>
                                        <div class="flash-note success">
                                            <i class="bi bi-check2-circle"></i>
                                            <div>
                                                <strong>Recent admin action</strong>
                                                <span><%= success %></span>
                                            </div>
                                        </div>
                                    <% } %>
                                    <% if (error) { %>
                                        <div class="flash-note error">
                                            <i class="bi bi-exclamation-triangle"></i>
                                            <div>
                                                <strong>Action needs attention</strong>
                                                <span><%= error %></span>
                                            </div>
                                        </div>
                                    <% } %>
                                    <% if (redisPrompt) { %>
                                        <div class="redis-callout">
                                            <strong>Redis still needs setup</strong>
                                            <span>Advanced cache-backed features stay limited until a Redis service is configured and reachable.</span>
                                        </div>
                                    <% } %>
                                </div>
                            </section>

                            <section class="panel-card health-dial-card">
                                <div class="section-head">
                                    <div>
                                        <h3>Control Surface Health</h3>
                                        <div class="section-kicker">Composite score based on version state, Redis posture, and live inventory presence.</div>
                                    </div>
                                </div>
                                <div class="dial-wrap">
                                    <div class="dial" style="--dial-value:<%= healthScore %>;"></div>
                                    <div class="dial-center">
                                        <strong><%= healthScore %>%</strong>
                                        <span>operational confidence</span>
                                    </div>
                                </div>
                            </section>

                            <section class="panel-card">
                                <div class="section-head">
                                    <div>
                                        <h3>Admin Feed</h3>
                                        <div class="section-kicker">Fast-read summaries instead of another large table.</div>
                                    </div>
                                </div>
                                <div class="mini-list">
                                    <% activityFeed.forEach((entry) => { %>
                                        <div class="mini-row">
                                            <div class="mini-icon"><i class="bi <%= entry.icon %>"></i></div>
                                            <div>
                                                <strong><%= entry.title %></strong>
                                                <span><%= entry.text %></span>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            </section>

                            <section class="panel-card actions-card">
                                <div class="section-head">
                                    <div>
                                        <h3>Jump Points</h3>
                                        <div class="section-kicker">Paths you likely need next while doing real admin work.</div>
                                    </div>
                                </div>
                                <a href="/admin/connect-info" class="action-link">
                                    <div class="action-copy">
                                        <strong>Connector Health</strong>
                                        <span>Inspect diagnostics, Docker access, DNS, SFTP auth, and runtime tooling.</span>
                                    </div>
                                    <div class="action-arrow"><i class="bi bi-arrow-up-right"></i></div>
                                </a>
                                <a href="/admin/incidents" class="action-link">
                                    <div class="action-copy">
                                        <strong>Incident Center</strong>
                                        <span>Review runtime alerts, clear resolved noise, and export an incident snapshot.</span>
                                    </div>
                                    <div class="action-arrow"><i class="bi bi-arrow-up-right"></i></div>
                                </a>
                                <a href="/admin/redis" class="action-link">
                                    <div class="action-copy">
                                        <strong>Redis Control</strong>
                                        <span><%= redisReady ? 'Redis is active. Fine-tune it or inspect related settings.' : 'Bring Redis online to unlock faster cache-backed flows.' %></span>
                                    </div>
                                    <div class="action-arrow"><i class="bi bi-arrow-up-right"></i></div>
                                </a>
                            </section>
                        </aside>
                    </div>
                </div>
                <div class="footer-wrap">
                    <%- include('../partials/footer') %>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" data-turbo-eval="false"></script>
</body>
</html>
