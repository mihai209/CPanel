<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' && csrfToken ? csrfToken : '' %>">
    <title><%= ((typeof settings !== 'undefined' && settings && settings.brandName) ? settings.brandName : 'CPanel') %> - <%= title || 'React View' %></title>
    <link rel="icon" type="image/png" href="<%= settings.faviconUrl %>">
    <link rel="icon" type="image/x-icon" href="<%= settings.faviconUrl %>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/react-view.css">
</head>
<body class="react-view-body">
    <div id="reactRoot"></div>
    <div id="reactLoaderFallback" class="container py-5 d-none">
        <div class="alert alert-dark border border-secondary-subtle">
            <h4 class="mb-2">React bundle is not built yet</h4>
            <div class="text-muted small mb-2">This view mode expects compiled files under <code>public/react-build/</code>.</div>
            <div class="small text-muted mb-0">Run <code>npm install</code> and then <code>npm run build:react</code> inside <code>panel/</code>.</div>
        </div>
    </div>
    <script>
        window.__CPANEL_REACT_PAGE_DATA__ = <%- JSON.stringify(typeof reactPageData !== 'undefined' ? reactPageData : {}) %>;
        window.__CPANEL_REACT_PAGE_META__ = <%- JSON.stringify({
            entry: reactEntry || '',
            title: title || 'React View'
        }) %>;
    </script>
    <script>
    (() => {
        if (window.__csrfInjected) return;
        window.__csrfInjected = true;

        const getToken = () => {
            const meta = document.querySelector('meta[name="csrf-token"]');
            return meta ? meta.getAttribute('content') : '';
        };

        const ensureFormToken = (form) => {
            if (!form || String(form.method || 'GET').toUpperCase() === 'GET') return;
            const token = getToken();
            if (!token) return;
            let input = form.querySelector('input[name="_csrf"]');
            if (!input) {
                input = document.createElement('input');
                input.type = 'hidden';
                input.name = '_csrf';
                form.appendChild(input);
            }
            input.value = token;
        };

        document.addEventListener('submit', (event) => ensureFormToken(event.target), true);

        const nativeSubmit = HTMLFormElement.prototype.submit;
        HTMLFormElement.prototype.submit = function patchedSubmit() {
            ensureFormToken(this);
            return nativeSubmit.call(this);
        };

        const nativeFetch = window.fetch;
        if (nativeFetch) {
            window.fetch = function patchedFetch(input, init = {}) {
                const request = new Request(input, init);
                const url = new URL(request.url, window.location.origin);
                if (url.origin === window.location.origin && request.method.toUpperCase() !== 'GET') {
                    const headers = new Headers(init.headers || request.headers || {});
                    const token = getToken();
                    if (token && !headers.has('X-CSRF-Token')) headers.set('X-CSRF-Token', token);
                    return nativeFetch(input, { ...init, headers });
                }
                return nativeFetch(input, init);
            };
        }

        const nativeOpen = XMLHttpRequest.prototype.open;
        const nativeSend = XMLHttpRequest.prototype.send;
        XMLHttpRequest.prototype.open = function patchedOpen(method, url) {
            this.__csrfMethod = String(method || 'GET').toUpperCase();
            this.__csrfUrl = url;
            return nativeOpen.apply(this, arguments);
        };
        XMLHttpRequest.prototype.send = function patchedSend(body) {
            try {
                const url = new URL(this.__csrfUrl, window.location.origin);
                if (url.origin === window.location.origin && this.__csrfMethod !== 'GET') {
                    const token = getToken();
                    if (token) this.setRequestHeader('X-CSRF-Token', token);
                }
            } catch (_) {}
            return nativeSend.call(this, body);
        };
    })();
    </script>
    <script>
    (() => {
        let booted = false;
        window.__CPANEL_REACT_BOOTED__ = () => {
            booted = true;
        };
        window.setTimeout(() => {
            if (booted) return;
            const fallback = document.getElementById('reactLoaderFallback');
            if (fallback) fallback.classList.remove('d-none');
        }, 1600);
        window.__CPANEL_REACT_BUNDLE_ERROR__ = () => {
            const fallback = document.getElementById('reactLoaderFallback');
            if (fallback) fallback.classList.remove('d-none');
        };
    })();
    </script>
    <script src="/react-build/<%= reactEntry %>.js?v=<%= Date.now() %>" onerror="window.__CPANEL_REACT_BUNDLE_ERROR__ && window.__CPANEL_REACT_BUNDLE_ERROR__()"></script>
</body>
</html>
