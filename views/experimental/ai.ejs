<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/error-modal') %>

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="text-light mb-1">Experimental Features</h2>
            <div class="text-muted">These features are in early access and may be unstable.</div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm"
                style="background-color: #141419; border: 1px solid rgba(255,255,255,0.05) !important; border-radius: 15px;">
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div>
                            <h5 class="mb-1 text-light"><i class="bi bi-robot me-2 text-primary"></i>Rocky AI Agent</h5>
                            <div class="text-muted small">Chat assistant in console. May respond incorrectly or fail.</div>
                            <div class="text-muted small mt-2">
                                Daily quota: <span class="text-info"><%= quotaUsed %></span> / <span class="text-info"><%= quotaLimit %></span>
                            </div>
                            <% if (!aiAdminEnabled) { %>
                                <div class="text-warning small mt-2">
                                    <i class="bi bi-exclamation-triangle me-1"></i>Admin has not enabled AI agents yet.
                                </div>
                            <% } %>
                            <% if (aiAdminEnabled && !aiProviderReady) { %>
                                <div class="text-warning small mt-2">
                                    <i class="bi bi-exclamation-triangle me-1"></i>No AI provider configured by admin.
                                </div>
                            <% } %>
                        </div>
                        <form action="/experimental/ai" method="POST" class="d-flex align-items-center gap-3">
                            <div class="form-check form-switch text-light">
                                <input class="form-check-input" type="checkbox" id="aiExperimentalToggle" name="enabled"
                                    value="true" <%= user.experimentalAiEnabled ? 'checked' : '' %> <%= (!aiAdminEnabled || !aiProviderReady) ? 'disabled' : '' %>>
                                <label class="form-check-label" for="aiExperimentalToggle">Enable</label>
                            </div>
                            <button type="submit" class="btn btn-outline-info btn-sm" <%= (!aiAdminEnabled || !aiProviderReady) ? 'disabled' : '' %>>
                                Save
                            </button>
                        </form>
                    </div>

                    <div class="alert alert-warning mt-4 mb-0">
                        <strong>Warning:</strong> Experimental features may be unstable. Use at your own risk.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

</body>
</html>
