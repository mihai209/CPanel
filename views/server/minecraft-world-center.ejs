<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>World Center <%= server.name %> | <%= settings.brandName.toUpperCase() %></title>
    <%- include('../partials/favicon') %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/mobile-layout.css">
    <style>
        :root {
            --bg: #0f0f12;
            --panel: #121216;
            --border: #2d2d35;
            --text: #e1e1e6;
            --muted: #8b8b9a;
            --ok: #22c55e;
            --warn: #f59e0b;
            --danger: #ef4444;
            --accent: #60a5fa;
        }
        body { background: var(--bg); color: var(--text); margin: 0; font-family: Inter, system-ui, -apple-system, sans-serif; height: 100vh; overflow: hidden; }
        .wrapper { display: flex; height: 100vh; }
        .sidebar { width: 260px; background: var(--panel); border-right: 1px solid var(--border); overflow-y: auto; }
        .sidebar.collapsed { margin-left: -260px; }
        .content { flex: 1; display: flex; flex-direction: column; min-width: 0; }
        .top { background: var(--panel); border-bottom: 1px solid var(--border); padding: .75rem 1rem; display: flex; align-items: center; gap: .75rem; }
        .scroll { flex: 1; overflow: auto; padding: 1rem; }
        .btn-icon { background: transparent; border: 0; color: var(--muted); font-size: 1.2rem; }
        .cardx { background: var(--panel); border: 1px solid var(--border); border-radius: .95rem; }
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 1rem; }
        .stat-card { padding: 1rem; border-radius: .9rem; border: 1px solid rgba(255,255,255,.05); background: rgba(255,255,255,.02); }
        .stat-label { color: var(--muted); font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; }
        .stat-value { font-size: 1.5rem; font-weight: 700; margin-top: .35rem; }
        .world-table-wrap { overflow: auto; }
        .table-dark { --bs-table-bg: transparent; --bs-table-border-color: rgba(255,255,255,.08); }
        .badge-soft { display: inline-flex; align-items: center; gap: .35rem; padding: .35rem .65rem; border-radius: 999px; font-size: .75rem; border: 1px solid rgba(255,255,255,.08); background: rgba(255,255,255,.03); color: var(--text); }
        .badge-soft.active { background: rgba(34,197,94,.12); border-color: rgba(34,197,94,.35); color: #86efac; }
        .badge-soft.warn { background: rgba(245,158,11,.12); border-color: rgba(245,158,11,.35); color: #fcd34d; }
        .badge-soft.info { background: rgba(96,165,250,.12); border-color: rgba(96,165,250,.35); color: #bfdbfe; }
        .ops-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; }
        .op-card { padding: 1rem; }
        .op-card h2 { font-size: 1rem; margin-bottom: .35rem; }
        .op-card p { color: var(--muted); font-size: .86rem; margin-bottom: 1rem; }
        .mini-note { color: var(--muted); font-size: .8rem; }
        .seed-cell { font-family: "JetBrains Mono", monospace; font-size: .85rem; }
        .world-chip-row { display: flex; flex-wrap: wrap; gap: .35rem; }
        .danger-zone { border-color: rgba(239,68,68,.28); }
        .danger-zone .btn-danger { background: var(--danger); border-color: var(--danger); }
    </style>
</head>
<body>
<%- include('../partials/error-modal') %>
<div class="wrapper">
    <nav class="sidebar" id="sidebar"><div class="p-3"><%- include('../partials/server-sidebar', { server, active: 'mccenter' }) %></div></nav>
    <main class="content">
        <header class="top">
            <button class="btn-icon" id="sidebarToggle"><i class="bi bi-list"></i></button>
            <h1 class="h5 mb-0">World Operations Center / <span class="text-secondary"><%= server.name %></span></h1>
        </header>
        <section class="scroll">
            <% const worlds = Array.isArray(worldData && worldData.worlds) ? worldData.worlds : []; %>
            <% const activeWorld = String(worldData && worldData.levelName || 'world'); %>
            <% const exportFile = feedback && feedback.exportFile ? String(feedback.exportFile) : ''; %>

            <% if (feedback && feedback.success) { %>
                <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i><%= feedback.success %></div>
            <% } %>
            <% if (feedback && feedback.warning) { %>
                <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-2"></i><%= feedback.warning %></div>
            <% } %>
            <% if (feedback && feedback.error) { %>
                <div class="alert alert-danger"><i class="bi bi-x-circle me-2"></i><%= feedback.error %></div>
            <% } %>

            <div class="cardx p-3 mb-3">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div>
                        <div class="small text-secondary mb-1">Manage Minecraft worlds without leaving the panel.</div>
                        <div class="mini-note">Clone, switch active world, prune stale worlds, inspect seeds, and import/export archives with safety checks.</div>
                    </div>
                    <div class="world-chip-row">
                        <span class="badge-soft active"><i class="bi bi-compass"></i> Active: <%= activeWorld %></span>
                        <span class="badge-soft info"><i class="bi bi-hdd-stack"></i> <%= worlds.length %> worlds</span>
                        <span class="badge-soft <%= String(server.status || '').toLowerCase() === 'running' ? 'warn' : 'info' %>">
                            <i class="bi bi-power"></i>
                            <%= String(server.status || 'unknown').toUpperCase() %>
                        </span>
                    </div>
                </div>
                <% if (exportFile) { %>
                    <div class="mt-3">
                        <a class="btn btn-outline-info btn-sm" href="/server/<%= server.containerId %>/files/download?file=<%= encodeURIComponent(exportFile) %>">
                            <i class="bi bi-download me-1"></i>Download Latest Export
                        </a>
                        <span class="mini-note ms-2"><code><%= exportFile %></code></span>
                    </div>
                <% } %>
            </div>

            <div class="stats-grid mb-3">
                <div class="stat-card">
                    <div class="stat-label">Active World</div>
                    <div class="stat-value"><%= activeWorld %></div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">World Count</div>
                    <div class="stat-value"><%= worlds.length %></div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Tracked Size</div>
                    <div class="stat-value"><%= worlds.reduce((sum, world) => sum + (Number(world.sizeMb) || 0), 0).toFixed(2) %> MB</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Prune Safety</div>
                    <div class="stat-value"><%= String(server.status || '').toLowerCase() === 'running' ? 'Stop First' : 'Ready' %></div>
                </div>
            </div>

            <div class="cardx p-3 mb-3">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 class="h5 mb-0">World Inventory</h2>
                    <span class="mini-note">Seed/info comes from <code>level.dat</code> when available.</span>
                </div>
                <div class="world-table-wrap">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width:44px;"></th>
                                <th>World</th>
                                <th>Seed</th>
                                <th>Info</th>
                                <th>Stats</th>
                                <th>Modified</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!worlds.length) { %>
                                <tr><td colspan="6" class="text-secondary">No worlds were detected from the server root.</td></tr>
                            <% } %>
                            <% worlds.forEach((world) => { %>
                                <tr>
                                    <td>
                                        <% if (!world.active) { %>
                                            <input type="checkbox" class="form-check-input prune-world-checkbox" form="pruneWorldsForm" name="worlds" value="<%= world.name %>">
                                        <% } %>
                                    </td>
                                    <td>
                                        <div class="fw-semibold"><%= world.name %></div>
                                        <div class="world-chip-row mt-1">
                                            <% if (world.active) { %><span class="badge-soft active">active</span><% } %>
                                            <% if (world.hasNether) { %><span class="badge-soft info">nether</span><% } %>
                                            <% if (world.hasEnd) { %><span class="badge-soft info">end</span><% } %>
                                            <% if (!world.hasLevelDat) { %><span class="badge-soft warn">missing level.dat</span><% } %>
                                        </div>
                                    </td>
                                    <td class="seed-cell"><%= world.seed || 'N/A' %></td>
                                    <td class="small text-secondary">
                                        <div>Display: <%= world.levelDisplayName || 'N/A' %></div>
                                        <div>Gamemode: <%= world.gameType || 'N/A' %></div>
                                        <div>Difficulty: <%= world.difficulty || 'N/A' %></div>
                                    </td>
                                    <td class="small text-secondary">
                                        <div><%= Number(world.sizeMb || 0).toFixed(2) %> MB</div>
                                        <div><%= world.regionFiles || 0 %> regions</div>
                                        <div><%= world.knownPlayers || 0 %> playerdata</div>
                                    </td>
                                    <td class="small text-secondary"><%= world.lastModified ? new Date(world.lastModified).toLocaleString() : 'N/A' %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="ops-grid">
                <div class="cardx op-card">
                    <h2>Clone World</h2>
                    <p>Duplicates the selected world and its Nether/End folders. Requires the server to be stopped.</p>
                    <form method="POST" action="/server/<%= server.containerId %>/minecraft/world-center/clone">
                        <div class="mb-3">
                            <label class="form-label">Source world</label>
                            <select class="form-select bg-dark text-light border-secondary" name="sourceWorld" required>
                                <option value="">Select world</option>
                                <% worlds.forEach((world) => { %>
                                    <option value="<%= world.name %>"><%= world.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Target world name</label>
                            <input class="form-control bg-dark text-light border-secondary" type="text" name="targetWorld" placeholder="world_clone" required>
                        </div>
                        <button class="btn btn-primary" type="submit"><i class="bi bi-copy me-1"></i>Clone World</button>
                    </form>
                </div>

                <div class="cardx op-card">
                    <h2>Swap Active World</h2>
                    <p>Updates <code>server.properties</code> <code>level-name</code>. If the server is running, restart it after the change.</p>
                    <form method="POST" action="/server/<%= server.containerId %>/minecraft/world-center/swap">
                        <div class="mb-3">
                            <label class="form-label">New active world</label>
                            <select class="form-select bg-dark text-light border-secondary" name="activeWorld" required>
                                <% worlds.forEach((world) => { %>
                                    <option value="<%= world.name %>" <%= world.active ? 'selected' : '' %>><%= world.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <button class="btn btn-outline-info" type="submit"><i class="bi bi-arrow-left-right me-1"></i>Set Active World</button>
                    </form>
                </div>

                <div class="cardx op-card danger-zone">
                    <h2>Prune Old Worlds</h2>
                    <p>Deletes the checked worlds from the inventory table above, including companion Nether/End folders. Active world is protected.</p>
                    <form method="POST" action="/server/<%= server.containerId %>/minecraft/world-center/prune" id="pruneWorldsForm">
                        <button class="btn btn-danger" type="submit"><i class="bi bi-trash me-1"></i>Prune Selected Worlds</button>
                    </form>
                </div>

                <div class="cardx op-card">
                    <h2>Export World</h2>
                    <p>Builds a single zip at server root containing the selected world and its dimension folders.</p>
                    <form method="POST" action="/server/<%= server.containerId %>/minecraft/world-center/export">
                        <div class="mb-3">
                            <label class="form-label">World</label>
                            <select class="form-select bg-dark text-light border-secondary" name="worldName" required>
                                <option value="">Select world</option>
                                <% worlds.forEach((world) => { %>
                                    <option value="<%= world.name %>"><%= world.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Archive name</label>
                            <input class="form-control bg-dark text-light border-secondary" type="text" name="archiveName" placeholder="world-export.zip">
                        </div>
                        <button class="btn btn-outline-success" type="submit"><i class="bi bi-box-arrow-down me-1"></i>Export World</button>
                    </form>
                </div>

                <div class="cardx op-card">
                    <h2>Import World</h2>
                    <p>Imports an already uploaded archive from the server filesystem. Requires the server to be stopped.</p>
                    <form method="POST" action="/server/<%= server.containerId %>/minecraft/world-center/import">
                        <div class="mb-3">
                            <label class="form-label">Archive path</label>
                            <input class="form-control bg-dark text-light border-secondary" type="text" name="archivePath" placeholder="/backup/world.zip" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Target world name</label>
                            <input class="form-control bg-dark text-light border-secondary" type="text" name="targetWorld" placeholder="new_world" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Archive layout</label>
                            <select class="form-select bg-dark text-light border-secondary" name="importMode">
                                <option value="contents">Archive contains raw world contents</option>
                                <option value="folder">Archive already contains a top-level world folder</option>
                            </select>
                        </div>
                        <button class="btn btn-outline-warning" type="submit"><i class="bi bi-box-arrow-in-down me-1"></i>Import World</button>
                    </form>
                </div>
            </div>
        </section>
    </main>
</div>
<script>
    document.getElementById('sidebarToggle')?.addEventListener('click', () => document.getElementById('sidebar')?.classList.toggle('collapsed'));
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" data-turbo-eval="false"></script>
</body>
</html>
