<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Activity <%= server.name %> | <%= settings.brandName.toUpperCase() %></title>
    <%- include('../partials/favicon') %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body { background:#0f0f12; color:#e1e1e6; margin:0; font-family:Inter,system-ui,-apple-system,sans-serif; height:100vh; overflow:hidden; }
        .wrapper{display:flex;height:100vh}.sidebar{width:260px;background:#121216;border-right:1px solid #2d2d35;overflow-y:auto}.sidebar.collapsed{margin-left:-260px}
        .content{flex:1;display:flex;flex-direction:column;min-width:0}.top{background:#121216;border-bottom:1px solid #2d2d35;padding:.75rem 1rem;display:flex;align-items:center;gap:.75rem}
        .scroll{flex:1;overflow:auto;padding:1rem}.cardx{background:#121216;border:1px solid #2d2d35;border-radius:.8rem}.btn-icon{background:transparent;border:0;color:#8b8b9a;font-size:1.2rem}
        .table-dark{--bs-table-bg:transparent}
        .section-title{font-size:.82rem;color:#8b8b9a;text-transform:uppercase;letter-spacing:.08em;font-weight:700}
        .badge-soft{display:inline-block;padding:.2rem .55rem;border-radius:999px;font-size:.72rem;border:1px solid #2d2d35;background:#17171d;color:#d2d2db}
        .activity-badge{display:inline-flex;align-items:center;gap:.35rem;padding:.28rem .62rem;border-radius:999px;font-size:.72rem;font-weight:700;letter-spacing:.04em;border:1px solid transparent}
        .activity-badge.is-transition{background:rgba(59,130,246,.12);border-color:rgba(59,130,246,.26);color:#93c5fd}
        .activity-badge.is-mismatch{background:rgba(239,68,68,.12);border-color:rgba(239,68,68,.26);color:#fda4af}
        .activity-badge.is-recovery{background:rgba(245,158,11,.12);border-color:rgba(245,158,11,.26);color:#fcd34d}
        .activity-badge.is-debug{background:rgba(148,163,184,.12);border-color:rgba(148,163,184,.22);color:#cbd5e1}
        .activity-badge.is-power{background:rgba(16,185,129,.12);border-color:rgba(16,185,129,.26);color:#86efac}
        .activity-meta-line{color:#8b8b9a;font-size:.78rem;margin-top:.18rem}
    </style>
    <link rel="stylesheet" href="/css/mobile-layout.css">
</head>
<body>
<%
function activityActionLabel(action) {
    const value = String(action || '').trim();
    const map = {
        'server:state.transition': 'Runtime state transition',
        'server:state.mismatch': 'Runtime/DB mismatch',
        'server:recovery.policy': 'Policy recovery action',
        'server:recovery.auto': 'Automatic crash recovery',
        'server:recovery.action': 'Recovery assistant action',
        'server:power.action': 'Power action',
        'server:debug.crash': 'Crash detected',
        'server:debug.stop': 'Graceful stop',
        'server:debug.install_fail': 'Install failed'
    };
    return map[value] || value || '-';
}

function activityActionTone(action) {
    const value = String(action || '').trim();
    if (value === 'server:state.transition') return 'transition';
    if (value === 'server:state.mismatch') return 'mismatch';
    if (value === 'server:recovery.policy' || value === 'server:recovery.auto' || value === 'server:recovery.action') return 'recovery';
    if (value === 'server:power.action') return 'power';
    return 'debug';
}

function formatMetaDate(value) {
    if (!value) return '';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return '';
    return date.toLocaleString();
}

function activitySummary(log) {
    const action = String(log && log.action || '').trim();
    const metadata = log && log.metadata && typeof log.metadata === 'object' ? log.metadata : {};
    if (action === 'server:state.transition' || action === 'server:state.mismatch') {
        const prev = metadata.previousStatus || 'unknown';
        const next = metadata.nextStatus || 'unknown';
        const src = metadata.source || 'system';
        const reason = metadata.reason ? ` · ${metadata.reason}` : '';
        const startedAt = formatMetaDate(metadata.startedAt);
        const finishedAt = formatMetaDate(metadata.finishedAt);
        const timeBits = [startedAt ? `started ${startedAt}` : '', finishedAt ? `finished ${finishedAt}` : ''].filter(Boolean);
        return `${prev} -> ${next} via ${src}${reason}${timeBits.length ? ` · ${timeBits.join(' · ')}` : ''}`;
    }
    if (action === 'server:recovery.policy') {
        return `${metadata.playbook || 'policy'} -> ${metadata.action || 'unknown'}`;
    }
    if (action === 'server:recovery.auto') {
        return `${metadata.action || 'start'} after crash`;
    }
    if (action === 'server:power.action') {
        return `${metadata.powerAction || 'unknown'} requested`;
    }
    if (action === 'server:debug.crash') {
        const exit = metadata.exitCode !== undefined && metadata.exitCode !== null ? `exit ${metadata.exitCode}` : 'no exit code';
        return metadata.oomKilled ? `${exit} · OOM killed` : exit;
    }
    return '';
}
%>

<%- include('../partials/error-modal') %>
<div class="wrapper">
    <nav class="sidebar" id="sidebar"><div class="p-3"><%- include('../partials/server-sidebar', { server, active: 'activity' }) %></div></nav>
    <main class="content">
        <header class="top">
            <button class="btn-icon" id="sidebarToggle"><i class="bi bi-list"></i></button>
            <h1 class="h5 mb-0">Activity / <span class="text-secondary"><%= server.name %></span></h1>
        </header>
        <section class="scroll">
            <div class="cardx p-3 mb-3">
                <div class="section-title mb-3">What Changed</div>
                <div class="table-responsive">
                    <table class="table table-dark table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>When</th>
                                <th>Actor</th>
                                <th>Category</th>
                                <th>Summary</th>
                                <th>Diff</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!changeLogs || changeLogs.length === 0) { %>
                                <tr><td colspan="5" class="text-secondary">No change entries yet.</td></tr>
                            <% } else { changeLogs.forEach((entry) => { %>
                                <tr>
                                    <td><%= new Date(entry.createdAt).toLocaleString() %></td>
                                    <td><%= entry.actor ? entry.actor.username : 'system' %></td>
                                    <td><span class="badge-soft"><%= entry.category || '-' %></span></td>
                                    <td>
                                        <div><strong><%= entry.summary || entry.changeKey || '-' %></strong></div>
                                        <% if (entry.changeKey) { %><div class="text-secondary small"><code><%= entry.changeKey %></code></div><% } %>
                                    </td>
                                    <td>
                                        <div class="small text-secondary">Before: <code><%= JSON.stringify(entry.beforeValue) %></code></div>
                                        <div class="small text-secondary mt-1">After: <code><%= JSON.stringify(entry.afterValue) %></code></div>
                                    </td>
                                </tr>
                            <% }) } %>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="cardx p-3">
                <div class="section-title mb-3">Activity Log</div>
                <div class="table-responsive">
                    <table class="table table-dark table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>When</th>
                                <th>Actor</th>
                                <th>Action</th>
                                <th>Summary</th>
                                <th>IP</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!logs || logs.length === 0) { %>
                                <tr><td colspan="5" class="text-secondary">No activity entries yet.</td></tr>
                            <% } else { logs.forEach((log) => { %>
                                <tr>
                                    <td><%= new Date(log.createdAt).toLocaleString() %></td>
                                    <td><%= log.actor ? log.actor.username : 'system' %></td>
                                    <td>
                                        <div>
                                            <span class="activity-badge is-<%= activityActionTone(log.action) %>">
                                                <%= activityActionLabel(log.action) %>
                                            </span>
                                        </div>
                                        <% if (log.action && log.action !== activityActionLabel(log.action)) { %>
                                            <div class="activity-meta-line"><%= log.action %></div>
                                        <% } %>
                                    </td>
                                    <td>
                                        <div><%= activitySummary(log) || ([log.targetType || '', log.targetId || ''].filter(Boolean).join(' / ') || '-') %></div>
                                        <% if (log.metadata && (log.metadata.source || log.metadata.reason || log.metadata.mismatch)) { %>
                                            <div class="activity-meta-line">
                                                <% if (log.metadata.source) { %><span>source=<code><%= log.metadata.source %></code></span><% } %>
                                                <% if (log.metadata.reason) { %><span class="ms-2">reason=<code><%= log.metadata.reason %></code></span><% } %>
                                                <% if (log.metadata.mismatch) { %><span class="ms-2 text-warning">mismatch</span><% } %>
                                            </div>
                                        <% } %>
                                    </td>
                                    <td><%= log.ip || '-' %></td>
                                </tr>
                            <% }) } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>
</div>
<script>document.getElementById('sidebarToggle')?.addEventListener('click',()=>document.getElementById('sidebar')?.classList.toggle('collapsed'));</script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" data-turbo-eval="false"></script>
</body>
</html>
