<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/error-modal') %>

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="text-light mb-1"><%= server.name %> · AI Controls</h2>
            <div class="text-muted small">Control what Rocky AI can do on this server.</div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12">
            <form method="POST" class="card border-0 shadow-sm"
                style="background-color:#141419; border:1px solid rgba(255,255,255,0.05) !important; border-radius:15px;">
                <div class="card-body p-4">
                    <% if (!aiAdminEnabled) { %>
                        <div class="alert alert-warning mb-4">
                            Admin has not enabled AI agents yet.
                        </div>
                    <% } %>

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                        <div>
                            <h5 class="text-light mb-1"><i class="bi bi-robot me-2 text-primary"></i>Enable AI for this server</h5>
                            <div class="text-muted small">Users must also enable Experimental Features.</div>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="aiEnabled" name="aiEnabled" value="true"
                                <%= aiPolicy.enabled ? 'checked' : '' %>>
                            <label class="form-check-label text-light" for="aiEnabled">Enabled</label>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="aiAllowStart" name="aiAllowStart" value="true"
                                    <%= aiPolicy.allowStart ? 'checked' : '' %>>
                                <label class="form-check-label text-light" for="aiAllowStart">Let AI start server</label>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="aiAllowStop" name="aiAllowStop" value="true"
                                    <%= aiPolicy.allowStop ? 'checked' : '' %>>
                                <label class="form-check-label text-light" for="aiAllowStop">Let AI stop server</label>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="aiAllowRestart" name="aiAllowRestart" value="true"
                                    <%= aiPolicy.allowRestart ? 'checked' : '' %>>
                                <label class="form-check-label text-light" for="aiAllowRestart">Let AI restart server</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 p-4 pt-0">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a href="/server/<%= server.containerId %>" class="btn btn-outline-secondary ms-2">Back</a>
                </div>
            </form>
        </div>
    </div>
</div>

</body>
</html>
