<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Controls <%= server.name %> | <%= settings.brandName.toUpperCase() %></title>
    <%- include('../partials/favicon') %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { background:#0f0f12; color:#e1e1e6; margin:0; font-family:Inter,system-ui,-apple-system,sans-serif; height:100vh; overflow:hidden; }
        .wrapper{display:flex;height:100vh}.sidebar{width:260px;background:#121216;border-right:1px solid #2d2d35;overflow-y:auto}.sidebar.collapsed{margin-left:-260px}
        .content{flex:1;display:flex;flex-direction:column;min-width:0}.top{background:#121216;border-bottom:1px solid #2d2d35;padding:.75rem 1rem;display:flex;align-items:center;gap:.75rem}
        .scroll{flex:1;overflow:auto;padding:1rem}
        .btn-icon{background:transparent;border:0;color:#8b8b9a;font-size:1.2rem}
    </style>
    <link rel="stylesheet" href="/css/mobile-layout.css">
</head>
<body>

<%- include('../partials/error-modal') %>
<div class="wrapper">
    <nav class="sidebar" id="sidebar"><div class="p-3"><%- include('../partials/server-sidebar', { server, active: 'ai' }) %></div></nav>
    <main class="content">
        <header class="top">
            <button class="btn-icon" id="sidebarToggle"><i class="bi bi-list"></i></button>
            <h1 class="h5 mb-0">AI Controls / <span class="text-secondary"><%= server.name %></span></h1>
        </header>
        <section class="scroll">
            <div class="row g-4">
                <div class="col-12">
                    <form method="POST" class="card border-0 shadow-sm"
                        style="background-color:#141419; border:1px solid rgba(255,255,255,0.05) !important; border-radius:15px;">
                        <div class="card-body p-4">
                            <% if (!aiAdminEnabled) { %>
                                <div class="alert alert-warning mb-4">
                                    Admin has not enabled AI agents yet.
                                </div>
                            <% } %>

                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                                <div>
                                    <h5 class="text-light mb-1"><i class="bi bi-robot me-2 text-primary"></i>Enable AI for this server</h5>
                                    <div class="text-muted small">Users must also enable Experimental Features.</div>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="aiEnabled" name="aiEnabled" value="true"
                                        <%= aiPolicy.enabled ? 'checked' : '' %>>
                                    <label class="form-check-label text-light" for="aiEnabled">Enabled</label>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-12 col-md-4">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="aiAllowStart" name="aiAllowStart" value="true"
                                            <%= aiPolicy.allowStart ? 'checked' : '' %>>
                                        <label class="form-check-label text-light" for="aiAllowStart">Let AI start server</label>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="aiAllowStop" name="aiAllowStop" value="true"
                                            <%= aiPolicy.allowStop ? 'checked' : '' %>>
                                        <label class="form-check-label text-light" for="aiAllowStop">Let AI stop server</label>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="aiAllowRestart" name="aiAllowRestart" value="true"
                                            <%= aiPolicy.allowRestart ? 'checked' : '' %>>
                                        <label class="form-check-label text-light" for="aiAllowRestart">Let AI restart server</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-0 p-4 pt-0">
                            <button type="submit" class="btn btn-primary">Save</button>
                            <a href="/server/<%= server.containerId %>" class="btn btn-outline-secondary ms-2">Back</a>
                        </div>
                    </form>
                </div>
            </div>
        </section>
    </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" data-turbo-eval="false"></script>
<script>
    document.getElementById('sidebarToggle')?.addEventListener('click', () => document.getElementById('sidebar')?.classList.toggle('collapsed'));
</script>
</body>
</html>
