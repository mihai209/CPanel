<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="turbo-visit-control" content="reload">
    <title>
        <%= title %> | <%= settings.brandName.toUpperCase() %>
    </title>
    <%- include('../partials/favicon.ejs') %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/xterm@5.2.1/css/xterm.css" />
    <script>
        const isPopout = new URLSearchParams(window.location.search).get('popout') === 'true';
        if (isPopout) {
            document.documentElement.classList.add('is-popout');
        }
    </script>
    <%- include('./partials/console/styles') %>
    <link rel="stylesheet" href="/css/mobile-layout.css">
</head>

<body data-turbo="false">
    <%- include('../partials/error-modal') %>
    <%- include('./partials/console/layout') %>
    <%- include('./partials/console/scripts') %>
</body>

</html>
