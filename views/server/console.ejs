<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="turbo-visit-control" content="reload">
    <title>
        <%= title %> | <%= settings.brandName.toUpperCase() %>
    </title>
    <%- include('../partials/favicon.ejs') %>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/xterm@5.2.1/css/xterm.css" />
        <script>
            const isPopout = new URLSearchParams(window.location.search).get('popout') === 'true';
            if (isPopout) {
                document.documentElement.classList.add('is-popout');
            }
        </script>
        <style>
            html.is-popout .sidebar,
            html.is-popout .top-navbar {
                display: none !important;
            }

            html.is-popout .terminal-wrapper {
                padding: 0 !important;
            }

            html.is-popout .terminal-container {
                border-radius: 0 !important;
                border: none !important;
            }

            html.is-popout .wrapper {
                width: 100vw !important;
                height: 100vh !important;
            }

            :root {
                --bg-dark: #0f0f12;
                --bg-darker: #0a0a0c;
                --bg-sidebar: #121216;
                --border-color: #2d2d35;
                --text-primary: #e1e1e6;
                --text-secondary: #8b8b9a;
                --accent-blue: #3b82f6;
                --accent-green: #10b981;
                --accent-red: #ef4444;
                --accent-yellow: #f59e0b;
            }

            .rocky-ai-messages {
                height: 320px;
                overflow-y: auto;
                background: #0c0e13;
                border: 1px solid rgba(255,255,255,0.08);
                border-radius: 12px;
                padding: 12px;
                display: flex;
                flex-direction: column;
                gap: 10px;
            }

            .rocky-ai-message {
                padding: 10px 12px;
                border-radius: 10px;
                font-size: 0.9rem;
                line-height: 1.4;
            }

            .rocky-ai-message.user {
                background: rgba(59, 130, 246, 0.18);
                border: 1px solid rgba(59, 130, 246, 0.4);
                color: #e5f1ff;
                align-self: flex-end;
                max-width: 85%;
            }

            .rocky-ai-message.assistant {
                background: rgba(16, 185, 129, 0.12);
                border: 1px solid rgba(16, 185, 129, 0.35);
                color: #e8fff4;
                align-self: flex-start;
                max-width: 85%;
            }

            .rocky-ai-message.system {
                background: rgba(245, 158, 11, 0.12);
                border: 1px solid rgba(245, 158, 11, 0.35);
                color: #fff4dc;
                align-self: stretch;
            }

            body {
                background-color: var(--bg-dark);
                color: var(--text-primary);
                font-family: 'Inter', system-ui, -apple-system, sans-serif;
                overflow: hidden;
                height: 100vh;
            }

            /* Wrapper for sidebar + content */
            .wrapper {
                display: flex;
                height: 100vh;
                overflow: hidden;
            }

            /* Sidebar styles */
            .sidebar {
                width: 260px;
                background: var(--bg-sidebar);
                border-right: 1px solid var(--border-color);
                transition: all 0.3s ease;
                display: flex;
                flex-direction: column;
                flex-shrink: 0;
                overflow-y: auto;
            }

            .sidebar.collapsed {
                margin-left: -260px;
            }

            .sidebar .sidebar-content {
                padding: 1.5rem 0.75rem;
            }

            .sidebar-item {
                display: flex;
                align-items: center;
                padding: 0.75rem 1rem;
                color: var(--text-secondary);
                text-decoration: none;
                border-radius: 8px;
                transition: all 0.2s ease;
                font-weight: 500;
                font-size: 0.9rem;
                margin-bottom: 0.25rem;
            }

            .sidebar-item:hover {
                background: rgba(255, 255, 255, 0.03);
                color: var(--text-primary);
            }

            .sidebar-item.active {
                background: rgba(59, 130, 246, 0.1);
                color: var(--accent-blue);
            }

            .sidebar-icon {
                margin-right: 12px;
                font-size: 1.1rem;
                width: 24px;
                text-align: center;
            }

            /* Main content area */
            .content {
                flex: 1;
                display: flex;
                flex-direction: column;
                overflow: hidden;
                background: var(--bg-dark);
            }

            /* Top navbar */
            .top-navbar {
                background: var(--bg-sidebar);
                border-bottom: 1px solid var(--border-color);
                padding: 0.75rem 1.5rem;
                display: flex;
                align-items: center;
                flex-shrink: 0;
                gap: 0.75rem;
            }

            .navbar-toggle {
                background: transparent;
                border: none;
                color: var(--text-secondary);
                font-size: 1.5rem;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-right: 1rem;
                cursor: pointer;
                padding: 0;
            }

            .navbar-toggle:hover {
                color: var(--text-primary);
            }

            .server-info {
                display: flex;
                align-items: center;
                flex-wrap: wrap;
                gap: 1rem;
            }

            .server-meta-line {
                color: var(--text-secondary);
                font-size: 0.78rem;
                width: 100%;
                margin-top: -0.25rem;
            }

            .top-navbar-right {
                margin-left: auto;
                display: flex;
                align-items: center;
                gap: 0.5rem;
                flex-wrap: wrap;
                justify-content: flex-end;
            }

            .server-name {
                font-size: 1.25rem;
                font-weight: 600;
                margin: 0;
            }

            .server-address {
                color: var(--text-secondary);
                font-size: 0.85rem;
            }

            /* Status badge (reuse existing styles but adjust) */
            .status-badge {
                padding: 0.4rem 1rem;
                border-radius: 20px;
                font-size: 0.75rem;
                font-weight: 600;
                display: inline-flex;
                align-items: center;
                background: rgba(16, 185, 129, 0.15);
                color: #10b981;
                border: 1px solid rgba(16, 185, 129, 0.3);
            }

            .status-dot {
                display: inline-block;
                width: 8px;
                height: 8px;
                border-radius: 50%;
                margin-right: 8px;
            }

            .status-running .status-dot {
                background: #10b981;
                animation: pulse 2s infinite;
            }

            .status-stopped .status-dot {
                background: #ef4444;
            }

            .status-stopped {
                background: rgba(239, 68, 68, 0.15);
                color: #ef4444;
                border-color: rgba(239, 68, 68, 0.3);
            }

            .status-starting .status-dot {
                background: #3b82f6;
                animation: pulse 2s infinite;
            }

            .status-starting {
                background: rgba(59, 130, 246, 0.15);
                color: #3b82f6;
                border-color: rgba(59, 130, 246, 0.3);
            }

            @keyframes pulse {

                0%,
                100% {
                    opacity: 1;
                }

                50% {
                    opacity: 0.5;
                }
            }

            /* Terminal container */
            .terminal-wrapper {
                flex: 1;
                padding: 1.1rem 1.25rem;
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }

            .terminal-wrapper.provisioning-focused {
                justify-content: center;
            }

            .provisioning-screen {
                flex: 1 1 auto;
                display: flex;
                align-items: center;
                justify-content: center;
                min-height: 0;
            }

            .provisioning-screen-card {
                width: min(640px, 100%);
                background: linear-gradient(180deg, rgba(18, 18, 22, 0.96), rgba(10, 10, 12, 0.98));
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 22px;
                padding: 2rem 2.2rem;
                box-shadow: 0 24px 50px rgba(0, 0, 0, 0.45);
                text-align: center;
            }

            .provisioning-screen-image {
                width: 150px;
                max-width: 40vw;
                margin: 0 auto 1.35rem;
                display: block;
                filter: drop-shadow(0 14px 24px rgba(0, 0, 0, 0.35));
            }

            .provisioning-screen-title {
                font-size: 1.7rem;
                font-weight: 800;
                color: #f8fafc;
                margin: 0 0 0.65rem;
                letter-spacing: -0.02em;
            }

            .provisioning-screen-message {
                color: rgba(255, 255, 255, 0.72);
                font-size: 0.98rem;
                line-height: 1.65;
                margin: 0 auto 1.1rem;
                max-width: 480px;
            }

            .provisioning-screen-status {
                display: inline-flex;
                align-items: center;
                gap: 0.45rem;
                background: rgba(59, 130, 246, 0.14);
                color: #bfdbfe;
                border: 1px solid rgba(96, 165, 250, 0.28);
                border-radius: 999px;
                padding: 0.48rem 0.95rem;
                font-size: 0.78rem;
                font-weight: 700;
                letter-spacing: 0.04em;
                text-transform: uppercase;
            }

            .provisioning-screen-note {
                margin-top: 1rem;
                color: rgba(255, 255, 255, 0.48);
                font-size: 0.82rem;
            }

            .admin-install-screen {
                flex: 1 1 auto;
                display: flex;
                flex-direction: column;
                min-height: 0;
                gap: 0.95rem;
            }

            .admin-install-header {
                background: linear-gradient(180deg, rgba(18, 18, 22, 0.96), rgba(10, 10, 12, 0.98));
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 18px;
                padding: 1.2rem 1.35rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                flex-wrap: wrap;
            }

            .admin-install-title {
                font-size: 1.15rem;
                font-weight: 800;
                color: #f8fafc;
                margin: 0 0 0.3rem;
            }

            .admin-install-message {
                color: rgba(255, 255, 255, 0.7);
                font-size: 0.9rem;
                margin: 0;
            }

            .admin-install-badge {
                display: inline-flex;
                align-items: center;
                gap: 0.45rem;
                border-radius: 999px;
                padding: 0.45rem 0.9rem;
                border: 1px solid rgba(96, 165, 250, 0.28);
                background: rgba(59, 130, 246, 0.12);
                color: #bfdbfe;
                font-size: 0.76rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }

            .admin-install-alert {
                border: 1px solid rgba(245, 158, 11, 0.24);
                background: rgba(245, 158, 11, 0.1);
                color: #fde68a;
                border-radius: 14px;
                padding: 0.8rem 0.95rem;
                font-size: 0.87rem;
            }

            .admin-install-log-card {
                flex: 1 1 auto;
                min-height: 0;
                background: #0b0b0f;
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 18px;
                overflow: hidden;
                box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
                display: flex;
                flex-direction: column;
            }

            .admin-install-log-header {
                background: rgba(18, 18, 22, 0.98);
                border-bottom: 1px solid rgba(255, 255, 255, 0.08);
                padding: 0.8rem 1rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 0.75rem;
            }

            .admin-install-log-title {
                font-size: 0.78rem;
                font-weight: 700;
                color: #cbd5e1;
                text-transform: uppercase;
                letter-spacing: 0.08em;
            }

            .admin-install-log-subtitle {
                font-size: 0.76rem;
                color: rgba(255, 255, 255, 0.46);
            }

            .admin-install-log {
                flex: 1 1 auto;
                min-height: 320px;
                padding: 1rem 1.1rem;
                overflow: auto;
                font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
                font-size: 0.8rem;
                line-height: 1.5;
                color: #dbe4f0;
                white-space: pre-wrap;
                word-break: break-word;
                background:
                    linear-gradient(180deg, rgba(12, 14, 19, 0.98), rgba(8, 10, 14, 1)),
                    radial-gradient(circle at top left, rgba(59, 130, 246, 0.08), transparent 40%);
            }

            .terminal-container {
                background: var(--bg-darker);
                border-radius: 12px;
                border: 1px solid var(--border-color);
                display: flex;
                flex-direction: column;
                height: 100%;
                overflow: hidden;
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
            }

            .console-grid {
                display: flex;
                gap: 0.8rem;
                height: 100%;
                min-height: 0;
            }

            .console-grid .terminal-container {
                flex: 1 1 auto;
                min-width: 0;
            }

            .player-panel {
                width: 280px;
                background: var(--bg-darker);
                border: 1px solid var(--border-color);
                border-radius: 12px;
                display: flex;
                flex-direction: column;
                overflow: hidden;
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
            }

            .player-panel-header {
                background: var(--bg-sidebar);
                padding: 0.75rem 1rem;
                border-bottom: 1px solid var(--border-color);
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 0.5rem;
            }

            .player-panel-title {
                font-size: 0.85rem;
                font-weight: 600;
                color: var(--text-secondary);
                text-transform: uppercase;
                letter-spacing: 0.04em;
            }

            .player-panel-body {
                padding: 0.75rem 0.75rem 0.5rem;
                overflow: auto;
                flex: 1 1 auto;
            }

            .player-card {
                border: 1px solid #2d2d35;
                background: rgba(15, 15, 18, 0.8);
                border-radius: 10px;
                padding: 0.6rem 0.75rem;
            }

            .player-card + .player-card {
                margin-top: 0.6rem;
            }

            .player-card .player-name {
                font-weight: 600;
                font-size: 0.9rem;
            }

            .player-card img {
                width: 34px;
                height: 34px;
                border-radius: 8px;
                border: 1px solid #2f2f39;
                object-fit: cover;
                background: #0f1115;
            }

            .player-actions {
                display: flex;
                flex-wrap: wrap;
                gap: 0.4rem;
                margin-top: 0.45rem;
            }

            .player-panel-footer {
                border-top: 1px solid var(--border-color);
                background: var(--bg-sidebar);
                padding: 0.6rem 0.75rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
                font-size: 0.8rem;
                color: var(--text-secondary);
            }

            .console-side-rail {
                width: 320px;
                display: flex;
                flex-direction: column;
                gap: 0.8rem;
                min-height: 0;
            }

            .console-side-rail.d-none {
                display: none !important;
            }

            .console-side-panel {
                background: var(--bg-darker);
                border: 1px solid var(--border-color);
                border-radius: 12px;
                display: flex;
                flex-direction: column;
                min-height: 0;
                overflow: hidden;
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
            }

            .console-side-panel.d-none {
                display: none !important;
            }

            .console-side-panel-header {
                background: var(--bg-sidebar);
                padding: 0.75rem 0.9rem;
                border-bottom: 1px solid var(--border-color);
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 0.5rem;
            }

            .console-side-panel-title {
                font-size: 0.82rem;
                font-weight: 700;
                color: var(--text-secondary);
                text-transform: uppercase;
                letter-spacing: 0.04em;
            }

            .console-tree-toolbar {
                display: flex;
                align-items: center;
                gap: 0.35rem;
            }

            .console-tree-subhead {
                padding: 0.55rem 0.8rem;
                border-bottom: 1px solid rgba(255, 255, 255, 0.05);
                background: rgba(12, 14, 19, 0.96);
                font-size: 0.74rem;
                color: var(--text-secondary);
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 0.5rem;
            }

            .console-tree-path {
                display: inline-flex;
                align-items: center;
                max-width: 100%;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
            }

            .console-tree-dropzone {
                margin: 0.7rem 0.8rem 0;
                padding: 0.7rem 0.8rem;
                border: 1px dashed rgba(59, 130, 246, 0.24);
                border-radius: 10px;
                color: var(--text-secondary);
                font-size: 0.8rem;
                text-align: center;
                background: rgba(17, 24, 39, 0.45);
                transition: border-color 0.18s ease, background 0.18s ease, color 0.18s ease;
            }

            .console-tree-dropzone.is-dragover {
                border-color: rgba(59, 130, 246, 0.62);
                background: rgba(30, 64, 175, 0.18);
                color: #dbeafe;
            }

            .console-tree-body {
                flex: 1 1 auto;
                min-height: 0;
                overflow: auto;
                padding: 0.75rem 0.6rem 0.75rem 0.75rem;
            }

            .console-tree-list {
                display: flex;
                flex-direction: column;
                gap: 0.18rem;
            }

            .console-tree-row {
                display: flex;
                align-items: center;
                gap: 0.45rem;
                width: 100%;
                padding: 0.42rem 0.55rem;
                border-radius: 9px;
                background: transparent;
                border: 1px solid transparent;
                color: var(--text-primary);
                font-size: 0.82rem;
                text-align: left;
            }

            .console-tree-row:hover {
                background: rgba(59, 130, 246, 0.08);
                border-color: rgba(59, 130, 246, 0.12);
            }

            .console-tree-row.is-active {
                background: rgba(59, 130, 246, 0.14);
                border-color: rgba(59, 130, 246, 0.2);
                color: #dbeafe;
            }

            .console-tree-row.is-folder {
                color: #d1d5db;
            }

            .console-tree-row.is-file {
                color: #e5e7eb;
            }

            .console-tree-row.is-disabled {
                opacity: 0.58;
            }

            .console-tree-indent {
                width: var(--tree-indent, 0px);
                flex: 0 0 var(--tree-indent, 0px);
            }

            .console-tree-name {
                min-width: 0;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                flex: 1 1 auto;
            }

            .console-tree-empty {
                color: var(--text-secondary);
                font-size: 0.82rem;
                padding: 0.35rem 0.5rem;
            }

            .console-tree-footer {
                padding: 0.6rem 0.8rem;
                border-top: 1px solid rgba(255, 255, 255, 0.05);
                background: var(--bg-sidebar);
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 0.5rem;
                font-size: 0.76rem;
                color: var(--text-secondary);
            }

            .console-file-editor-modal .modal-dialog {
                max-width: min(980px, calc(100vw - 2rem));
            }

            .console-file-editor-modal .modal-content {
                background: #0e1117;
                color: #e5e7eb;
                border: 1px solid rgba(255, 255, 255, 0.08);
            }

            .console-file-editor-meta {
                font-size: 0.78rem;
                color: var(--text-secondary);
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 0.75rem;
                flex-wrap: wrap;
            }

            #consoleAceEditor {
                width: 100%;
                height: min(56vh, 620px);
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 12px;
                overflow: hidden;
            }

            .terminal-header {
                background: var(--bg-sidebar);
                padding: 0.6rem 1.1rem;
                border-bottom: 1px solid var(--border-color);
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-shrink: 0;
                gap: 0.75rem;
            }

            .console-info {
                border-bottom: 1px solid var(--border-color);
                background: rgba(15, 15, 18, 0.92);
                padding: 0.45rem 1.1rem;
                display: flex;
                flex-wrap: wrap;
                gap: 0.75rem 1.5rem;
                font-size: 0.8rem;
                color: var(--text-secondary);
            }

            .console-info .info-label {
                text-transform: uppercase;
                letter-spacing: 0.08em;
                font-size: 0.65rem;
                color: rgba(255, 255, 255, 0.4);
                margin-right: 0.35rem;
            }

            .console-info .info-pill {
                display: inline-flex;
                align-items: center;
                gap: 0.35rem;
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 999px;
                padding: 0.25rem 0.6rem;
            }

            .provisioning-panel {
                border-bottom: 1px solid var(--border-color);
                background: linear-gradient(135deg, rgba(59, 130, 246, 0.12), rgba(15, 23, 42, 0.92));
                padding: 0.85rem 1.1rem 0.95rem;
                display: flex;
                flex-direction: column;
                gap: 0.8rem;
            }

            .provisioning-panel.d-none {
                display: none !important;
            }

            .provisioning-top {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                gap: 1rem;
                flex-wrap: wrap;
            }

            .provisioning-title {
                font-size: 0.95rem;
                font-weight: 700;
                color: #f8fafc;
                margin-bottom: 0.15rem;
            }

            .provisioning-summary {
                font-size: 0.82rem;
                color: rgba(255, 255, 255, 0.72);
                line-height: 1.45;
            }

            .provisioning-badge {
                display: inline-flex;
                align-items: center;
                gap: 0.35rem;
                padding: 0.3rem 0.7rem;
                border-radius: 999px;
                font-size: 0.72rem;
                font-weight: 700;
                letter-spacing: 0.04em;
                white-space: nowrap;
                border: 1px solid rgba(255, 255, 255, 0.12);
                background: rgba(15, 23, 42, 0.45);
                color: #e2e8f0;
            }

            .provisioning-stages {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
                gap: 0.6rem;
            }

            .provisioning-stage {
                border: 1px solid rgba(255, 255, 255, 0.08);
                background: rgba(15, 23, 42, 0.4);
                border-radius: 0.85rem;
                padding: 0.65rem 0.75rem;
                min-width: 0;
            }

            .provisioning-stage-label {
                font-size: 0.72rem;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                color: rgba(255, 255, 255, 0.48);
                margin-bottom: 0.3rem;
            }

            .provisioning-stage-value {
                font-size: 0.84rem;
                font-weight: 700;
                color: #cbd5e1;
            }

            .provisioning-stage-note {
                margin-top: 0.2rem;
                font-size: 0.76rem;
                color: rgba(255, 255, 255, 0.62);
                line-height: 1.4;
                overflow-wrap: anywhere;
            }

            .provisioning-stage.is-active {
                border-color: rgba(96, 165, 250, 0.38);
                background: rgba(59, 130, 246, 0.16);
            }

            .provisioning-stage.is-active .provisioning-stage-value {
                color: #bfdbfe;
            }

            .provisioning-stage.is-done {
                border-color: rgba(16, 185, 129, 0.28);
                background: rgba(16, 185, 129, 0.12);
            }

            .provisioning-stage.is-done .provisioning-stage-value {
                color: #86efac;
            }

            .provisioning-stage.is-fail {
                border-color: rgba(239, 68, 68, 0.28);
                background: rgba(239, 68, 68, 0.12);
            }

            .provisioning-stage.is-fail .provisioning-stage-value {
                color: #fca5a5;
            }

            .provisioning-admin-log {
                background: rgba(10, 10, 14, 0.8);
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 0.85rem;
                padding: 0.75rem 0.85rem;
                max-height: 180px;
                overflow: auto;
                font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
                font-size: 0.76rem;
                color: #cbd5e1;
                white-space: pre-wrap;
                word-break: break-word;
            }

            .terminal-title {
                font-size: 0.85rem;
                font-weight: 600;
                color: var(--text-secondary);
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            .terminal-controls {
                display: flex;
                gap: 0.5rem;
                align-items: center;
                flex-wrap: wrap;
            }

            .console-state-cluster,
            .console-power-cluster {
                display: inline-flex;
                align-items: center;
                gap: 0.45rem;
                padding: 0.28rem 0.35rem;
                border-radius: 999px;
                border: 1px solid rgba(255, 255, 255, 0.08);
                background: rgba(255, 255, 255, 0.04);
            }

            .console-power-cluster .btn,
            .console-state-cluster .btn,
            .console-state-cluster .badge {
                border-radius: 999px;
            }

            #terminal {
                flex: 1;
                padding: 0.5rem;
                min-height: 0;
                background: #0d0d10;
            }

            .terminal-footer {
                background: var(--bg-sidebar);
                padding: 0.6rem 1.1rem;
                border-top: 1px solid var(--border-color);
                flex-shrink: 0;
            }

            .terminal-searchbar {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                flex-wrap: wrap;
                padding: 0.55rem 1.1rem;
                border-bottom: 1px solid var(--border-color);
                background: rgba(10, 14, 20, 0.92);
            }

            .terminal-searchbar.d-none {
                display: none !important;
            }

            .terminal-searchbar .form-control {
                max-width: 320px;
                min-width: 0;
            }

            .terminal-search-hint {
                color: var(--text-secondary);
                font-size: 0.78rem;
            }

            .terminal-search-count {
                color: #bfdbfe;
                font-size: 0.78rem;
                font-weight: 600;
            }

            .follow-active {
                border-color: rgba(16, 185, 129, 0.45) !important;
                background: rgba(16, 185, 129, 0.12) !important;
                color: #86efac !important;
            }

            .terminal-shell {
                position: relative;
                flex: 1 1 auto;
                min-height: 0;
                display: flex;
                flex-direction: column;
            }

            .terminal-jump {
                position: absolute;
                right: 1rem;
                bottom: 1rem;
                z-index: 7;
                display: inline-flex;
                align-items: center;
                gap: 0.45rem;
                border-radius: 999px;
                padding: 0.45rem 0.8rem;
                border: 1px solid rgba(59, 130, 246, 0.35);
                background: rgba(13, 17, 23, 0.92);
                color: #bfdbfe;
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
            }

            .terminal-jump .badge {
                margin-left: 0.1rem;
            }

            .terminal-context-menu {
                position: fixed;
                z-index: 12000;
                min-width: 180px;
                padding: 0.45rem;
                border-radius: 14px;
                border: 1px solid rgba(255, 255, 255, 0.08);
                background: rgba(10, 14, 20, 0.96);
                box-shadow: 0 18px 42px rgba(0, 0, 0, 0.4);
                backdrop-filter: blur(10px);
            }

            .terminal-context-menu.d-none {
                display: none !important;
            }

            .terminal-context-item {
                width: 100%;
                display: flex;
                align-items: center;
                gap: 0.55rem;
                background: transparent;
                border: none;
                color: var(--text-primary);
                padding: 0.6rem 0.7rem;
                border-radius: 10px;
                text-align: left;
                font-size: 0.88rem;
            }

            .terminal-context-item:hover {
                background: rgba(59, 130, 246, 0.12);
                color: #dbeafe;
            }

            .input-group-text {
                background: var(--bg-darker);
                border-color: var(--border-color);
                color: var(--text-secondary);
            }

            .form-control {
                background: var(--bg-darker);
                border-color: var(--border-color);
                color: var(--text-primary);
            }

            .form-control:focus {
                background: #1a1a20;
                border-color: var(--accent-blue);
                color: var(--text-primary);
                box-shadow: 0 0 0 0.25rem rgba(59, 130, 246, 0.15);
            }

            /* Connection Toast */
            .connection-toast {
                position: fixed;
                bottom: 2rem;
                right: 2rem;
                z-index: 9999;
                background: #1a1a20;
                border: 1px solid rgba(239, 68, 68, 0.3);
                border-left: 4px solid #ef4444;
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
                border-radius: 8px;
                padding: 1rem 1.25rem;
                min-width: 320px;
                max-width: 400px;
                display: flex;
                align-items: flex-start;
                gap: 12px;
                animation: slideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            }

            .connection-toast.d-none {
                display: none !important;
            }

            @keyframes slideIn {
                from {
                    opacity: 0;
                    transform: translateY(20px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .toast-icon {
                font-size: 1.5rem;
                color: #ef4444;
                line-height: 1;
            }

            .toast-content h5 {
                margin: 0 0 4px 0;
                font-size: 0.95rem;
                font-weight: 600;
                color: #e1e1e6;
            }

            .toast-content p {
                margin: 0;
                font-size: 0.85rem;
                color: #a1a1aa;
                line-height: 1.4;
            }

            /* Responsive */
            @media (max-width: 768px) {
                .sidebar {
                    margin-left: -260px;
                    position: fixed;
                    top: 0;
                    bottom: 0;
                    z-index: 1050;
                    box-shadow: 0 0 20px rgba(0, 0, 0, 0.5);
                }

                .sidebar.show {
                    margin-left: 0;
                }

                .content {
                    width: 100%;
                }

                .terminal-wrapper {
                    padding: 1rem;
                }

                .top-navbar-right {
                    margin-left: 0;
                    width: 100%;
                    justify-content: flex-start;
                }

                .terminal-header {
                    flex-direction: column;
                    align-items: flex-start;
                }

                .terminal-controls {
                    width: 100%;
                    gap: 0.5rem;
                }

                #powerActions {
                    width: 100%;
                    display: grid;
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                    gap: 0.5rem;
                }

                #btnPopout {
                    grid-column: 1 / -1;
                }

                #consoleTools {
                    width: 100%;
                    display: flex;
                    flex-wrap: wrap;
                    gap: 0.5rem;
                }

                #consoleTools .btn {
                    flex: 1 1 calc(33.333% - 0.5rem);
                }

                .connection-toast {
                    left: 1rem;
                    right: 1rem;
                    min-width: auto;
                }

                .console-grid {
                    flex-direction: column;
                }

                .console-side-rail,
                .player-panel {
                    width: 100%;
                }

                .admin-install-header {
                    flex-direction: column;
                    align-items: flex-start;
                }
            }

            @media (max-width: 520px) {
                #powerActions {
                    grid-template-columns: 1fr;
                }

                #consoleTools .btn {
                    flex: 1 1 100%;
                }
            }

            /* Small adjustments */
            .btn-sm {
                padding: 0.25rem 0.75rem;
                font-size: 0.85rem;
            }

            #wsStatusBadge {
                margin-left: auto;
                margin-right: 0.5rem;
            }
        </style>
    <link rel="stylesheet" href="/css/mobile-layout.css">
</head>

<body data-turbo="false"> <%- include ('../partials/error-modal') %>
<%
const consoleShortcuts = [
    { action: 'Focus command input', keys: 'Ctrl + K' },
    { action: 'Send command', keys: 'Ctrl + Enter' },
    { action: 'Clear console output', keys: 'Ctrl + L' },
    { action: 'Search console', keys: 'Ctrl + F' },
    { action: 'Browse command history', keys: 'Arrow Up / Arrow Down' },
    { action: 'Restart server', keys: 'Ctrl + Shift + R' },
    { action: 'Start/Stop server', keys: 'Ctrl + Shift + S' }
];
const isRestrictedProvisioningViewer = !(user && user.isAdmin) && ['installing', 'starting'].includes(String(server.status || '').toLowerCase());
%>
        <div class="wrapper">
            <!-- Sidebar -->
            <nav id="sidebar" class="sidebar">
                <div class="sidebar-content">
                    <%- include('../partials/server-sidebar', { server, active: 'console' , settings }) %>
                </div>
            </nav>

            <!-- Main Content -->
            <div class="content">
                <!-- Top Navbar -->
                <div class="top-navbar">
                    <button id="sidebarToggle" class="navbar-toggle">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="server-info">
                        <h1 class="server-name">
                            <%= server.name %>
                        </h1>
                    </div>
                    <div class="top-navbar-right">
                        <% if (Number(server.ownerId) === Number(user && user.id)) { %>
                            <a href="/user/server/<%= server.containerId %>/edit" class="btn btn-outline-light btn-sm">
                                <i class="bi bi-pencil-square me-1"></i>Edit Details
                            </a>
                        <% } %>
                        <% if (user && user.isAdmin) { %>
                            <a href="/admin/servers/<%= server.containerId %>/manage" class="btn btn-outline-info btn-sm">
                                <i class="bi bi-gear me-1"></i>Admin Manage
                            </a>
                        <% } %>
                    </div>
                </div>

                <!-- Terminal Wrapper -->
                <div class="terminal-wrapper <%= isRestrictedProvisioningViewer ? 'provisioning-focused' : '' %>" id="terminalWrapper">
                    <!-- Connection Toast (moved inside but absolute positioned) -->
                    <div id="connectionAlert" class="connection-toast d-none">
                        <div class="toast-icon">
                            <i class="bi bi-wifi-off"></i>
                        </div>
                        <div class="toast-content">
                            <h5>Connection Lost</h5>
                            <p>The server node is currently unreachable. Controls are disabled until connection is
                                restored.
                            </p>
                        </div>
                    </div>

                    <div id="provisioningScreen" class="provisioning-screen <%= isRestrictedProvisioningViewer ? '' : 'd-none' %>">
                        <div class="provisioning-screen-card">
                            <img src="/assets/welcoming-rocky.png" alt="Provisioning" class="provisioning-screen-image">
                            <h2 class="provisioning-screen-title" id="provisioningScreenTitle"><%= String(server.status || '').toLowerCase() === 'starting' ? 'Starting Server' : 'Running Installer' %></h2>
                            <p class="provisioning-screen-message" id="provisioningScreenMessage">
                                <%= String(server.status || '').toLowerCase() === 'starting'
                                    ? 'Your server is starting for the first time. Most actions stay locked until the runtime container is ready.'
                                    : 'Your server is being created and configured. This usually finishes in under a minute.' %>
                            </p>
                            <div class="provisioning-screen-status">
                                <i class="bi bi-hourglass-split"></i>
                                <span id="provisioningScreenStatus"><%= String(server.status || 'installing').toUpperCase() %></span>
                            </div>
                            <div class="provisioning-screen-note">You can keep this page open. It will switch to the live console automatically when provisioning finishes.</div>
                        </div>
                    </div>

                    <div id="adminInstallScreen" class="admin-install-screen <%= user && user.isAdmin && ['installing', 'starting'].includes(String(server.status || '').toLowerCase()) ? '' : 'd-none' %>">
                        <div class="admin-install-header">
                            <div>
                                <h2 class="admin-install-title" id="adminInstallTitle"><%= String(server.status || '').toLowerCase() === 'starting' ? 'Starting Runtime Container' : 'Running Installer' %></h2>
                                <p class="admin-install-message" id="adminInstallMessage">Complete install output from the runtime builder is shown below.</p>
                            </div>
                            <div class="admin-install-badge">
                                <i class="bi bi-hdd-stack"></i>
                                <span id="adminInstallStatus"><%= String(server.status || 'installing').toUpperCase() %></span>
                            </div>
                        </div>
                        <div class="admin-install-alert">
                            This server is currently running its installation process and most actions are unavailable until provisioning finishes.
                        </div>
                        <div class="admin-install-log-card">
                            <div class="admin-install-log-header">
                                <div class="admin-install-log-title">Installer Output</div>
                                <div class="admin-install-log-subtitle">Docker/runtime logs stream</div>
                            </div>
                            <div id="adminInstallLog" class="admin-install-log">Waiting for install output...</div>
                        </div>
                    </div>

                    <% if (success) { %>
                        <div class="alert alert-success py-2 mb-3"><%= success %></div>
                    <% } %>
                    <% if (error) { %>
                        <div class="alert alert-danger py-2 mb-3"><%= error %></div>
                    <% } %>

                    <div id="consoleGrid" class="console-grid <%= (isRestrictedProvisioningViewer || (user && user.isAdmin && ['installing', 'starting'].includes(String(server.status || '').toLowerCase()))) ? 'd-none' : '' %>">
                        <!-- Terminal Container -->
                        <div class="terminal-container">
                        <div class="terminal-header">
                            <div class="d-flex align-items-center">
                                <span class="terminal-title">
                                    <i class="bi bi-terminal"></i> [<%= server.name %>] Console
                                </span>
                                <span id="statusBadge" class="status-badge status-<%= server.status %>" style="margin-left: 0.75rem;">
                                    <span class="status-dot"></span>
                                    <span id="statusText">
                                        <%= server.status.toUpperCase() %>
                                    </span>
                                </span>
                                <button id="toggleConsoleInfo" class="btn btn-outline-secondary btn-sm ms-2" type="button">
                                    <i class="bi bi-info-circle"></i>
                                </button>
                            </div>
                            <div class="terminal-controls">
                                <div class="console-state-cluster">
                                    <span id="wsStatusBadge" class="badge bg-secondary" title="Panel status">
                                        <i class="bi bi-arrow-repeat"></i> Connecting...
                                    </span>
                                    <div id="consoleTools" class="d-flex gap-2">
                                    <button id="btnFontMinus" class="btn btn-outline-secondary btn-sm" title="Font size -">
                                        <i class="bi bi-dash-lg"></i>
                                    </button>
                                    <button id="btnFontPlus" class="btn btn-outline-secondary btn-sm" title="Font size +">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                    <button id="btnClear" class="btn btn-outline-secondary btn-sm" title="Clear console">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                    <button id="btnSearch" class="btn btn-outline-secondary btn-sm" title="Search console">
                                        <i class="bi bi-search"></i>
                                    </button>
                                    <button id="btnFollow" class="btn btn-outline-secondary btn-sm" title="Follow output">
                                        <i class="bi bi-arrow-down-circle"></i>
                                    </button>
                                    <% if (canUseConsoleFiles) { %>
                                        <button id="btnToggleConsoleFiles" class="btn btn-outline-secondary btn-sm" title="Toggle mini file tree">
                                            <i class="bi bi-folder2-open"></i>
                                        </button>
                                    <% } %>
                                    <% if (isMinecraftServer && canViewMinecraft) { %>
                                        <button id="btnTogglePlayerPanel" class="btn btn-outline-secondary btn-sm" title="Toggle online players">
                                            <i class="bi bi-people"></i>
                                        </button>
                                    <% } %>
                                    <button class="btn btn-outline-secondary btn-sm" title="Keyboard shortcuts" data-shortcuts-modal="consoleShortcutsModal">
                                        <i class="bi bi-keyboard"></i>
                                    </button>
                                    <button id="btnAiChat" class="btn btn-outline-info btn-sm"
                                        title="<%= aiChat && aiChat.enabled ? 'Open Rocky AI' : (aiChat && aiChat.disabledReason ? aiChat.disabledReason : 'AI unavailable') %>"
                                        data-bs-toggle="modal" data-bs-target="#rockyAiModal"
                                        <%= aiChat && aiChat.enabled ? '' : 'disabled' %>>
                                        <i class="bi bi-robot"></i>
                                    </button>
                                </div>
                                </div>
                                <div id="powerActions" class="console-power-cluster">
                                    <button id="btnPopout" class="btn btn-outline-secondary btn-sm"
                                        data-server-id="<%= server.containerId %>">
                                        <i class="bi bi-box-arrow-up-right"></i> Popout
                                    </button>
                                    <button id="btnStart" class="btn btn-success btn-sm">
                                        <i class="bi bi-play-fill"></i> Start
                                    </button>
                                    <button id="btnRestart" class="btn btn-warning btn-sm">
                                        <i class="bi bi-arrow-clockwise"></i> Restart
                                    </button>
                                    <button id="btnStop"
                                        class="btn btn-danger btn-sm <%= server.status === 'stopping' ? 'd-none' : '' %>">
                                        <i class="bi bi-stop-fill"></i> Stop
                                    </button>
                                    <button id="btnKill"
                                        class="btn btn-danger btn-sm <%= server.status === 'stopping' ? '' : 'd-none' %>">
                                        <i class="bi bi-lightning-fill"></i> Kill
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div id="consoleInfoBar" class="console-info d-none">
                            <% if (server.description) { %>
                                <div class="info-pill"><span class="info-label">Description</span><span><%= server.description %></span></div>
                            <% } %>
                            <% if (user && user.isAdmin) { %>
                                <div class="info-pill"><span class="info-label">Owner</span><span>@<%= server.owner && server.owner.username ? server.owner.username : 'unknown' %></span></div>
                            <% } %>
                            <% if (server.allocation && (server.allocation.alias || server.allocation.ip)) { %>
                                <div class="info-pill"><span class="info-label">Address</span><span><%= server.allocation.alias || server.allocation.ip %>:<%= server.allocation.port %></span></div>
                            <% } %>
                        </div>
                        <div id="provisioningPanel" class="provisioning-panel d-none">
                            <div class="provisioning-top">
                                <div>
                                    <div class="provisioning-title" id="provisioningTitle">Creating server</div>
                                    <div class="provisioning-summary" id="provisioningSummary">Preparing runtime environment.</div>
                                </div>
                                <span class="provisioning-badge" id="provisioningBadge">
                                    <i class="bi bi-hourglass-split"></i>
                                    <span id="provisioningBadgeText">Starting</span>
                                </span>
                            </div>
                            <div id="provisioningStages" class="provisioning-stages"></div>
                            <div id="provisioningAdminWrap" class="d-none">
                                <div class="small text-secondary mb-2">Install activity</div>
                                <div id="provisioningAdminLog" class="provisioning-admin-log"></div>
                            </div>
                        </div>
                        <div id="terminalSearchbar" class="terminal-searchbar d-none">
                            <input type="text" id="terminalSearchInput" class="form-control form-control-sm" placeholder="Search console...">
                            <button id="btnSearchPrev" class="btn btn-outline-secondary btn-sm" type="button">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                            <button id="btnSearchNext" class="btn btn-outline-secondary btn-sm" type="button">
                                <i class="bi bi-chevron-down"></i>
                            </button>
                            <button id="btnSearchClose" class="btn btn-outline-secondary btn-sm" type="button">
                                <i class="bi bi-x-lg"></i>
                            </button>
                            <span id="terminalSearchCount" class="terminal-search-count">0 matches</span>
                            <span class="terminal-search-hint">Ctrl+F to search</span>
                        </div>
                        <div class="terminal-shell">
                            <div id="terminal"></div>
                            <button id="btnJumpLatest" class="terminal-jump d-none" type="button">
                                <i class="bi bi-arrow-down-circle"></i>
                                <span>Jump to latest</span>
                                <span id="terminalUnreadCount" class="badge bg-primary">0</span>
                            </button>
                        </div>
                        <div id="terminalContextMenu" class="terminal-context-menu d-none">
                            <button type="button" class="terminal-context-item" data-terminal-action="copy-selection">
                                <i class="bi bi-copy"></i>
                                <span>Copy selection</span>
                            </button>
                            <button type="button" class="terminal-context-item" data-terminal-action="paste-input">
                                <i class="bi bi-clipboard"></i>
                                <span>Paste into command</span>
                            </button>
                            <button type="button" class="terminal-context-item" data-terminal-action="search-console">
                                <i class="bi bi-search"></i>
                                <span>Search console</span>
                            </button>
                            <button type="button" class="terminal-context-item" data-terminal-action="clear-console">
                                <i class="bi bi-trash3"></i>
                                <span>Clear console</span>
                            </button>
                        </div>
                        <div class="terminal-footer">
                            <% if (canUseMacros && Array.isArray(commandMacros) && commandMacros.length > 0) { %>
                                <div class="d-flex flex-wrap gap-2 mb-2">
                                    <select id="macroSelect" class="form-select form-select-sm bg-dark text-light border-secondary" style="max-width: 340px;">
                                        <option value="">Select macro...</option>
                                        <% commandMacros.forEach((macro) => { %>
                                            <option value="<%= macro.id %>"><%= macro.name %><%= macro.description ? ` - ${macro.description}` : '' %></option>
                                        <% }); %>
                                    </select>
                                    <button id="btnRunMacro" class="btn btn-outline-info btn-sm" type="button">
                                        <i class="bi bi-play-fill me-1"></i>Run Macro
                                    </button>
                                    <a href="/server/<%= server.containerId %>/macros" class="btn btn-outline-light btn-sm">
                                        <i class="bi bi-lightning-charge me-1"></i>Manage Macros
                                    </a>
                                </div>
                            <% } %>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="text" id="consoleInput" class="form-control"
                                    placeholder="Type a command...">
                            </div>
                        </div>
                        </div>

                        <% if (canUseConsoleFiles || (isMinecraftServer && canViewMinecraft)) { %>
                            <aside class="console-side-rail d-none" id="consoleSideRail">
                                <% if (canUseConsoleFiles) { %>
                                    <section class="console-side-panel d-none" id="consoleFilesPanel">
                                        <div class="console-side-panel-header">
                                            <div class="console-side-panel-title">Mini File Tree</div>
                                            <div class="console-tree-toolbar">
                                                <button class="btn btn-outline-secondary btn-sm" type="button" id="consoleFilesRefreshBtn" title="Refresh tree">
                                                    <i class="bi bi-arrow-repeat"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="console-tree-subhead">
                                            <span class="console-tree-path" id="consoleFilesPath">/</span>
                                            <span class="small text-secondary" id="consoleFilesModeLabel"><%= canWriteConsoleFiles && !filesWriteLocked ? 'Upload enabled' : 'Read-only' %></span>
                                        </div>
                                        <div class="console-tree-dropzone" id="consoleTreeDropzone">
                                            <i class="bi bi-cloud-arrow-up me-1"></i>Drag and drop files here to upload into the selected folder.
                                        </div>
                                        <div class="console-tree-body">
                                            <div class="console-tree-list" id="consoleFilesTreeList">
                                                <div class="console-tree-empty">Loading file tree...</div>
                                            </div>
                                        </div>
                                        <div class="console-tree-footer">
                                            <span id="consoleFilesFooterLabel">Selected folder: /</span>
                                            <a href="/server/<%= server.containerId %>/files" class="btn btn-outline-light btn-sm">
                                                <i class="bi bi-box-arrow-up-right me-1"></i>Open Files
                                            </a>
                                        </div>
                                    </section>
                                <% } %>

                                <% if (isMinecraftServer && canViewMinecraft) { %>
                                    <aside class="player-panel d-none" id="playerPanel">
                                        <div class="player-panel-header">
                                            <div class="player-panel-title">Online Players</div>
                                            <button class="btn btn-outline-secondary btn-sm" type="button" id="playerPanelRefreshBtn">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </button>
                                        </div>
                                        <div class="player-panel-body" id="playerPanelList">
                                            <div class="text-secondary small">Loading players...</div>
                                        </div>
                                        <div class="player-panel-footer">
                                            <span id="playerPanelCount">0 online</span>
                                            <span class="text-muted">Minecraft</span>
                                        </div>
                                    </aside>
                                <% } %>
                            </aside>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <% if (showMinecraftEulaModal) { %>
            <!-- EULA Modal -->
            <div class="modal fade" id="eulaModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content bg-dark text-white border-secondary">
                        <div class="modal-header border-secondary">
                            <h5 class="modal-title fw-bold">Minecraft EULA Agreement</h5>
                        </div>
                        <div class="modal-body">
                            <p>To run a Minecraft server, you must agree to Minecraft's End User License Agreement.</p>
                            <p class="small text-muted">By clicking "Agree", you explicitly accept the EULA found at <a
                                    href="https://www.minecraft.net/eula" target="_blank"
                                    class="text-info">minecraft.net/eula</a>.</p>
                        </div>
                        <div class="modal-footer border-secondary">
                            <button type="button" id="btnAcceptEula" class="btn btn-primary w-100">I Agree</button>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>

        <% if (canUseConsoleFiles) { %>
            <div class="modal fade console-file-editor-modal" id="consoleFileEditorModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header border-secondary">
                            <div class="w-100">
                                <h5 class="modal-title mb-1">
                                    <i class="bi bi-file-earmark-code me-2"></i>Quick File Editor
                                </h5>
                                <div class="console-file-editor-meta">
                                    <span id="consoleEditorPath">/</span>
                                    <span id="consoleEditorState">Loading…</span>
                                </div>
                            </div>
                            <button type="button" class="btn-close btn-close-white" id="consoleFileEditorCloseBtn" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div id="consoleAceEditor"></div>
                        </div>
                        <div class="modal-footer border-secondary">
                            <button type="button" class="btn btn-outline-light" id="consoleFileEditorDismissBtn">X</button>
                            <button type="button" class="btn btn-primary" id="consoleFileEditorSaveBtn">
                                <i class="bi bi-save me-1"></i>Save
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" data-turbo-eval="false"></script>
        <script src="https://cdn.jsdelivr.net/npm/xterm@5.2.1/lib/xterm.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/xterm-addon-fit@0.7.0/lib/xterm-addon-fit.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/xterm-addon-search@0.13.0/lib/xterm-addon-search.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/xterm-addon-web-links@0.8.0/lib/xterm-addon-web-links.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/xterm-addon-unicode11@0.6.0/lib/xterm-addon-unicode11.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/xterm-addon-webgl@0.16.0/lib/xterm-addon-webgl.js"></script>
        <% if (canUseConsoleFiles) { %>
            <script src="https://cdn.jsdelivr.net/npm/ace-builds@1.32.6/src-min-noconflict/ace.js"></script>
        <% } %>

        <script>
            // Sidebar toggle functionality (for mobile and desktop)
            const sidebar = document.getElementById('sidebar');
            const sidebarToggle = document.getElementById('sidebarToggle');

            sidebarToggle.addEventListener('click', () => {
                sidebar.classList.toggle('show');
                setTimeout(() => {
                    if (typeof fitAddon !== 'undefined') fitAddon.fit();
                }, 300);
            });

            // Close sidebar on outside click for mobile
            document.addEventListener('click', (e) => {
                if (window.innerWidth <= 768) {
                    if (!sidebar.contains(e.target) && !sidebarToggle.contains(e.target)) {
                        sidebar.classList.remove('show');
                    }
                }
            });

            const consoleInfoBar = document.getElementById('consoleInfoBar');
            const toggleConsoleInfo = document.getElementById('toggleConsoleInfo');
            toggleConsoleInfo?.addEventListener('click', () => {
                if (!consoleInfoBar) return;
                consoleInfoBar.classList.toggle('d-none');
            });

            // ================== Existing console functionality (preserved) ==================
            const serverId = '<%= server.id %>';
            const serverContainerId = '<%= server.containerId %>';
            const serverMemory = <%= server.memory || 0 %>;
            const serverDisk = <%= server.disk || 0 %>;
            let currentServerStatus = '<%= String(server.status || "stopped").toLowerCase() %>';
            const consoleReplayStorageKey = `cpanel.console.replay.<%= server.containerId %>`;
            const restrictedProvisioningViewer = <%= isRestrictedProvisioningViewer ? 'true' : 'false' %>;
            const promptBrand = <%- JSON.stringify(String((settings && settings.brandName) ? settings.brandName : 'cpanel').toLowerCase()) %>;
            const isAdminConsoleViewer = <%= user && user.isAdmin ? 'true' : 'false' %>;
            const showMinecraftEulaModal = <%- JSON.stringify(Boolean(showMinecraftEulaModal)) %>;
            const minecraftPanelEnabled = <%- JSON.stringify(Boolean(isMinecraftServer && canViewMinecraft)) %>;
            const minecraftStatusAddress = <%- JSON.stringify(minecraftStatusAddress || '') %>;
            const minecraftBedrockMode = <%- JSON.stringify(Boolean(minecraftBedrockMode)) %>;
            const minecraftActionPerms = {
                canKick: <%= minecraftActionPermissions && minecraftActionPermissions.canKick ? 'true' : 'false' %>,
                canBan: <%= minecraftActionPermissions && minecraftActionPermissions.canBan ? 'true' : 'false' %>,
                canOp: <%= minecraftActionPermissions && minecraftActionPermissions.canOp ? 'true' : 'false' %>,
                canDeop: <%= minecraftActionPermissions && minecraftActionPermissions.canDeop ? 'true' : 'false' %>,
                canTempban: <%= minecraftActionPermissions && minecraftActionPermissions.canTempban ? 'true' : 'false' %>,
                canTeleport: <%= minecraftActionPermissions && minecraftActionPermissions.canTeleport ? 'true' : 'false' %>
            };
            const canUseConsoleFiles = <%= canUseConsoleFiles ? 'true' : 'false' %>;
            const canWriteConsoleFiles = <%= canWriteConsoleFiles ? 'true' : 'false' %>;
            const consoleFilesWriteLocked = <%= filesWriteLocked ? 'true' : 'false' %>;
            const consoleWebUploadEnabled = <%= webUploadEnabled ? 'true' : 'false' %>;
            const consoleWebUploadMaxMb = <%= Number.isFinite(Number(webUploadMaxMb)) ? Number(webUploadMaxMb) : 50 %>;
            const consolePolicyReadOnlyPatterns = <%- JSON.stringify(Array.isArray(policyReadOnlyPatterns) ? policyReadOnlyPatterns : []) %>;
            const eulaModalEl = showMinecraftEulaModal ? document.getElementById('eulaModal') : null;
            const eulaModalInstance = eulaModalEl && window.bootstrap ? bootstrap.Modal.getOrCreateInstance(eulaModalEl) : null;

            let connectorOnline = true;

            const escapeHtml = (value) => String(value || '').replace(/[&<>"']/g, (ch) => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#39;'
            }[ch]));

            const showConsoleStatus = (message) => {
                if (window.showStatusModal) {
                    window.showStatusModal(message, 'info');
                    return;
                }
                console.log(message);
            };

            const dispatchMinecraftAction = (action, player, extra = {}) => {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/server/${serverContainerId}/minecraft/configs`;
                form.setAttribute('data-turbo', 'false');

                const appendInput = (name, value) => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = name;
                    input.value = value;
                    form.appendChild(input);
                };

                appendInput('action', action);
                appendInput('player', player);
                appendInput('bedrock', minecraftBedrockMode ? '1' : '0');
                if (extra.reason) appendInput('reason', extra.reason);
                if (extra.duration) appendInput('duration', extra.duration);
                if (extra.destination) appendInput('destination', extra.destination);

                document.body.appendChild(form);
                form.submit();
            };

            const promptMinecraftAction = (action, player) => {
                if (!player) return;
                const requiresReason = ['kick', 'ban', 'tempban'].includes(action);
                const requiresDuration = action === 'tempban';
                const requiresDestination = action === 'teleport';

                const extra = {};
                if (requiresDestination) {
                    const destination = window.prompt(`Teleport destination for ${player}:`, '');
                    if (destination === null) return;
                    const trimmed = String(destination || '').trim();
                    if (!trimmed) return showConsoleStatus('Destination is required.');
                    extra.destination = trimmed.slice(0, 64);
                }

                if (requiresDuration) {
                    const duration = window.prompt(`Tempban duration for ${player} (e.g. 1h):`, '');
                    if (duration === null) return;
                    const trimmed = String(duration || '').trim();
                    if (!trimmed) return showConsoleStatus('Duration is required.');
                    extra.duration = trimmed.slice(0, 16);
                }

                if (requiresReason) {
                    const reason = window.prompt(`Reason for ${action.toUpperCase()} ${player}:`, '');
                    if (reason === null) return;
                    const trimmed = String(reason || '').trim();
                    if (trimmed.length < 3) return showConsoleStatus('Reason must be at least 3 characters.');
                    extra.reason = trimmed.slice(0, 96);
                }

                dispatchMinecraftAction(action, player, extra);
            };

            const playerPanelList = document.getElementById('playerPanelList');
            const playerPanelCount = document.getElementById('playerPanelCount');
            const playerPanelRefreshBtn = document.getElementById('playerPanelRefreshBtn');

            const renderPlayerPanel = (players = []) => {
                if (!playerPanelList) return;
                if (!Array.isArray(players) || players.length === 0) {
                    playerPanelList.innerHTML = '<div class="text-secondary small">No players online.</div>';
                    if (playerPanelCount) playerPanelCount.textContent = '0 online';
                    return;
                }

                if (playerPanelCount) playerPanelCount.textContent = `${players.length} online`;
                playerPanelList.innerHTML = players.map((entry) => {
                    const name = escapeHtml(entry.name || '');
                    const head = escapeHtml(entry.headUrl || '');
                    return `
                        <div class="player-card">
                            <div class="d-flex align-items-center gap-2">
                                <img src="${head}" alt="Head" onerror="if(!this.dataset.fallback){this.dataset.fallback='1';this.src='https://minotar.net/avatar/Steve/40';}else{this.onerror=null;}">
                                <div class="player-name">${name}</div>
                            </div>
                            <div class="player-actions">
                                <button class="btn btn-outline-success btn-sm" data-action="op" data-player="${name}" ${!minecraftActionPerms.canOp ? 'disabled' : ''}>OP</button>
                                <button class="btn btn-outline-warning btn-sm" data-action="deop" data-player="${name}" ${!minecraftActionPerms.canDeop ? 'disabled' : ''}>DEOP</button>
                                <button class="btn btn-outline-light btn-sm" data-action="kick" data-player="${name}" ${!minecraftActionPerms.canKick ? 'disabled' : ''}>Kick</button>
                                <button class="btn btn-outline-info btn-sm" data-action="teleport" data-player="${name}" ${!minecraftActionPerms.canTeleport ? 'disabled' : ''}>TP</button>
                                <button class="btn btn-outline-danger btn-sm" data-action="ban" data-player="${name}" ${!minecraftActionPerms.canBan ? 'disabled' : ''}>Ban</button>
                                <button class="btn btn-outline-danger btn-sm" data-action="tempban" data-player="${name}" ${!minecraftActionPerms.canTempban ? 'disabled' : ''}>Temp</button>
                            </div>
                        </div>
                    `;
                }).join('');
            };

            const refreshPlayerPanel = async () => {
                if (!minecraftPanelEnabled) return;
                if (!playerPanelList) return;
                playerPanelList.innerHTML = '<div class="text-secondary small">Refreshing players...</div>';
                try {
                    const response = await fetch(`/server/${serverContainerId}/minecraft/configs/status?bedrock=${minecraftBedrockMode ? '1' : '0'}`);
                    const payload = await response.json();
                    if (!response.ok || !payload.success) {
                        throw new Error(payload.error || 'Failed to refresh players.');
                    }
                    const status = payload.status || {};
                    renderPlayerPanel(status.playersList || []);
                } catch (error) {
                    playerPanelList.innerHTML = `<div class="text-secondary small">${escapeHtml(error.message || 'Failed to refresh players.')}</div>`;
                }
            };

            let consoleFilesVisible = false;
            let consolePlayersVisible = false;

            if (minecraftPanelEnabled) {
                if (playerPanelRefreshBtn) {
                    playerPanelRefreshBtn.addEventListener('click', refreshPlayerPanel);
                }
                playerPanelList?.addEventListener('click', (event) => {
                    const target = event.target;
                    if (!target || !target.dataset) return;
                    const action = String(target.dataset.action || '');
                    const player = String(target.dataset.player || '');
                    if (!action || !player) return;
                    promptMinecraftAction(action, player);
                });
                setInterval(() => {
                    if (consolePlayersVisible) {
                        refreshPlayerPanel();
                    }
                }, 30000);
            }

            const consoleSideRail = document.getElementById('consoleSideRail');
            const consoleFilesPanel = document.getElementById('consoleFilesPanel');
            const btnToggleConsoleFiles = document.getElementById('btnToggleConsoleFiles');
            const btnTogglePlayerPanel = document.getElementById('btnTogglePlayerPanel');
            const consoleFilesRefreshBtn = document.getElementById('consoleFilesRefreshBtn');
            const consoleFilesTreeList = document.getElementById('consoleFilesTreeList');
            const consoleFilesPath = document.getElementById('consoleFilesPath');
            const consoleFilesFooterLabel = document.getElementById('consoleFilesFooterLabel');
            const consoleFilesModeLabel = document.getElementById('consoleFilesModeLabel');
            const consoleTreeDropzone = document.getElementById('consoleTreeDropzone');
            const consoleFileEditorModalEl = document.getElementById('consoleFileEditorModal');
            const consoleFileEditorCloseBtn = document.getElementById('consoleFileEditorCloseBtn');
            const consoleFileEditorDismissBtn = document.getElementById('consoleFileEditorDismissBtn');
            const consoleFileEditorSaveBtn = document.getElementById('consoleFileEditorSaveBtn');
            const consoleEditorPath = document.getElementById('consoleEditorPath');
            const consoleEditorState = document.getElementById('consoleEditorState');

            const consoleFilesVisibleStorageKey = `cpanel.console.files.visible.<%= server.containerId %>`;
            const consolePlayersVisibleStorageKey = `cpanel.console.players.visible.<%= server.containerId %>`;
            const consoleFileTreeCache = new Map();
            const consoleFileTreeExpanded = new Set(['/']);
            let consoleTreeSelectedDirectory = '/';
            let consoleEditorPendingReadPath = '';
            let consoleEditorPendingWritePath = '';
            let consoleEditorCurrentPath = '';
            let consoleEditorOriginalContent = '';
            let consoleEditorReadOnly = true;
            let consoleAceEditor = null;
            const consoleEditorModalInstance = consoleFileEditorModalEl && window.bootstrap
                ? bootstrap.Modal.getOrCreateInstance(consoleFileEditorModalEl)
                : null;

            try {
                consoleFilesVisible = canUseConsoleFiles && localStorage.getItem(consoleFilesVisibleStorageKey) === '1';
                consolePlayersVisible = minecraftPanelEnabled && localStorage.getItem(consolePlayersVisibleStorageKey) === '1';
            } catch (error) {
                consoleFilesVisible = false;
                consolePlayersVisible = false;
            }

            function normalizeServerPath(value) {
                const raw = String(value || '/').replace(/\\/g, '/').trim() || '/';
                const pieces = [];
                raw.split('/').forEach((part) => {
                    if (!part || part === '.') return;
                    if (part === '..') {
                        pieces.pop();
                        return;
                    }
                    pieces.push(part);
                });
                return `/${pieces.join('/')}`.replace(/\/+/g, '/').replace(/\/$/, '') || '/';
            }

            function joinServerPath(parentPath, entryName) {
                const base = normalizeServerPath(parentPath);
                return base === '/' ? `/${entryName}` : `${base}/${entryName}`;
            }

            function escapePolicyPatternRegExp(value) {
                return String(value || '').replace(/[|\\{}()[\]^$+?.]/g, '\\$&');
            }

            function compilePolicyPattern(pattern) {
                const normalized = String(pattern || '').trim().replace(/\\/g, '/');
                if (!normalized) return null;
                let regexSource = '';
                for (let index = 0; index < normalized.length; index += 1) {
                    const current = normalized[index];
                    const next = normalized[index + 1];
                    if (current === '*' && next === '*') {
                        regexSource += '.*';
                        index += 1;
                        continue;
                    }
                    if (current === '*') {
                        regexSource += '[^/]*';
                        continue;
                    }
                    regexSource += escapePolicyPatternRegExp(current);
                }
                try {
                    return new RegExp(`^${regexSource}$`, 'i');
                } catch {
                    return null;
                }
            }

            function getConsoleReadOnlyReason(targetPath) {
                const normalizedPath = normalizeServerPath(targetPath || '/');
                if (consoleFilesWriteLocked) {
                    return 'Edits are locked for this server. Only admins can modify files right now.';
                }
                if (!canWriteConsoleFiles) {
                    return 'You do not have permission to edit files on this server.';
                }
                for (const pattern of consolePolicyReadOnlyPatterns) {
                    const matcher = compilePolicyPattern(pattern);
                    if (matcher && matcher.test(normalizedPath)) {
                        return 'This file is read-only by server policy.';
                    }
                }
                return '';
            }

            function sortConsoleTreeEntries(entries) {
                return (Array.isArray(entries) ? [...entries] : []).sort((a, b) => {
                    if (a.isDirectory && !b.isDirectory) return -1;
                    if (!a.isDirectory && b.isDirectory) return 1;
                    return String(a.name || '').localeCompare(String(b.name || ''));
                });
            }

            function canEditConsoleFile(name) {
                const value = String(name || '').trim().toLowerCase();
                if (!value) return false;
                const directNames = new Set([
                    'dockerfile',
                    'docker-compose.yml',
                    'docker-compose.yaml',
                    '.env',
                    'server.properties',
                    'eula.txt',
                    'package.json',
                    'package-lock.json',
                    'pnpm-lock.yaml',
                    'yarn.lock',
                    'requirements.txt',
                    'go.mod',
                    'go.sum',
                    'cargo.toml',
                    'cargo.lock',
                    'makefile',
                    'readme',
                    'readme.md'
                ]);
                if (directNames.has(value)) return true;
                const ext = value.includes('.') ? value.split('.').pop() : '';
                const allowedExts = new Set([
                    'txt', 'log', 'md', 'json', 'json5', 'yaml', 'yml', 'toml', 'ini', 'cfg', 'conf', 'properties',
                    'env', 'js', 'cjs', 'mjs', 'ts', 'jsx', 'tsx', 'sh', 'bash', 'zsh', 'php', 'py', 'rb', 'java',
                    'kt', 'kts', 'go', 'rs', 'c', 'cpp', 'h', 'hpp', 'cs', 'html', 'htm', 'css', 'scss', 'less',
                    'xml', 'svg', 'sql', 'mcmeta', 'gradle', 'lock', 'gitignore', 'gitattributes'
                ]);
                return allowedExts.has(ext);
            }

            function guessConsoleAceMode(filePath) {
                const name = String(filePath || '').toLowerCase();
                if (name.endsWith('.js') || name.endsWith('.cjs') || name.endsWith('.mjs')) return 'javascript';
                if (name.endsWith('.json') || name.endsWith('.json5') || name.endsWith('.mcmeta')) return 'json';
                if (name.endsWith('.html') || name.endsWith('.htm')) return 'html';
                if (name.endsWith('.css') || name.endsWith('.scss') || name.endsWith('.less')) return 'css';
                if (name.endsWith('.yaml') || name.endsWith('.yml')) return 'yaml';
                if (name.endsWith('.xml') || name.endsWith('.svg')) return 'xml';
                if (name.endsWith('.md')) return 'markdown';
                if (name.endsWith('.sh') || name.endsWith('.bash') || name.endsWith('.zsh') || name === '/dockerfile') return 'sh';
                if (name.endsWith('.py')) return 'python';
                if (name.endsWith('.php')) return 'php';
                if (name.endsWith('.sql')) return 'sql';
                if (name.endsWith('.java')) return 'java';
                return 'text';
            }

            function persistConsolePanelState() {
                try {
                    localStorage.setItem(consoleFilesVisibleStorageKey, consoleFilesVisible ? '1' : '0');
                    localStorage.setItem(consolePlayersVisibleStorageKey, consolePlayersVisible ? '1' : '0');
                } catch (error) {
                    console.warn('Failed to persist console panel state.', error);
                }
            }

            function syncConsoleSideRailVisibility() {
                const anyVisible = (canUseConsoleFiles && consoleFilesVisible) || (minecraftPanelEnabled && consolePlayersVisible);
                consoleSideRail?.classList.toggle('d-none', !anyVisible);
                consoleFilesPanel?.classList.toggle('d-none', !(canUseConsoleFiles && consoleFilesVisible));
                document.getElementById('playerPanel')?.classList.toggle('d-none', !(minecraftPanelEnabled && consolePlayersVisible));
                btnToggleConsoleFiles?.classList.toggle('follow-active', consoleFilesVisible);
                btnTogglePlayerPanel?.classList.toggle('follow-active', consolePlayersVisible);
                persistConsolePanelState();
            }

            async function fetchConsoleTreeEntries(directory, force = false) {
                const normalized = normalizeServerPath(directory);
                if (!force && consoleFileTreeCache.has(normalized)) {
                    return consoleFileTreeCache.get(normalized);
                }
                const response = await fetch(`/server/${serverContainerId}/files-fetch?path=${encodeURIComponent(normalized)}`);
                if (!response.ok) {
                    const payload = await response.json().catch(() => ({}));
                    throw new Error(payload.error || `Failed to load ${normalized}`);
                }
                const payload = await response.json();
                const files = sortConsoleTreeEntries(Array.isArray(payload.files) ? payload.files : []);
                consoleFileTreeCache.set(normalized, files);
                return files;
            }

            async function ensureConsoleTreeContext(targetPath) {
                const normalized = normalizeServerPath(targetPath || '/');
                const parts = normalized.split('/').filter(Boolean);
                let current = '/';
                consoleFileTreeExpanded.add('/');
                await fetchConsoleTreeEntries('/', false);
                for (const part of parts) {
                    const next = current === '/' ? `/${part}` : `${current}/${part}`;
                    consoleFileTreeExpanded.add(current);
                    await fetchConsoleTreeEntries(current, false);
                    current = next;
                }
            }

            function renderConsoleTreeBranch(directory, depth = 0) {
                const entries = consoleFileTreeCache.get(directory) || [];
                if (!entries.length && depth > 0) {
                    return '';
                }
                return entries.map((entry) => {
                    const name = String(entry && entry.name || '').trim();
                    if (!name) return '';
                    const fullPath = normalizeServerPath(joinServerPath(directory, name));
                    const isDirectory = Boolean(entry && entry.isDirectory);
                    const expanded = isDirectory && consoleFileTreeExpanded.has(fullPath);
                    const isActiveDir = isDirectory && normalizeServerPath(consoleTreeSelectedDirectory) === fullPath;
                    const editable = !isDirectory && canEditConsoleFile(name);
                    const disabled = !isDirectory && !editable;
                    const childMarkup = isDirectory && expanded ? renderConsoleTreeBranch(fullPath, depth + 1) : '';
                    return `
                        <div class="console-tree-entry">
                            <button type="button"
                                class="console-tree-row ${isDirectory ? 'is-folder' : 'is-file'} ${isActiveDir ? 'is-active' : ''} ${disabled ? 'is-disabled' : ''}"
                                data-tree-path="${escapeHtml(fullPath)}"
                                data-tree-dir="${isDirectory ? '1' : '0'}"
                                style="--tree-indent:${depth * 14}px">
                                <span class="console-tree-indent" aria-hidden="true"></span>
                                <i class="bi ${isDirectory ? (expanded ? 'bi-folder2-open' : 'bi-folder2') : (editable ? 'bi-file-earmark-code' : 'bi-file-earmark-lock')}"></i>
                                <span class="console-tree-name">${escapeHtml(name)}</span>
                            </button>
                            ${childMarkup}
                        </div>
                    `;
                }).join('');
            }

            function renderConsoleTree() {
                if (!consoleFilesTreeList) return;
                const rootEntries = consoleFileTreeCache.get('/') || [];
                if (!rootEntries.length) {
                    consoleFilesTreeList.innerHTML = '<div class="console-tree-empty">No files available or connector did not return a directory listing yet.</div>';
                } else {
                    consoleFilesTreeList.innerHTML = renderConsoleTreeBranch('/', 0);
                }
                if (consoleFilesPath) consoleFilesPath.textContent = normalizeServerPath(consoleTreeSelectedDirectory);
                if (consoleFilesFooterLabel) consoleFilesFooterLabel.textContent = `Selected folder: ${normalizeServerPath(consoleTreeSelectedDirectory)}`;
                if (consoleFilesModeLabel) {
                    consoleFilesModeLabel.textContent = canWriteConsoleFiles && !consoleFilesWriteLocked
                        ? `Upload max ${consoleWebUploadMaxMb} MB`
                        : 'Read-only';
                }
            }

            async function refreshConsoleTree(targetDirectory = consoleTreeSelectedDirectory, force = true) {
                if (!canUseConsoleFiles) return;
                const normalized = normalizeServerPath(targetDirectory || '/');
                await ensureConsoleTreeContext(normalized);
                const directories = new Set(['/']);
                const parts = normalized.split('/').filter(Boolean);
                let walker = '/';
                for (const part of parts) {
                    directories.add(walker);
                    walker = walker === '/' ? `/${part}` : `${walker}/${part}`;
                }
                directories.add(normalized);
                for (const dir of directories) {
                    await fetchConsoleTreeEntries(dir, force && dir === normalized);
                }
                consoleTreeSelectedDirectory = normalized;
                renderConsoleTree();
            }

            async function ensureConsoleAceEditor() {
                if (consoleAceEditor) return consoleAceEditor;
                if (typeof ace === 'undefined') {
                    throw new Error('Ace editor failed to load.');
                }
                consoleAceEditor = ace.edit('consoleAceEditor');
                consoleAceEditor.setTheme('ace/theme/monokai');
                consoleAceEditor.session.setUseWrapMode(true);
                consoleAceEditor.setShowPrintMargin(false);
                return consoleAceEditor;
            }

            function setConsoleEditorState(message, isReadOnly = consoleEditorReadOnly) {
                if (consoleEditorState) {
                    consoleEditorState.textContent = message;
                }
                if (consoleFileEditorSaveBtn) {
                    consoleFileEditorSaveBtn.disabled = isReadOnly;
                }
            }

            async function openConsoleEditor(filePath) {
                const normalized = normalizeServerPath(filePath);
                const fileName = normalized.split('/').pop() || normalized;
                if (!canEditConsoleFile(fileName)) {
                    showConsoleStatus('This file type is not editable from the console mini editor.');
                    return;
                }
                const directory = normalizeServerPath(normalized.slice(0, Math.max(1, normalized.lastIndexOf('/'))) || '/');
                consoleTreeSelectedDirectory = directory;
                renderConsoleTree();
                consoleEditorPendingReadPath = normalized;
                consoleEditorCurrentPath = normalized;
                consoleEditorOriginalContent = '';
                consoleEditorReadOnly = Boolean(getConsoleReadOnlyReason(normalized));
                if (consoleEditorPath) consoleEditorPath.textContent = normalized;
                setConsoleEditorState(consoleEditorReadOnly ? getConsoleReadOnlyReason(normalized) : 'Loading file...', true);
                consoleEditorModalInstance?.show();
                const editor = await ensureConsoleAceEditor();
                editor.setValue('// Loading file...\n', -1);
                editor.setReadOnly(true);
                editor.session.setMode(`ace/mode/${guessConsoleAceMode(normalized)}`);
                client.send('read_file', { filePath: normalized });
            }

            function closeConsoleEditor() {
                if (!consoleEditorModalInstance) return;
                consoleEditorModalInstance.hide();
            }

            async function saveConsoleEditor() {
                if (!consoleAceEditor || !consoleEditorCurrentPath || consoleEditorReadOnly) return;
                const policyReason = getConsoleReadOnlyReason(consoleEditorCurrentPath);
                if (policyReason) {
                    consoleEditorReadOnly = true;
                    consoleAceEditor.setReadOnly(true);
                    setConsoleEditorState(policyReason, true);
                    showConsoleStatus(policyReason);
                    return;
                }
                consoleEditorPendingWritePath = consoleEditorCurrentPath;
                setConsoleEditorState('Saving file...', true);
                client.send('write_file', {
                    filePath: consoleEditorCurrentPath,
                    content: consoleAceEditor.getValue()
                });
            }

            async function uploadConsoleTreeFiles(fileList) {
                if (!canUseConsoleFiles || !fileList || !fileList.length) return;
                if (!canWriteConsoleFiles || consoleFilesWriteLocked) {
                    showConsoleStatus('Files are read-only for your session right now.');
                    return;
                }
                if (!consoleWebUploadEnabled) {
                    showConsoleStatus('Web upload is disabled by admin.');
                    return;
                }
                const targetDirectory = normalizeServerPath(consoleTreeSelectedDirectory || '/');
                for (const file of Array.from(fileList)) {
                    const response = await fetch(`/server/${serverContainerId}/files/upload?path=${encodeURIComponent(targetDirectory)}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/octet-stream',
                            'X-File-Name': file.name
                        },
                        body: file
                    });
                    const payload = await response.json().catch(() => ({}));
                    if (!response.ok || !payload.success) {
                        throw new Error(payload.error || `Upload failed for ${file.name}`);
                    }
                }
                await refreshConsoleTree(targetDirectory, true);
                showConsoleStatus(`Uploaded ${fileList.length} file(s) to ${targetDirectory}.`);
            }

            const term = new Terminal({
                theme: {
                    background: '#0d0d10',
                    foreground: '#e1e1e6',
                    cursor: '#e1e1e6',
                    black: '#16161a',
                    red: '#ef4444',
                    green: '#10b981',
                    yellow: '#f59e0b',
                    blue: '#3b82f6',
                    magenta: '#8b5cf6',
                    cyan: '#06b6d4',
                    white: '#e1e1e6'
                },
                allowProposedApi: true,
                fontFamily: 'Menlo, Monaco, "Courier New", monospace',
                fontSize: 13,
                cursorBlink: true,
                scrollback: 5000,
                convertEol: true
            });
            const consoleStateStorageKey = `cpanel.console.state.<%= server.containerId %>`;
            const commandHistoryStorageKey = `cpanel.console.history.<%= server.containerId %>`;
            const persistedConsoleState = (() => {
                try {
                    return JSON.parse(localStorage.getItem(consoleStateStorageKey) || '{}') || {};
                } catch (error) {
                    return {};
                }
            })();
            let consoleFontSize = Number(persistedConsoleState.fontSize) || 13;
            let followConsoleOutput = persistedConsoleState.follow !== false;
            let hasReceivedLiveConsoleOutput = false;
            let consoleReplayCache = '';
            const maxReplayChars = 250000;
            let consolePlainBuffer = '';
            let commandHistory = (() => {
                try {
                    const parsed = JSON.parse(localStorage.getItem(commandHistoryStorageKey) || '[]');
                    return Array.isArray(parsed) ? parsed.filter((entry) => typeof entry === 'string' && entry.trim()).slice(0, 32) : [];
                } catch (error) {
                    return [];
                }
            })();
            let commandHistoryIndex = -1;
            let unreadConsoleLines = 0;

            const fitAddon = new FitAddon.FitAddon();
            const searchAddon = new SearchAddon.SearchAddon();
            const webLinksAddon = new WebLinksAddon.WebLinksAddon();
            const unicode11Addon = new Unicode11Addon.Unicode11Addon();
            term.loadAddon(fitAddon);
            term.loadAddon(searchAddon);
            term.loadAddon(webLinksAddon);
            term.loadAddon(unicode11Addon);
            term.open(document.getElementById('terminal'));
            try {
                term.unicode.activeVersion = '11';
            } catch (error) {
                console.warn('Unicode11 addon could not be activated.', error);
            }

            try {
                const webglAddon = new WebglAddon.WebglAddon();
                webglAddon.onContextLoss(() => { webglAddon.dispose(); });
                term.loadAddon(webglAddon);
                console.log('xterm WebGL addon loaded successfully.');
            } catch (e) {
                console.warn('xterm WebGL addon could not load. Falling back to default renderer.', e);
            }

            term.options.fontSize = consoleFontSize;
            fitAddon.fit();

            const provisioningPanel = document.getElementById('provisioningPanel');
            const provisioningScreen = document.getElementById('provisioningScreen');
            const provisioningScreenTitle = document.getElementById('provisioningScreenTitle');
            const provisioningScreenMessage = document.getElementById('provisioningScreenMessage');
            const provisioningScreenStatus = document.getElementById('provisioningScreenStatus');
            const adminInstallScreen = document.getElementById('adminInstallScreen');
            const adminInstallTitle = document.getElementById('adminInstallTitle');
            const adminInstallMessage = document.getElementById('adminInstallMessage');
            const adminInstallStatus = document.getElementById('adminInstallStatus');
            const adminInstallLog = document.getElementById('adminInstallLog');
            const terminalWrapper = document.getElementById('terminalWrapper');
            const consoleGrid = document.getElementById('consoleGrid');
            const provisioningTitle = document.getElementById('provisioningTitle');
            const provisioningSummary = document.getElementById('provisioningSummary');
            const provisioningBadgeText = document.getElementById('provisioningBadgeText');
            const provisioningStagesEl = document.getElementById('provisioningStages');
            const provisioningAdminWrap = document.getElementById('provisioningAdminWrap');
            const provisioningAdminLog = document.getElementById('provisioningAdminLog');
            const provisioningStageDefs = [
                { key: 'prepare', label: 'Prepare Runtime' },
                { key: 'install', label: isAdminConsoleViewer ? 'Install Packages' : 'Create Files' },
                { key: 'config', label: 'Apply Config' },
                { key: 'container', label: 'Create Container' },
                { key: 'start', label: 'Start Server' }
            ];
            const provisioningState = {
                active: ['installing', 'starting'].includes(currentServerStatus),
                stages: Object.fromEntries(provisioningStageDefs.map((entry) => [entry.key, { status: 'pending', note: '' }])),
                adminLines: [],
                lastSummary: ''
            };
            const adminInstallLogLines = [];

            const stripAnsiSequences = (value) => String(value || '').replace(/\x1B\[[0-9;]*[A-Za-z]/g, '');
            const isProvisioningStatus = (status) => ['installing', 'starting'].includes(String(status || '').toLowerCase());

            function renderProvisioningPanel() {
                if (!provisioningPanel || !provisioningStagesEl) return;

                const shouldShow = provisioningState.active;
                provisioningPanel.classList.toggle('d-none', !shouldShow);
                if (!shouldShow) return;

                provisioningTitle.textContent = isAdminConsoleViewer ? 'Server Provisioning' : 'Creating server';
                provisioningSummary.textContent = provisioningState.lastSummary || (isAdminConsoleViewer
                    ? 'Waiting for connector install activity.'
                    : 'The server is being prepared. This can take a minute.');

                const failed = provisioningStageDefs.some((entry) => provisioningState.stages[entry.key].status === 'fail');
                const done = provisioningStageDefs.every((entry) => {
                    const current = provisioningState.stages[entry.key].status;
                    return current === 'done' || current === 'pending';
                }) && ['running', 'stopped'].includes(currentServerStatus) && !failed;

                provisioningBadgeText.textContent = failed ? 'Failed' : (done ? 'Ready' : 'Working');
                provisioningStagesEl.innerHTML = provisioningStageDefs.map((entry) => {
                    const current = provisioningState.stages[entry.key] || { status: 'pending', note: '' };
                    const cssClass = current.status === 'done'
                        ? 'is-done'
                        : current.status === 'active'
                            ? 'is-active'
                            : current.status === 'fail'
                                ? 'is-fail'
                                : '';
                    const label = current.status === 'done'
                        ? 'Done'
                        : current.status === 'active'
                            ? 'Working'
                            : current.status === 'fail'
                                ? 'Failed'
                                : 'Pending';
                    return `
                        <div class="provisioning-stage ${cssClass}">
                            <div class="provisioning-stage-label">${escapeHtml(entry.label)}</div>
                            <div class="provisioning-stage-value">${label}</div>
                            ${current.note ? `<div class="provisioning-stage-note">${escapeHtml(current.note)}</div>` : ''}
                        </div>
                    `;
                }).join('');

                if (provisioningAdminWrap && provisioningAdminLog) {
                    provisioningAdminWrap.classList.toggle('d-none', !isAdminConsoleViewer);
                    if (isAdminConsoleViewer) {
                        provisioningAdminLog.textContent = provisioningState.adminLines.length
                            ? provisioningState.adminLines.join('\n')
                            : 'Waiting for install output...';
                    }
                }
            }

            function activateProvisioning(summary) {
                provisioningState.active = true;
                if (summary) provisioningState.lastSummary = summary;
                renderProvisioningPanel();
            }

            function deactivateProvisioning() {
                provisioningState.active = false;
                renderProvisioningPanel();
            }

            function updateProvisioningStage(stageKey, status, note = '', summary = '') {
                const current = provisioningState.stages[stageKey];
                if (!current) return;
                current.status = status;
                if (note) current.note = note;
                if (summary) provisioningState.lastSummary = summary;
                activateProvisioning(provisioningState.lastSummary);
            }

            function completeProvisioningStage(stageKey, note = '', summary = '') {
                updateProvisioningStage(stageKey, 'done', note, summary);
            }

            function failProvisioningStage(stageKey, note = '', summary = '') {
                updateProvisioningStage(stageKey, 'fail', note, summary || 'Provisioning failed. Inspect the logs below.');
            }

            function appendProvisioningAdminLine(line) {
                if (!isAdminConsoleViewer) return;
                const trimmed = String(line || '').trim();
                if (!trimmed) return;
                provisioningState.adminLines.push(trimmed);
                if (provisioningState.adminLines.length > 40) {
                    provisioningState.adminLines = provisioningState.adminLines.slice(-40);
                }
                renderProvisioningPanel();
            }

            function isProvisioningContext() {
                return provisioningState.active || isProvisioningStatus(currentServerStatus);
            }

            function appendAdminInstallLog(rawLine) {
                if (!isAdminConsoleViewer || !adminInstallLog) return;
                const normalized = String(rawLine || '').replace(/\r/g, '');
                if (!normalized) return;
                const pieces = normalized.split('\n').filter((entry, index, array) => entry.length > 0 || index < array.length - 1);
                if (!pieces.length) return;
                adminInstallLogLines.push(...pieces);
                if (adminInstallLogLines.length > 600) {
                    adminInstallLogLines.splice(0, adminInstallLogLines.length - 600);
                }
                adminInstallLog.textContent = adminInstallLogLines.join('\n');
                adminInstallLog.scrollTop = adminInstallLog.scrollHeight;
            }

            function renderProvisioningAccessState(status) {
                const lowerStatus = String(status || '').toLowerCase();
                const blocked = ['installing', 'starting'].includes(lowerStatus);
                const adminBlocked = isAdminConsoleViewer && blocked;
                const userBlocked = restrictedProvisioningViewer && blocked;
                if (terminalWrapper) {
                    terminalWrapper.classList.toggle('provisioning-focused', userBlocked);
                }
                if (provisioningScreen) {
                    provisioningScreen.classList.toggle('d-none', !userBlocked);
                }
                if (adminInstallScreen) {
                    adminInstallScreen.classList.toggle('d-none', !adminBlocked);
                }
                if (consoleGrid) {
                    consoleGrid.classList.toggle('d-none', userBlocked || adminBlocked);
                }
                if (!blocked) {
                    requestAnimationFrame(() => fitAddon.fit());
                    return;
                }

                if (provisioningScreenStatus && userBlocked) {
                    provisioningScreenStatus.textContent = lowerStatus.toUpperCase();
                }
                if (provisioningScreenTitle && userBlocked) {
                    provisioningScreenTitle.textContent = lowerStatus === 'starting' ? 'Starting Server' : 'Running Installer';
                }
                if (provisioningScreenMessage && userBlocked) {
                    provisioningScreenMessage.textContent = lowerStatus === 'starting'
                        ? 'Your server is starting for the first time. Most actions stay locked until the runtime container is ready.'
                        : 'Your server is being created and configured. This usually finishes in under a minute.';
                }
                if (adminInstallStatus && adminBlocked) {
                    adminInstallStatus.textContent = lowerStatus.toUpperCase();
                }
                if (adminInstallTitle && adminBlocked) {
                    adminInstallTitle.textContent = lowerStatus === 'starting' ? 'Starting Runtime Container' : 'Running Installer';
                }
                if (adminInstallMessage && adminBlocked) {
                    adminInstallMessage.textContent = lowerStatus === 'starting'
                        ? 'The runtime container is starting. Full connector and installer output is streamed below.'
                        : 'Complete install output from the runtime builder is shown below.';
                }
            }

            function handleProvisioningLogLine(line) {
                if (!isProvisioningContext()) {
                    return false;
                }
                const plain = stripAnsiSequences(line).trim();
                if (!plain) return false;
                let matched = false;

                if (/running egg installation script/i.test(plain)) {
                    matched = true;
                    activateProvisioning(isAdminConsoleViewer ? 'Running egg installation script inside the installer container.' : 'Downloading files and preparing the server.');
                    updateProvisioningStage('prepare', 'done', 'Volume ready');
                    updateProvisioningStage('install', 'active', 'Installing packages');
                } else if (/skipping egg installation script/i.test(plain)) {
                    matched = true;
                    activateProvisioning(isAdminConsoleViewer ? 'Install script skipped; using imported files/runtime config.' : 'Preparing server files.');
                    completeProvisioningStage('prepare', 'Volume ready');
                    completeProvisioningStage('install', 'Skipped');
                } else if (/egg installation completed/i.test(plain)) {
                    matched = true;
                    completeProvisioningStage('install', 'Packages installed', isAdminConsoleViewer ? 'Egg installation completed successfully.' : 'Base server files are ready.');
                } else if (/applying egg config file parsers/i.test(plain)) {
                    matched = true;
                    updateProvisioningStage('config', 'active', 'Writing config files', isAdminConsoleViewer ? 'Applying egg config file parsers.' : 'Applying server configuration.');
                } else if (/sending start command/i.test(plain)) {
                    matched = true;
                    completeProvisioningStage('config', 'Config applied');
                    completeProvisioningStage('container', 'Created');
                    updateProvisioningStage('start', 'active', 'Dispatching start request', isAdminConsoleViewer ? 'Panel is sending the start command.' : 'Starting the server.');
                } else if (/runtime container is missing\. rebuilding it from the last saved install config/i.test(plain)) {
                    matched = true;
                    updateProvisioningStage('container', 'active', 'Recreating missing container', 'Runtime container was missing and is being rebuilt automatically.');
                } else if (/docker start .*no such container/i.test(plain) || /failed to start containers:/i.test(plain)) {
                    matched = true;
                    updateProvisioningStage('container', 'active', 'Container missing');
                    updateProvisioningStage('start', 'active', 'Retrying start');
                } else if (/power action 'start' accepted/i.test(plain)) {
                    matched = true;
                    completeProvisioningStage('config', 'Config applied');
                    updateProvisioningStage('start', 'active', 'Start accepted', isAdminConsoleViewer ? 'Connector accepted the power start request.' : 'Server start was accepted.');
                } else if (/install failed/i.test(plain)) {
                    matched = true;
                    failProvisioningStage('install', plain, 'Installation failed before the server could finish provisioning.');
                } else if (/power action failed \(start\)/i.test(plain)) {
                    matched = true;
                    failProvisioningStage('start', plain, 'Start failed while provisioning the server.');
                }

                if (matched) {
                    appendProvisioningAdminLine(plain);
                }
                return matched;
            }

            if (isProvisioningStatus(currentServerStatus)) {
                activateProvisioning(isAdminConsoleViewer
                    ? 'Waiting for connector install activity.'
                    : 'Your server is being created. You can keep this page open while it finishes.');
            }
            renderProvisioningPanel();
            renderProvisioningAccessState(currentServerStatus);

            // WebSocket Manager Class for Robust Connection
            class ConsoleClient {
                constructor(url) {
                    this.url = url;
                    this.ws = null;
                    this.reconnectInterval = 1000;
                    this.maxReconnectInterval = 5000;
                    this.isExplicitDisconnect = false;
                    this.heartbeatTimer = null;
                }

                connect() {
                    this.isExplicitDisconnect = false;
                    this.ws = new WebSocket(this.url);
                    this.updateStatus('connecting');

                    this.ws.onopen = () => {
                        this.updateStatus('connected');
                        this.reconnectInterval = 1000; // Reset backoff
                        term.writeln('\x1b[1;32m[✓] Console stream connected.\x1b[0m');
                        this.startHeartbeat();
                    };

                    this.ws.onmessage = (event) => {
                        try {
                            const data = JSON.parse(event.data);
                            this.handleMessage(data);
                        } catch (e) {
                            console.error('Failed to parse WS message:', e);
                        }
                    };

                    this.ws.onclose = (e) => {
                        this.stopHeartbeat();
                        this.updateStatus('disconnected');
                        if (!this.isExplicitDisconnect) {
                            term.writeln('\x1b[1;33m[!] Connection lost. Reconnecting in ' + (this.reconnectInterval / 1000) + 's...\x1b[0m');
                            setTimeout(() => {
                                this.reconnectInterval = Math.min(this.reconnectInterval * 1.5, this.maxReconnectInterval);
                                this.connect();
                            }, this.reconnectInterval);
                        }
                    };

                    this.ws.onerror = (err) => {
                        console.error('WebSocket error:', err);
                        this.ws.close();
                    };
                }

                send(type, payload = {}) {
                    if (this.ws && this.ws.readyState === WebSocket.OPEN) {
                        this.ws.send(JSON.stringify({ type, ...payload }));
                    }
                }

                handleMessage(data) {
                    switch (data.type) {
                        case 'file_content': {
                            const targetPath = normalizeServerPath(data.filePath || '');
                            if (!consoleEditorPendingReadPath || targetPath !== normalizeServerPath(consoleEditorPendingReadPath)) {
                                break;
                            }
                            consoleEditorPendingReadPath = '';
                            ensureConsoleAceEditor().then((editor) => {
                                const content = typeof data.content === 'string' ? data.content : String(data.content || '');
                                consoleEditorOriginalContent = content;
                                editor.setValue(content, -1);
                                editor.session.setMode(`ace/mode/${guessConsoleAceMode(targetPath)}`);
                                const policyReason = getConsoleReadOnlyReason(targetPath);
                                consoleEditorReadOnly = Boolean(policyReason);
                                editor.setReadOnly(consoleEditorReadOnly);
                                setConsoleEditorState(consoleEditorReadOnly ? policyReason : 'Ready to edit.', consoleEditorReadOnly);
                            }).catch((error) => {
                                console.error('Console file editor failed to initialize:', error);
                                setConsoleEditorState(error.message || 'Ace editor failed to load.', true);
                            });
                            break;
                        }
                        case 'write_success': {
                            const targetPath = normalizeServerPath(data.filePath || '');
                            if (!consoleEditorPendingWritePath || targetPath !== normalizeServerPath(consoleEditorPendingWritePath)) {
                                break;
                            }
                            consoleEditorPendingWritePath = '';
                            consoleEditorOriginalContent = consoleAceEditor ? consoleAceEditor.getValue() : consoleEditorOriginalContent;
                            if (consoleAceEditor) consoleAceEditor.setReadOnly(consoleEditorReadOnly);
                            setConsoleEditorState(consoleEditorReadOnly ? getConsoleReadOnlyReason(targetPath) : 'Saved.', consoleEditorReadOnly);
                            showConsoleStatus(`Saved ${targetPath}.`);
                            break;
                        }
                        case 'console_output':
                            const cleanOutput = this.scrubAnsi(data.output);
                            hasReceivedLiveConsoleOutput = true;
                            appendAdminInstallLog(stripAnsiSequences(cleanOutput));
                            const provisioningMatched = handleProvisioningLogLine(cleanOutput);
                            if (!provisioningMatched || isAdminConsoleViewer) {
                                const mcStyledOutput = this.translateMinecraftFormatting(cleanOutput);
                                const styledOutput = this.translateAdventureFormatting(mcStyledOutput);
                                const finalOutput = this.rewritePromptBrand(styledOutput);
                                term.write(finalOutput);
                                appendReplayChunk(finalOutput);
                                appendPlainBuffer(stripAnsiSequences(finalOutput));
                                updateSearchMatchCount(terminalSearchInput?.value || '');
                                if (followConsoleOutput || isTerminalAtBottom()) {
                                    term.scrollToBottom();
                                    resetUnreadConsole();
                                } else {
                                    unreadConsoleLines += Math.max(1, String(cleanOutput || '').split('\n').filter(Boolean).length);
                                    if (terminalUnreadCount) terminalUnreadCount.textContent = String(unreadConsoleLines);
                                    btnJumpLatest?.classList.remove('d-none');
                                }
                            }
                            break;
                        case 'server_status_update':
                            updateUIStatus(data.status);
                            break;
                        case 'connector_status':
                            updateConnectorStatus(data.online);
                            break;
                        case 'server_action_ack': {
                            const phase = String(data.phase || '').toLowerCase();
                            const actionType = String(data.actionType || 'action');
                            const text = String(data.message || '').trim() || `${actionType} ${phase}`;
                            const isProvisionStartAck = isProvisioningContext() && actionType === 'power' && /start/i.test(text);
                            if (isProvisionStartAck) {
                                completeProvisioningStage('container', 'Created');
                                updateProvisioningStage('start', phase === 'failed' ? 'fail' : 'active', text, phase === 'failed'
                                    ? 'Start request failed while provisioning the server.'
                                    : (isAdminConsoleViewer ? 'Connector acknowledged the start request.' : 'Server start request accepted.'));
                                if (phase === 'failed') {
                                    failProvisioningStage('start', text, 'Start request failed while provisioning the server.');
                                }
                            }
                            if (phase === 'failed') {
                                term.writeln(`\x1b[1;31m[ACK] ${actionType}: ${text}\x1b[0m`);
                            } else if (phase === 'executed') {
                                if (!isProvisionStartAck || isAdminConsoleViewer) {
                                    term.writeln(`\x1b[1;32m[ACK] ${actionType}: ${text}\x1b[0m`);
                                }
                            } else {
                                if (!isProvisionStartAck || isAdminConsoleViewer) {
                                    term.writeln(`\x1b[1;34m[ACK] ${actionType}: ${text}\x1b[0m`);
                                }
                            }
                            break;
                        }
                        case 'resource_limits_result':
                            if (data.success) {
                                term.writeln('\x1b[1;32m[✓] Live resource limits were applied.\x1b[0m');
                            } else {
                                term.writeln(`\x1b[1;31m[!] Live resource apply failed: ${data.error || 'unknown error'}\x1b[0m`);
                            }
                            break;
                        case 'eula_status':
                            if (showMinecraftEulaModal && eulaModalInstance) {
                                if (data.accepted) {
                                    eulaModalInstance.hide();
                                } else {
                                    eulaModalInstance.show();
                                }
                            }
                            break;
                        case 'error':
                            if (consoleEditorPendingReadPath || consoleEditorPendingWritePath) {
                                const editorError = String(data.message || 'File operation failed.');
                                consoleEditorPendingReadPath = '';
                                consoleEditorPendingWritePath = '';
                                if (consoleAceEditor) {
                                    consoleAceEditor.setReadOnly(true);
                                }
                                setConsoleEditorState(editorError, true);
                                showConsoleStatus(editorError);
                                break;
                            }
                            term.writeln(`\x1b[1;31m[!] Error: ${data.message}\x1b[0m`);
                            break;
                    }
                }

                scrubAnsi(text) {
                    if (!text) return '';
                    return text.replace(/\\x1b/g, '\x1b');
                }

                translateMinecraftFormatting(text) {
                    if (!text || text.indexOf('§') === -1) return text || '';

                    const colorMap = {
                        '0': '\x1b[0m\x1b[30m',
                        '1': '\x1b[0m\x1b[34m',
                        '2': '\x1b[0m\x1b[32m',
                        '3': '\x1b[0m\x1b[36m',
                        '4': '\x1b[0m\x1b[31m',
                        '5': '\x1b[0m\x1b[35m',
                        '6': '\x1b[0m\x1b[33m',
                        '7': '\x1b[0m\x1b[37m',
                        '8': '\x1b[0m\x1b[90m',
                        '9': '\x1b[0m\x1b[94m',
                        'a': '\x1b[0m\x1b[92m',
                        'b': '\x1b[0m\x1b[96m',
                        'c': '\x1b[0m\x1b[91m',
                        'd': '\x1b[0m\x1b[95m',
                        'e': '\x1b[0m\x1b[93m',
                        'f': '\x1b[0m\x1b[97m'
                    };

                    const formatMap = {
                        'l': '\x1b[1m',
                        'm': '\x1b[9m',
                        'n': '\x1b[4m',
                        'o': '\x1b[3m',
                        'r': '\x1b[0m'
                    };

                    const isHex = (ch) => /[0-9a-f]/i.test(ch);
                    const longHexToAnsi = (hex) => {
                        const r = parseInt(hex.slice(0, 2), 16);
                        const g = parseInt(hex.slice(2, 4), 16);
                        const b = parseInt(hex.slice(4, 6), 16);
                        return `\x1b[0m\x1b[38;2;${r};${g};${b}m`;
                    };

                    let out = '';
                    let i = 0;
                    while (i < text.length) {
                        const ch = text[i];
                        if (ch !== '§' || i + 1 >= text.length) {
                            out += ch;
                            i += 1;
                            continue;
                        }

                        const codeRaw = text[i + 1];
                        const code = String(codeRaw || '').toLowerCase();

                        // Hex format: §x§R§R§G§G§B§B
                        if (code === 'x') {
                            if (i + 13 < text.length) {
                                let hex = '';
                                let validLongHex = true;
                                for (let n = 0; n < 6; n += 1) {
                                    const markerIdx = i + 2 + (n * 2);
                                    const digitIdx = markerIdx + 1;
                                    if (text[markerIdx] !== '§' || !isHex(text[digitIdx])) {
                                        validLongHex = false;
                                        break;
                                    }
                                    hex += text[digitIdx];
                                }
                                if (validLongHex) {
                                    out += longHexToAnsi(hex);
                                    i += 14;
                                    continue;
                                }
                            }

                            // Fallback hex format: §xRRGGBB
                            if (i + 7 < text.length) {
                                const compactHex = text.slice(i + 2, i + 8);
                                if (/^[0-9a-f]{6}$/i.test(compactHex)) {
                                    out += longHexToAnsi(compactHex);
                                    i += 8;
                                    continue;
                                }
                            }

                            // Unknown §x variant, strip control token.
                            i += 2;
                            continue;
                        }

                        // Alternate hex format: §#RRGGBB
                        if (code === '#' && i + 7 < text.length) {
                            const hashHex = text.slice(i + 2, i + 8);
                            if (/^[0-9a-f]{6}$/i.test(hashHex)) {
                                out += longHexToAnsi(hashHex);
                                i += 8;
                                continue;
                            }
                        }

                        if (colorMap[code]) {
                            out += colorMap[code];
                            i += 2;
                            continue;
                        }

                        if (formatMap[code]) {
                            out += formatMap[code];
                            i += 2;
                            continue;
                        }

                        // Ignore unsupported formatting code and keep parsing.
                        i += 2;
                    }

                    return out;
                }

                translateAdventureFormatting(text) {
                    if (!text || text.indexOf('<') === -1) return text || '';

                    const colorTags = {
                        'black': '\x1b[30m',
                        'dark_blue': '\x1b[34m',
                        'dark_green': '\x1b[32m',
                        'dark_aqua': '\x1b[36m',
                        'dark_red': '\x1b[31m',
                        'dark_purple': '\x1b[35m',
                        'gold': '\x1b[33m',
                        'gray': '\x1b[37m',
                        'grey': '\x1b[37m',
                        'dark_gray': '\x1b[90m',
                        'dark_grey': '\x1b[90m',
                        'blue': '\x1b[94m',
                        'green': '\x1b[92m',
                        'aqua': '\x1b[96m',
                        'red': '\x1b[91m',
                        'light_purple': '\x1b[95m',
                        'yellow': '\x1b[93m',
                        'white': '\x1b[97m'
                    };

                    const styleOn = {
                        'bold': '\x1b[1m',
                        'b': '\x1b[1m',
                        'italic': '\x1b[3m',
                        'i': '\x1b[3m',
                        'underlined': '\x1b[4m',
                        'underline': '\x1b[4m',
                        'u': '\x1b[4m',
                        'strikethrough': '\x1b[9m',
                        'st': '\x1b[9m',
                        'obfuscated': '\x1b[2m',
                        'obf': '\x1b[2m'
                    };

                    const styleOff = {
                        'bold': '\x1b[22m',
                        'b': '\x1b[22m',
                        'italic': '\x1b[23m',
                        'i': '\x1b[23m',
                        'underlined': '\x1b[24m',
                        'underline': '\x1b[24m',
                        'u': '\x1b[24m',
                        'strikethrough': '\x1b[29m',
                        'st': '\x1b[29m',
                        'obfuscated': '\x1b[22m',
                        'obf': '\x1b[22m'
                    };

                    const osc8Link = (url, label) => `\x1b]8;;${url}\x1b\\${label}\x1b]8;;\x1b\\`;
                    const hexToAnsi = (hex) => {
                        const r = parseInt(hex.slice(0, 2), 16);
                        const g = parseInt(hex.slice(2, 4), 16);
                        const b = parseInt(hex.slice(4, 6), 16);
                        return `\x1b[38;2;${r};${g};${b}m`;
                    };

                    // Common MiniMessage case: <link:url>https://... (without explicit </link>)
                    let input = text.replace(/<link:([^>\s]+)>([^\s<]+)/gi, (match, rawUrl, label) => {
                        const url = String(rawUrl || '').trim();
                        if (!url) return label || '';
                        return osc8Link(url, label || url);
                    });

                    let out = '';
                    let i = 0;
                    while (i < input.length) {
                        if (input[i] !== '<') {
                            out += input[i];
                            i += 1;
                            continue;
                        }

                        const end = input.indexOf('>', i + 1);
                        if (end === -1) {
                            out += input[i];
                            i += 1;
                            continue;
                        }

                        const rawTag = input.slice(i + 1, end).trim();
                        if (!rawTag) {
                            out += input[i];
                            i += 1;
                            continue;
                        }

                        const lowerTag = rawTag.toLowerCase();

                        if (lowerTag === 'reset' || lowerTag === 'r') {
                            out += '\x1b[0m';
                            i = end + 1;
                            continue;
                        }

                        if (lowerTag.startsWith('/')) {
                            const closeTag = lowerTag.slice(1).trim();
                            if (!closeTag) {
                                i = end + 1;
                                continue;
                            }

                            if (closeTag === 'reset' || closeTag === 'r') {
                                out += '\x1b[0m';
                                i = end + 1;
                                continue;
                            }
                            if (closeTag === 'link') {
                                out += '\x1b]8;;\x1b\\';
                                i = end + 1;
                                continue;
                            }
                            if (styleOff[closeTag]) {
                                out += styleOff[closeTag];
                                i = end + 1;
                                continue;
                            }
                            if (colorTags[closeTag] || /^#[0-9a-f]{6}$/i.test(closeTag)) {
                                out += '\x1b[39m';
                                i = end + 1;
                                continue;
                            }
                        } else {
                            if (lowerTag.startsWith('link:')) {
                                const rawUrl = rawTag.slice(rawTag.indexOf(':') + 1).trim();
                                if (rawUrl) out += `\x1b]8;;${rawUrl}\x1b\\`;
                                i = end + 1;
                                continue;
                            }
                            if (/^#[0-9a-f]{6}$/i.test(lowerTag)) {
                                out += hexToAnsi(lowerTag.slice(1));
                                i = end + 1;
                                continue;
                            }
                            if (colorTags[lowerTag]) {
                                out += colorTags[lowerTag];
                                i = end + 1;
                                continue;
                            }
                            if (styleOn[lowerTag]) {
                                out += styleOn[lowerTag];
                                i = end + 1;
                                continue;
                            }
                        }

                        // Unknown tag: keep text untouched.
                        out += input.slice(i, end + 1);
                        i = end + 1;
                    }

                    return out;
                }

                rewritePromptBrand(text) {
                    if (!text || !promptBrand) return text || '';
                    return text.replace(/@pterodactyl/gi, `@${promptBrand}`);
                }

                updateStatus(state) {
                    const badge = document.getElementById('wsStatusBadge');
                    if (!badge) return;

                    if (state === 'connected') {
                        badge.className = 'badge bg-success ms-2';
                        badge.innerHTML = '<i class="bi bi-hdd-network"></i> Connected';
                    } else if (state === 'connecting') {
                        badge.className = 'badge bg-warning text-dark ms-2';
                        badge.innerHTML = '<i class="bi bi-arrow-repeat"></i> Reconnecting...';
                    } else {
                        badge.className = 'badge bg-danger ms-2';
                        badge.innerHTML = '<i class="bi bi-hdd-network"></i> Disconnected';
                    }
                }

                startHeartbeat() {
                    this.stopHeartbeat();
                    this.heartbeatTimer = setInterval(() => {
                        this.send('ping');
                    }, 30000);
                }

                stopHeartbeat() {
                    if (this.heartbeatTimer) clearInterval(this.heartbeatTimer);
                }
            }


            // Persistent Status Polling
            let statusPollingTimer = null;
            const statusUrl = `/server/<%= server.containerId %>/status`;

            function startStatusCheck() {
                if (statusPollingTimer) return;
                console.log('Starting persistent status polling (5.5s)...');
                statusPollingTimer = setInterval(checkStatus, 5500);
            }

            async function checkStatus() {
                try {
                    const response = await fetch(statusUrl);
                    const data = await response.json();

                    if (data.online) {
                        if (!connectorOnline) {
                            console.log('Connector is back online (polling detected)');
                            updateConnectorStatus(true);
                        }
                    } else {
                        if (connectorOnline) {
                            console.log('Connector went offline (polling detected)');
                            updateConnectorStatus(false);
                        }
                    }
                } catch (err) {
                    console.error('Status check error:', err);
                    if (connectorOnline) {
                        updateConnectorStatus(false);
                    }
                }
            }

            // Initialize Client
            const wsToken = '<%= wsToken || "" %>';
            const finalWsUrl = window.location.protocol.replace('http', 'ws') + '//' + window.location.host + '/ws/server/<%= server.containerId %>?token=' + encodeURIComponent(wsToken);

            const client = new ConsoleClient(finalWsUrl);
            client.connect();
            startStatusCheck();

            // UI Event Listeners
            const consoleInput = document.getElementById('consoleInput');
            const macroSelect = document.getElementById('macroSelect');
            const btnRunMacro = document.getElementById('btnRunMacro');
            const btnSearch = document.getElementById('btnSearch');
            const btnFollow = document.getElementById('btnFollow');
            const btnJumpLatest = document.getElementById('btnJumpLatest');
            const terminalUnreadCount = document.getElementById('terminalUnreadCount');
            const terminalSearchbar = document.getElementById('terminalSearchbar');
            const terminalSearchInput = document.getElementById('terminalSearchInput');
            const btnSearchPrev = document.getElementById('btnSearchPrev');
            const btnSearchNext = document.getElementById('btnSearchNext');
            const btnSearchClose = document.getElementById('btnSearchClose');
            const terminalSearchCount = document.getElementById('terminalSearchCount');
            const terminalContextMenu = document.getElementById('terminalContextMenu');

            function persistConsoleState() {
                localStorage.setItem(consoleStateStorageKey, JSON.stringify({
                    fontSize: consoleFontSize,
                    follow: followConsoleOutput
                }));
            }

            function persistReplayCache() {
                try {
                    sessionStorage.setItem(consoleReplayStorageKey, consoleReplayCache);
                } catch (error) {
                    console.warn('Failed to persist console replay cache.', error);
                }
            }

            function appendReplayChunk(chunk) {
                if (!chunk) return;
                consoleReplayCache += String(chunk);
                if (consoleReplayCache.length > maxReplayChars) {
                    consoleReplayCache = consoleReplayCache.slice(-maxReplayChars);
                }
                persistReplayCache();
            }

            function clearReplayCache() {
                consoleReplayCache = '';
                consolePlainBuffer = '';
                try {
                    sessionStorage.removeItem(consoleReplayStorageKey);
                } catch (error) {
                    console.warn('Failed to clear console replay cache.', error);
                }
            }

            function appendPlainBuffer(chunk) {
                if (!chunk) return;
                consolePlainBuffer += String(chunk);
                if (consolePlainBuffer.length > maxReplayChars) {
                    consolePlainBuffer = consolePlainBuffer.slice(-maxReplayChars);
                }
            }

            function updateSearchMatchCount(query) {
                if (!terminalSearchCount) return;
                const needle = String(query || '');
                if (!needle) {
                    terminalSearchCount.textContent = '0 matches';
                    return;
                }
                try {
                    const escaped = needle.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                    const matches = consolePlainBuffer.match(new RegExp(escaped, 'gi'));
                    terminalSearchCount.textContent = `${matches ? matches.length : 0} matches`;
                } catch (error) {
                    terminalSearchCount.textContent = '0 matches';
                }
            }

            function persistCommandHistory() {
                localStorage.setItem(commandHistoryStorageKey, JSON.stringify(commandHistory.slice(0, 32)));
            }

            function resetUnreadConsole() {
                unreadConsoleLines = 0;
                if (terminalUnreadCount) terminalUnreadCount.textContent = '0';
                btnJumpLatest?.classList.add('d-none');
            }

            function isTerminalAtBottom() {
                return term.buffer.active.viewportY >= term.buffer.active.baseY;
            }

            function setFollowConsoleOutput(nextValue) {
                followConsoleOutput = Boolean(nextValue);
                btnFollow?.classList.toggle('follow-active', followConsoleOutput);
                btnFollow?.setAttribute('title', followConsoleOutput ? 'Following output' : 'Follow output');
                if (followConsoleOutput) {
                    term.scrollToBottom();
                    resetUnreadConsole();
                }
                persistConsoleState();
            }

            function recordCommandHistory(command) {
                const trimmed = String(command || '').trim();
                if (!trimmed) return;
                commandHistory = [trimmed, ...commandHistory.filter((entry) => entry !== trimmed)].slice(0, 32);
                commandHistoryIndex = -1;
                persistCommandHistory();
            }

            function sendConsoleCommand(command) {
                const value = String(command || '').trim();
                if (!connectorOnline || !value) return false;
                client.send('console_input', { command: value });
                recordCommandHistory(value);
                if (consoleInput) consoleInput.value = '';
                return true;
            }

            function setCommandInputFromHistory(direction) {
                if (!consoleInput || !commandHistory.length) return;
                if (direction === 'up') {
                    commandHistoryIndex = Math.min(commandHistoryIndex + 1, commandHistory.length - 1);
                } else {
                    commandHistoryIndex = Math.max(commandHistoryIndex - 1, -1);
                }
                consoleInput.value = commandHistoryIndex >= 0 ? (commandHistory[commandHistoryIndex] || '') : '';
                requestAnimationFrame(() => {
                    const len = consoleInput.value.length;
                    consoleInput.setSelectionRange(len, len);
                });
            }

            function toggleTerminalSearch(forceOpen = null) {
                if (!terminalSearchbar) return;
                const shouldOpen = forceOpen === null ? terminalSearchbar.classList.contains('d-none') : Boolean(forceOpen);
                terminalSearchbar.classList.toggle('d-none', !shouldOpen);
                if (shouldOpen) {
                    updateSearchMatchCount(terminalSearchInput?.value || '');
                    terminalSearchInput?.focus();
                    terminalSearchInput?.select();
                } else {
                    consoleInput?.focus();
                }
            }

            async function copyTerminalSelection() {
                const selected = term.getSelection();
                if (!selected) return false;
                try {
                    await navigator.clipboard.writeText(selected);
                    showConsoleStatus('Selection copied to clipboard.');
                    return true;
                } catch (error) {
                    showConsoleStatus('Clipboard copy failed.');
                    return false;
                }
            }

            function hideTerminalContextMenu() {
                terminalContextMenu?.classList.add('d-none');
            }

            function showTerminalContextMenu(x, y) {
                if (!terminalContextMenu) return;
                terminalContextMenu.classList.remove('d-none');
                const maxX = window.innerWidth - terminalContextMenu.offsetWidth - 12;
                const maxY = window.innerHeight - terminalContextMenu.offsetHeight - 12;
                terminalContextMenu.style.left = `${Math.max(12, Math.min(x, maxX))}px`;
                terminalContextMenu.style.top = `${Math.max(12, Math.min(y, maxY))}px`;
            }

            function restoreReplayCacheIfNeeded() {
                if (currentServerStatus !== 'stopped') return;
                try {
                    const saved = sessionStorage.getItem(consoleReplayStorageKey) || '';
                    if (!saved || hasReceivedLiveConsoleOutput) return;
                    consoleReplayCache = saved.slice(-maxReplayChars);
                    term.write(consoleReplayCache);
                    appendPlainBuffer(stripAnsiSequences(consoleReplayCache));
                    updateSearchMatchCount(terminalSearchInput?.value || '');
                    if (followConsoleOutput) {
                        term.scrollToBottom();
                    }
                } catch (error) {
                    console.warn('Failed to restore console replay cache.', error);
                }
            }

            term.onScroll(() => {
                if (isTerminalAtBottom()) {
                    resetUnreadConsole();
                }
            });

            setFollowConsoleOutput(followConsoleOutput);
            restoreReplayCacheIfNeeded();
            syncConsoleSideRailVisibility();

            if (canUseConsoleFiles && consoleFilesVisible) {
                refreshConsoleTree('/', false).catch((error) => {
                    console.error('Initial console tree load failed:', error);
                    renderConsoleTree();
                });
            }
            if (minecraftPanelEnabled && consolePlayersVisible) {
                refreshPlayerPanel();
            }

            btnToggleConsoleFiles?.addEventListener('click', () => {
                consoleFilesVisible = !consoleFilesVisible;
                syncConsoleSideRailVisibility();
                if (consoleFilesVisible) {
                    refreshConsoleTree(consoleTreeSelectedDirectory || '/', false).catch((error) => {
                        console.error('Console tree refresh failed:', error);
                        showConsoleStatus(error.message || 'Failed to load mini file tree.');
                    });
                }
            });

            btnTogglePlayerPanel?.addEventListener('click', () => {
                consolePlayersVisible = !consolePlayersVisible;
                syncConsoleSideRailVisibility();
                if (consolePlayersVisible && minecraftPanelEnabled) {
                    refreshPlayerPanel();
                }
            });

            consoleFilesRefreshBtn?.addEventListener('click', () => {
                refreshConsoleTree(consoleTreeSelectedDirectory || '/', true).catch((error) => {
                    console.error('Console tree refresh failed:', error);
                    showConsoleStatus(error.message || 'Failed to refresh mini file tree.');
                });
            });

            consoleFilesTreeList?.addEventListener('click', async (event) => {
                const target = event.target && event.target.closest ? event.target.closest('[data-tree-path]') : null;
                if (!target) return;
                const targetPath = normalizeServerPath(target.getAttribute('data-tree-path') || '/');
                const isDir = target.getAttribute('data-tree-dir') === '1';
                if (isDir) {
                    consoleTreeSelectedDirectory = targetPath;
                    if (consoleFileTreeExpanded.has(targetPath)) {
                        consoleFileTreeExpanded.delete(targetPath);
                        renderConsoleTree();
                    } else {
                        consoleFileTreeExpanded.add(targetPath);
                        try {
                            await fetchConsoleTreeEntries(targetPath, false);
                        } catch (error) {
                            showConsoleStatus(error.message || 'Failed to open directory.');
                        }
                        renderConsoleTree();
                    }
                    return;
                }
                openConsoleEditor(targetPath);
            });

            const setConsoleTreeDragState = (active) => {
                consoleTreeDropzone?.classList.toggle('is-dragover', Boolean(active));
            };

            ['dragenter', 'dragover'].forEach((eventName) => {
                consoleTreeDropzone?.addEventListener(eventName, (event) => {
                    event.preventDefault();
                    setConsoleTreeDragState(true);
                });
            });
            ['dragleave', 'dragend', 'drop'].forEach((eventName) => {
                consoleTreeDropzone?.addEventListener(eventName, (event) => {
                    event.preventDefault();
                    setConsoleTreeDragState(false);
                });
            });
            consoleTreeDropzone?.addEventListener('drop', async (event) => {
                event.preventDefault();
                const files = event.dataTransfer && event.dataTransfer.files ? event.dataTransfer.files : null;
                if (!files || !files.length) return;
                try {
                    await uploadConsoleTreeFiles(files);
                } catch (error) {
                    console.error('Console tree upload failed:', error);
                    showConsoleStatus(error.message || 'Upload failed.');
                }
            });

            consoleFileEditorSaveBtn?.addEventListener('click', () => {
                saveConsoleEditor().catch((error) => {
                    console.error('Console file save failed:', error);
                    showConsoleStatus(error.message || 'Failed to save file.');
                });
            });
            consoleFileEditorCloseBtn?.addEventListener('click', closeConsoleEditor);
            consoleFileEditorDismissBtn?.addEventListener('click', closeConsoleEditor);
            consoleFileEditorModalEl?.addEventListener('hide.bs.modal', (event) => {
                const editor = consoleAceEditor;
                if (editor && !consoleEditorReadOnly && editor.getValue() !== consoleEditorOriginalContent) {
                    const shouldClose = window.confirm('Close the editor and discard unsaved changes?');
                    if (!shouldClose) {
                        event.preventDefault();
                    }
                }
            });

            function submitMacroRun(macroId) {
                const id = Number.parseInt(macroId, 10);
                if (!Number.isInteger(id) || id <= 0) return false;
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/server/<%= server.containerId %>/macros/${encodeURIComponent(String(id))}/run`;
                form.style.display = 'none';

                const returnInput = document.createElement('input');
                returnInput.type = 'hidden';
                returnInput.name = 'returnTo';
                returnInput.value = `${window.location.pathname}${window.location.search || ''}`;
                form.appendChild(returnInput);

                document.body.appendChild(form);
                form.submit();
                return true;
            }
            consoleInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter' && connectorOnline) {
                    sendConsoleCommand(consoleInput.value);
                }
            });

            consoleInput.addEventListener('keydown', (e) => {
                if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    setCommandInputFromHistory('up');
                } else if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    setCommandInputFromHistory('down');
                }
            });

            const btnStart = document.getElementById('btnStart');
            const btnStop = document.getElementById('btnStop');
            const btnRestart = document.getElementById('btnRestart');
            const btnClear = document.getElementById('btnClear');

            document.addEventListener('keydown', (e) => {
                const isInput = document.activeElement && ['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName);
                const key = String(e.key || '').toLowerCase();

                if ((e.ctrlKey || e.metaKey) && key === 'k') {
                    e.preventDefault();
                    consoleInput?.focus();
                    return;
                }
                if ((e.ctrlKey || e.metaKey) && key === 'l') {
                    if (btnClear) {
                        e.preventDefault();
                        btnClear.click();
                    }
                    return;
                }
                if ((e.ctrlKey || e.metaKey) && key === 'f') {
                    e.preventDefault();
                    toggleTerminalSearch(true);
                    return;
                }
                if ((e.ctrlKey || e.metaKey) && key === 'enter') {
                    e.preventDefault();
                    sendConsoleCommand(consoleInput ? consoleInput.value : '');
                    return;
                }
                if ((e.ctrlKey || e.metaKey) && e.shiftKey && key === 'r') {
                    if (btnRestart && !btnRestart.disabled) {
                        e.preventDefault();
                        btnRestart.click();
                    }
                    return;
                }
                if ((e.ctrlKey || e.metaKey) && e.shiftKey && key === 's') {
                    e.preventDefault();
                    const startVisible = btnStart && !btnStart.classList.contains('d-none');
                    const stopVisible = btnStop && !btnStop.classList.contains('d-none');
                    if (startVisible && btnStart && !btnStart.disabled) {
                        btnStart.click();
                    } else if (stopVisible && btnStop && !btnStop.disabled) {
                        btnStop.click();
                    }
                }
            });

            if (btnRunMacro && macroSelect) {
                btnRunMacro.addEventListener('click', () => {
                    if (!connectorOnline) {
                        term.writeln('\x1b[1;31m[!] Cannot run macro: connector is offline.\x1b[0m');
                        return;
                    }
                    const macroId = String(macroSelect.value || '').trim();
                    if (!macroId) return;
                    term.writeln('\x1b[1;36m[*] Running macro flow...\x1b[0m');
                    submitMacroRun(macroId);
                });
            }

            const btnPopout = document.getElementById('btnPopout');
            if (btnPopout) {
                btnPopout.addEventListener('click', function () {
                    const srvId = this.getAttribute('data-server-id');
                    window.open(`/server/${srvId}?popout=true`, `console_popout_${srvId}`, 'width=900,height=600');
                });
            }

            const btnFontMinus = document.getElementById('btnFontMinus');
            const btnFontPlus = document.getElementById('btnFontPlus');

            function applyConsoleFontSize(nextSize) {
                const size = Math.max(10, Math.min(18, nextSize));
                consoleFontSize = size;
                term.options.fontSize = size;
                fitAddon.fit();
                persistConsoleState();
            }

            if (btnFontMinus) {
                btnFontMinus.addEventListener('click', () => applyConsoleFontSize(consoleFontSize - 1));
            }

            if (btnFontPlus) {
                btnFontPlus.addEventListener('click', () => applyConsoleFontSize(consoleFontSize + 1));
            }

            if (btnClear) {
                btnClear.addEventListener('click', () => {
                    term.clear();
                    clearReplayCache();
                    updateSearchMatchCount(terminalSearchInput?.value || '');
                });
            }

            btnSearch?.addEventListener('click', () => toggleTerminalSearch());
            btnFollow?.addEventListener('click', () => setFollowConsoleOutput(!followConsoleOutput));
            btnJumpLatest?.addEventListener('click', () => {
                term.scrollToBottom();
                setFollowConsoleOutput(true);
            });
            btnSearchPrev?.addEventListener('click', () => {
                searchAddon.findPrevious(terminalSearchInput?.value || '', { incremental: true, decorations: true });
            });
            btnSearchNext?.addEventListener('click', () => {
                searchAddon.findNext(terminalSearchInput?.value || '', { incremental: true, decorations: true });
            });
            btnSearchClose?.addEventListener('click', () => toggleTerminalSearch(false));
            terminalSearchInput?.addEventListener('input', () => {
                updateSearchMatchCount(terminalSearchInput.value || '');
                searchAddon.findNext(terminalSearchInput.value || '', { incremental: true, decorations: true });
            });
            terminalSearchInput?.addEventListener('keydown', (event) => {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    searchAddon.findNext(terminalSearchInput.value || '', { incremental: true, decorations: true });
                } else if (event.key === 'Escape') {
                    event.preventDefault();
                    toggleTerminalSearch(false);
                }
            });

            const terminalHost = document.getElementById('terminal');
            terminalHost?.addEventListener('mouseup', () => {
                if (term.getSelection()) {
                    copyTerminalSelection();
                }
            });
            terminalHost?.addEventListener('contextmenu', (event) => {
                event.preventDefault();
                showTerminalContextMenu(event.clientX, event.clientY);
            });
            terminalContextMenu?.addEventListener('click', async (event) => {
                const target = event.target && event.target.closest ? event.target.closest('[data-terminal-action]') : null;
                if (!target) return;
                const action = target.getAttribute('data-terminal-action');
                hideTerminalContextMenu();
                if (action === 'copy-selection') {
                    await copyTerminalSelection();
                } else if (action === 'paste-input') {
                    try {
                        const text = await navigator.clipboard.readText();
                        if (consoleInput) {
                            consoleInput.value += text;
                            consoleInput.focus();
                        }
                    } catch (error) {
                        showConsoleStatus('Clipboard paste failed.');
                    }
                } else if (action === 'search-console') {
                    toggleTerminalSearch(true);
                } else if (action === 'clear-console') {
                    btnClear?.click();
                }
            });
            document.addEventListener('click', (event) => {
                if (!terminalContextMenu || terminalContextMenu.classList.contains('d-none')) return;
                if (terminalContextMenu.contains(event.target)) return;
                hideTerminalContextMenu();
            });
            window.addEventListener('blur', hideTerminalContextMenu);

            document.getElementById('btnStart').addEventListener('click', () => sendPower('start'));
            document.getElementById('btnRestart').addEventListener('click', () => sendPower('restart'));
            document.getElementById('btnStop').addEventListener('click', function () {
                sendPower('stop');
                this.classList.add('d-none');
                document.getElementById('btnKill').classList.remove('d-none');
            });
            document.getElementById('btnKill').addEventListener('click', () => sendPower('kill'));

            const btnAcceptEula = document.getElementById('btnAcceptEula');
            if (btnAcceptEula) {
                btnAcceptEula.addEventListener('click', () => {
                    client.send('accept_eula');
                    if (eulaModalInstance) eulaModalInstance.hide();
                    term.writeln('\x1b[1;32m[*] EULA accepted! Please start your server now.\x1b[0m');
                });
            }

            function sendPower(action) {
                if (!connectorOnline) {
                    term.writeln('\x1b[1;31m[!] Cannot execute command: connector is offline.\x1b[0m');
                    return;
                }
                client.send('power_action', { action });
                term.writeln(`\x1b[1;33m[*] Sending ${action} command...\x1b[0m`);
            }

            function updateUIStatus(status) {
                const nextStatus = String(status || '').toLowerCase();
                const previousStatus = currentServerStatus;
                currentServerStatus = nextStatus;
                renderProvisioningAccessState(nextStatus);

                const badge = document.getElementById('statusBadge');
                const text = document.getElementById('statusText');
                badge.className = `status-badge status-${nextStatus}`;
                text.textContent = nextStatus.toUpperCase();

                if (connectorOnline) {
                    const btnStart = document.getElementById('btnStart');
                    const btnRestart = document.getElementById('btnRestart');
                    const btnStop = document.getElementById('btnStop');
                    const btnKill = document.getElementById('btnKill');

                    if (nextStatus === 'running') {
                        btnStart.disabled = true;
                        btnRestart.disabled = false;
                        btnStop.disabled = false;
                        btnStop.classList.remove('d-none');
                        btnKill.disabled = false;
                        btnKill.classList.add('d-none');
                    } else if (nextStatus === 'stopping') {
                        btnStart.disabled = true;
                        btnRestart.disabled = true;
                        btnStop.disabled = true;
                        btnStop.classList.add('d-none');
                        btnKill.disabled = false;
                        btnKill.classList.remove('d-none');
                    } else {
                        btnStart.disabled = false;
                        btnRestart.disabled = true;
                        btnStop.disabled = true;
                        btnStop.classList.remove('d-none');
                        btnKill.disabled = true;
                        btnKill.classList.add('d-none');
                    }
                }

                if (previousStatus === nextStatus) return;
                if (nextStatus === 'running') {
                    clearReplayCache();
                }

                const provisioningContext = provisioningState.active || isProvisioningStatus(previousStatus) || isProvisioningStatus(nextStatus);
                if (provisioningContext) {
                    if (isProvisioningStatus(nextStatus)) {
                        activateProvisioning(isAdminConsoleViewer
                            ? 'Connector is provisioning the runtime container.'
                            : 'Your server is being created. This usually takes less than a minute.');
                    } else if (nextStatus === 'running') {
                        completeProvisioningStage('prepare', 'Ready');
                        completeProvisioningStage('install', 'Ready');
                        completeProvisioningStage('config', 'Applied');
                        completeProvisioningStage('container', 'Created');
                        completeProvisioningStage('start', 'Running', 'Provisioning finished. Server is running.');
                        setTimeout(() => {
                            if (currentServerStatus === 'running') {
                                deactivateProvisioning();
                            }
                        }, 2500);
                    } else if (nextStatus === 'error') {
                        failProvisioningStage('start', 'Provisioning error', 'Provisioning failed. Admins can inspect the detailed install activity above.');
                    }
                }

                if (nextStatus === 'running') {
                    term.writeln('\x1b[1;32m[✓] Server is now running.\x1b[0m');
                } else if (nextStatus === 'stopped') {
                    term.writeln('\x1b[1;31m[✗] Server has stopped.\x1b[0m');
                }
            }

            function updateConnectorStatus(online) {
                connectorOnline = online;
                const alert = document.getElementById('connectionAlert');
                const buttons = [
                    document.getElementById('btnStart'),
                    document.getElementById('btnRestart'),
                    document.getElementById('btnStop'),
                    document.getElementById('btnKill')
                ];
                const input = document.getElementById('consoleInput');

                if (online) {
                    alert.classList.add('d-none');
                    buttons.forEach(btn => btn.disabled = false);
                    input.disabled = false;
                } else {
                    alert.classList.remove('d-none');
                    buttons.forEach(btn => btn.disabled = true);
                    input.disabled = true;
                }
            }

            const handleResize = () => fitAddon.fit();
            window.addEventListener('resize', handleResize);

            let consoleRuntimeCleaned = false;
            function cleanupConsoleRuntime() {
                if (consoleRuntimeCleaned) return;
                consoleRuntimeCleaned = true;

                if (statusPollingTimer) {
                    clearInterval(statusPollingTimer);
                    statusPollingTimer = null;
                }

                try {
                    client.isExplicitDisconnect = true;
                    client.stopHeartbeat();
                    if (client.ws && (client.ws.readyState === WebSocket.OPEN || client.ws.readyState === WebSocket.CONNECTING)) {
                        client.ws.close(1000, 'Leaving console page');
                    }
                } catch (error) {
                    console.warn('Console cleanup warning:', error);
                }

                window.removeEventListener('resize', handleResize);
            }

            window.addEventListener('beforeunload', cleanupConsoleRuntime);
            document.addEventListener('turbo:before-cache', cleanupConsoleRuntime);
        </script>
        <%- include('../partials/modal-chat') %>
        <script>
            (() => {
                const aiEnabled = <%- JSON.stringify(aiChat && aiChat.enabled) %>;
                if (!aiEnabled) return;

                const serverId = <%- JSON.stringify(server.containerId) %>;
                const form = document.getElementById('rockyAiForm');
                const input = document.getElementById('rockyAiInput');
                const messages = document.getElementById('rockyAiMessages');
                const sendButton = document.getElementById('rockyAiSend');

                const appendMessage = (role, text) => {
                    const wrapper = document.createElement('div');
                    wrapper.className = `rocky-ai-message ${role}`;
                    wrapper.textContent = text;
                    messages.appendChild(wrapper);
                    messages.scrollTop = messages.scrollHeight;
                };

                const sendMessage = async () => {
                    const content = input.value.trim();
                    if (!content) return;
                    appendMessage('user', content);
                    input.value = '';
                    input.disabled = true;
                    if (sendButton) sendButton.disabled = true;

                    try {
                        const resp = await fetch(`/server/${serverId}/ai/chat`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ message: content })
                        });
                        const data = await resp.json();
                        if (!resp.ok || !data || !data.success) {
                            appendMessage('system', data && data.error ? data.error : 'AI request failed.');
                        } else {
                            appendMessage('assistant', data.reply || 'No response.');
                        }
                    } catch (err) {
                        appendMessage('system', 'AI request failed.');
                    } finally {
                        input.disabled = false;
                        if (sendButton) sendButton.disabled = false;
                        input.focus();
                    }
                };

                form?.addEventListener('submit', (event) => {
                    event.preventDefault();
                    sendMessage();
                });

                sendButton?.addEventListener('click', (event) => {
                    event.preventDefault();
                    sendMessage();
                });
            })();
        </script>
        <%- include('../partials/shortcuts-modal', { shortcutsId: 'consoleShortcutsModal', shortcutsTitle: 'Console Shortcuts', shortcutsList: consoleShortcuts }) %>
</body>

</html>
