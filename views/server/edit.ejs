<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="turbo-visit-control" content="reload">
    <title>
        Edit File | <%= server.name %> | <%= settings.brandName.toUpperCase() %>
    </title>
    <%- include('../partials/favicon') %>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
        <style>
            :root {
                --bg-dark: #0f0f12;
                --bg-darker: #0a0a0c;
                --bg-sidebar: #121216;
                --border-color: #2d2d35;
                --text-primary: #e1e1e6;
                --text-secondary: #8b8b9a;
                --accent-blue: #3b82f6;
                --accent-green: #10b981;
                --accent-red: #ef4444;
                --accent-yellow: #f59e0b;
            }

            body {
                background-color: var(--bg-dark);
                color: var(--text-primary);
                font-family: 'Inter', system-ui, -apple-system, sans-serif;
                overflow: hidden;
                height: 100vh;
                margin: 0;
            }

            .wrapper {
                display: flex;
                height: 100vh;
                overflow: hidden;
            }

            .sidebar {
                width: 260px;
                background: var(--bg-sidebar);
                border-right: 1px solid var(--border-color);
                transition: all 0.3s ease;
                display: flex;
                flex-direction: column;
                flex-shrink: 0;
                overflow-y: auto;
            }

            .sidebar.collapsed {
                margin-left: -260px;
            }

            .sidebar .sidebar-content {
                padding: 1.5rem 0.75rem;
            }

            .sidebar-item {
                display: flex;
                align-items: center;
                padding: 0.75rem 1rem;
                color: var(--text-secondary);
                text-decoration: none;
                border-radius: 8px;
                transition: all 0.2s ease;
                font-weight: 500;
                font-size: 0.9rem;
                margin-bottom: 0.25rem;
            }

            .sidebar-item:hover {
                background: rgba(255, 255, 255, 0.03);
                color: var(--text-primary);
            }

            .sidebar-item.active {
                background: rgba(59, 130, 246, 0.1);
                color: var(--accent-blue);
            }

            .sidebar-icon {
                margin-right: 12px;
                font-size: 1.1rem;
                width: 24px;
                text-align: center;
            }

            .content {
                flex: 1;
                display: flex;
                flex-direction: column;
                overflow: hidden;
                background: var(--bg-dark);
            }

            .top-navbar {
                background: var(--bg-sidebar);
                border-bottom: 1px solid var(--border-color);
                padding: 0.75rem 1.5rem;
                display: flex;
                align-items: center;
                flex-shrink: 0;
                justify-content: space-between;
            }

            .navbar-left {
                display: flex;
                align-items: center;
            }

            .navbar-toggle {
                background: transparent;
                border: none;
                color: var(--text-secondary);
                font-size: 1.5rem;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-right: 1rem;
                cursor: pointer;
                padding: 0;
            }

            .navbar-toggle:hover {
                color: var(--text-primary);
            }

            .file-info {
                display: flex;
                align-items: flex-start;
                gap: 0.75rem;
                flex-direction: column;
            }

            .file-name {
                font-size: 1.1rem;
                font-weight: 600;
                margin: 0;
                font-family: 'JetBrains Mono', monospace;
            }

            .file-meta-row {
                display: flex;
                align-items: center;
                flex-wrap: wrap;
                gap: 0.55rem;
            }

            .file-path-pill,
            .editor-chip {
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
                padding: 0.35rem 0.7rem;
                border-radius: 999px;
                border: 1px solid rgba(255, 255, 255, 0.08);
                background: rgba(255, 255, 255, 0.04);
                color: var(--text-secondary);
                font-size: 0.78rem;
                line-height: 1;
            }

            .navbar-right {
                display: flex;
                gap: 0.5rem;
                align-items: center;
                flex-wrap: wrap;
            }

            .btn-action {
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid var(--border-color);
                color: var(--text-primary);
                padding: 0.4rem 1rem;
                border-radius: 6px;
                font-size: 0.85rem;
                font-weight: 500;
                display: flex;
                align-items: center;
                gap: 0.5rem;
                transition: all 0.2s ease;
                text-decoration: none;
            }

            .btn-action:hover {
                background: rgba(255, 255, 255, 0.08);
                color: white;
            }

            .btn-action.active {
                background: rgba(59, 130, 246, 0.14);
                border-color: rgba(59, 130, 246, 0.45);
                color: #dbeafe;
            }

            .btn-action-primary {
                background: var(--accent-blue);
                border-color: var(--accent-blue);
                color: white;
            }

            .btn-action-primary:hover {
                background: #2563eb;
                border-color: #2563eb;
            }

            .editor-container {
                flex: 1;
                width: 100%;
                height: 100%;
                border-top: 1px solid rgba(255, 255, 255, 0.05);
                display: flex;
                min-height: 0;
            }

            .editor-tree-panel {
                width: 320px;
                background: linear-gradient(180deg, rgba(18, 18, 22, 0.98), rgba(12, 12, 16, 0.98));
                border-right: 1px solid var(--border-color);
                display: flex;
                flex-direction: column;
                flex-shrink: 0;
                min-width: 0;
            }

            .editor-tree-panel.d-none {
                display: none !important;
            }

            .editor-tree-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 0.75rem;
                padding: 0.85rem 1rem;
                border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            }

            .editor-tree-title {
                display: flex;
                flex-direction: column;
                gap: 0.2rem;
                min-width: 0;
            }

            .editor-tree-title strong {
                font-size: 0.88rem;
                color: var(--text-primary);
            }

            .editor-tree-title span {
                font-size: 0.76rem;
                color: var(--text-secondary);
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .editor-tree-body {
                flex: 1;
                overflow: auto;
                padding: 0.75rem;
            }

            .editor-tree-empty {
                color: var(--text-secondary);
                font-size: 0.84rem;
                padding: 0.75rem 0.5rem;
            }

            .editor-main {
                flex: 1;
                position: relative;
                min-width: 0;
            }

            #monaco-editor-container,
            #ace-editor-container,
            #plain-editor-container,
            #sqlite-editor-container {
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
            }

            #ace-editor-container.d-none,
            #monaco-editor-container.d-none,
            #plain-editor-container.d-none,
            #sqlite-editor-container.d-none {
                display: none !important;
            }

            #plain-editor {
                width: 100%;
                height: 100%;
                border: 0;
                outline: none;
                resize: none;
                background: var(--bg-dark);
                color: var(--text-primary);
                font-family: 'JetBrains Mono', 'Fira Code', monospace;
                font-size: 14px;
                line-height: 1.55;
                padding: 1rem;
            }

            #sqlite-editor-container {
                display: flex;
                flex-direction: column;
                background: var(--bg-dark);
                min-height: 0;
            }

            .sqlite-toolbar {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 0.75rem;
                padding: 0.9rem 1rem;
                border-bottom: 1px solid rgba(255, 255, 255, 0.06);
                background: rgba(255, 255, 255, 0.02);
                flex-wrap: wrap;
            }

            .sqlite-warning-banner {
                margin: 0.9rem 1rem 0;
                border: 1px solid rgba(245, 158, 11, 0.35);
                background: rgba(245, 158, 11, 0.12);
                color: #fde68a;
                border-radius: 12px;
                padding: 0.85rem 1rem;
                font-size: 0.84rem;
                line-height: 1.5;
            }

            .sqlite-toolbar-meta {
                display: flex;
                align-items: center;
                gap: 0.55rem;
                flex-wrap: wrap;
            }

            .sqlite-browser {
                flex: 1;
                min-height: 0;
                display: flex;
                overflow: hidden;
            }

            .sqlite-tables {
                width: 260px;
                border-right: 1px solid rgba(255, 255, 255, 0.06);
                background: rgba(255, 255, 255, 0.02);
                overflow: auto;
                padding: 0.85rem;
                flex-shrink: 0;
            }

            .sqlite-table-list {
                display: flex;
                flex-direction: column;
                gap: 0.45rem;
            }

            .sqlite-table-btn {
                width: 100%;
                border: 1px solid rgba(255, 255, 255, 0.08);
                background: rgba(255, 255, 255, 0.03);
                color: var(--text-secondary);
                border-radius: 10px;
                padding: 0.65rem 0.8rem;
                text-align: left;
                font-size: 0.84rem;
                transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
            }

            .sqlite-table-btn:hover,
            .sqlite-table-btn.active {
                background: rgba(59, 130, 246, 0.14);
                border-color: rgba(59, 130, 246, 0.35);
                color: #dbeafe;
            }

            .sqlite-grid {
                flex: 1;
                min-width: 0;
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }

            .sqlite-grid-header {
                padding: 0.85rem 1rem;
                border-bottom: 1px solid rgba(255, 255, 255, 0.06);
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 0.75rem;
                flex-wrap: wrap;
            }

            .sqlite-grid-controls {
                display: flex;
                align-items: center;
                gap: 0.6rem;
                flex-wrap: wrap;
            }

            .sqlite-search-input {
                min-width: 220px;
            }

            .sqlite-grid-body {
                flex: 1;
                overflow: auto;
                padding: 1rem;
            }

            .sqlite-empty {
                color: var(--text-secondary);
                font-size: 0.9rem;
                padding: 1rem;
            }

            .sqlite-table-wrap {
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 12px;
                overflow: hidden;
                background: rgba(255, 255, 255, 0.02);
            }

            .sqlite-insert-panel {
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 12px;
                background: rgba(255, 255, 255, 0.02);
                padding: 1rem;
                margin-bottom: 1rem;
            }

            .sqlite-insert-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
                gap: 0.75rem;
                margin-top: 0.85rem;
            }

            .sqlite-insert-field label {
                display: block;
                font-size: 0.78rem;
                color: var(--text-secondary);
                margin-bottom: 0.35rem;
            }

            .sqlite-row-actions {
                min-width: 78px !important;
                width: 78px;
            }

            .sqlite-table-view {
                margin: 0;
                color: var(--text-primary);
            }

            .sqlite-table-view th,
            .sqlite-table-view td {
                vertical-align: middle;
                background: transparent !important;
                border-color: rgba(255, 255, 255, 0.08);
                min-width: 160px;
            }

            .sqlite-rowid-col {
                min-width: 90px !important;
                color: var(--text-secondary);
                font-size: 0.76rem;
            }

            .sqlite-cell-editor {
                display: flex;
                align-items: center;
                gap: 0.45rem;
                min-width: 0;
            }

            .sqlite-cell-input {
                min-width: 0;
                font-family: 'JetBrains Mono', monospace;
                font-size: 0.82rem;
            }

            .sqlite-cell-null {
                border: 1px solid rgba(245, 158, 11, 0.3);
                background: rgba(245, 158, 11, 0.12);
                color: #fde68a;
                border-radius: 6px;
                padding: 0.3rem 0.45rem;
                font-size: 0.72rem;
                line-height: 1;
                flex-shrink: 0;
            }

            .sqlite-cell-null:hover {
                background: rgba(245, 158, 11, 0.18);
            }

            .sqlite-blob-pill {
                display: inline-flex;
                align-items: center;
                gap: 0.35rem;
                padding: 0.35rem 0.55rem;
                border-radius: 999px;
                background: rgba(239, 68, 68, 0.12);
                color: #fecaca;
                font-size: 0.72rem;
            }

            .sqlite-mode-lock {
                opacity: 0.7;
            }

            .loading-overlay {
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: var(--bg-dark);
                z-index: 10;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                transition: opacity 0.3s ease;
            }

            /* Monaco overrides */
            .monaco-editor,
            .monaco-editor .margin,
            .monaco-editor-background {
                background-color: var(--bg-dark) !important;
            }

            .tree-entry {
                display: block;
            }

            .tree-node {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                min-height: 36px;
                padding: 0.4rem 0.55rem;
                border-radius: 8px;
                color: var(--text-secondary);
                cursor: pointer;
                user-select: none;
                transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
                border: 1px solid transparent;
            }

            .tree-node:hover {
                background: rgba(255, 255, 255, 0.04);
                color: var(--text-primary);
            }

            .tree-node.active {
                background: rgba(59, 130, 246, 0.12);
                color: #bfdbfe;
                border-color: rgba(59, 130, 246, 0.35);
            }

            .tree-toggle {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 18px;
                min-width: 18px;
                color: var(--text-secondary);
            }

            .tree-icon {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 18px;
                min-width: 18px;
            }

            .tree-label {
                flex: 1;
                min-width: 0;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                font-size: 0.84rem;
            }

            .tree-children {
                margin-left: 1.35rem;
                border-left: 1px dashed rgba(255, 255, 255, 0.08);
                padding-left: 0.45rem;
            }

            @media (max-width: 900px) {
                .top-navbar {
                    align-items: flex-start;
                    flex-direction: column;
                    gap: 0.9rem;
                }

                .navbar-left,
                .navbar-right {
                    width: 100%;
                }

                .editor-tree-panel {
                    width: 260px;
                }
            }

            @media (max-width: 768px) {
                .editor-tree-panel {
                    display: none !important;
                }

                .sqlite-tables {
                    width: 190px;
                }

                .sqlite-search-input {
                    min-width: 160px;
                }
            }
        </style>
    <link rel="stylesheet" href="/css/mobile-layout.css">
</head>

<body data-turbo="false">
    <%- include ('../partials/error-modal') %>
        <div class="wrapper">
            <!-- Sidebar -->
            <nav id="sidebar" class="sidebar">
                <div class="sidebar-content">
                    <%- include('../partials/server-sidebar', { server, active: 'files' , settings }) %>
                </div>
            </nav>

            <!-- Main Content -->
            <div class="content">
                <!-- Top Navbar -->
                <div class="top-navbar">
                    <div class="navbar-left">
                        <button id="sidebarToggle" class="navbar-toggle">
                            <i class="bi bi-list"></i>
                        </button>
                        <div class="file-info">
                            <div class="file-meta-row">
                                <a href="/server/<%= server.containerId %>/files"
                                    class="text-secondary text-decoration-none hover-white">
                                    <i class="bi bi-arrow-left me-1"></i> Files
                                </a>
                                <span class="text-secondary opacity-50">/</span>
                                <span class="file-name" id="displayFileName">Loading...</span>
                                <span class="badge bg-warning text-dark d-none" id="unsavedBadge">UNSAVED</span>
                            </div>
                            <div class="file-meta-row">
                                <span class="file-path-pill" id="displayFilePath">
                                    <i class="bi bi-folder2-open"></i>
                                    <span>Loading path...</span>
                                </span>
                                <span class="editor-chip" id="editorLanguageChip">
                                    <i class="bi bi-code-slash"></i>
                                    <span>plaintext</span>
                                </span>
                                <span class="editor-chip" id="editorLengthChip">
                                    <i class="bi bi-file-earmark-text"></i>
                                    <span>0 chars</span>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="navbar-right">
                        <select class="form-select form-select-sm bg-dark text-light border-secondary" id="editorModeSelect" style="width: 140px;">
                            <option value="monaco">Monaco</option>
                            <option value="ace">Ace</option>
                            <option value="plain">Plain Text</option>
                            <option value="sqlite">SQLite</option>
                        </select>
                        <button type="button" class="btn-action" id="btnToggleTreeView">
                            <i class="bi bi-diagram-3"></i>
                            Tree
                        </button>
                        <button type="button" class="btn-action" id="btnWordWrapToggle">
                            <i class="bi bi-text-wrap"></i>
                            Wrap On
                        </button>
                        <button type="button" class="btn-action" id="btnReturn">
                            Return
                        </button>
                        <button type="button" class="btn-action btn-action-primary px-4 fw-bold" id="btnSave">
                            <span class="spinner-border spinner-border-sm d-none me-2" role="status" aria-hidden="true"
                                id="saveSpinner"></span>
                            <i class="bi bi-save me-2" id="saveIcon"></i>Save File
                        </button>
                    </div>
                </div>

                <!-- Editor Area -->
                <div class="editor-container">
                    <aside class="editor-tree-panel d-none" id="editorTreePanel">
                        <div class="editor-tree-header">
                            <div class="editor-tree-title">
                                <strong>Quick Tree</strong>
                                <span id="editorTreeCurrentPath">/</span>
                            </div>
                            <button type="button" class="btn-action px-2 py-1" id="btnRefreshEditorTree" title="Refresh tree">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                        </div>
                        <div class="editor-tree-body" id="editorTreeBody">
                            <div class="editor-tree-empty">Tree disabled.</div>
                        </div>
                    </aside>
                    <div class="editor-main">
                        <div class="loading-overlay" id="loadingOverlay">
                            <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                            </div>
                            <h5 class="text-secondary fw-medium">Loading File Contents...</h5>
                        </div>
                        <div id="monaco-editor-container"></div>
                        <div id="ace-editor-container" class="d-none"></div>
                        <div id="plain-editor-container" class="d-none">
                            <textarea id="plain-editor" spellcheck="false"></textarea>
                        </div>
                        <div id="sqlite-editor-container" class="d-none">
                            <div class="sqlite-toolbar">
                                <div class="sqlite-toolbar-meta">
                                    <span class="editor-chip" id="sqliteDatabaseChip">
                                        <i class="bi bi-database"></i>
                                        <span>SQLite database</span>
                                    </span>
                                    <span class="editor-chip" id="sqliteTableCountChip">
                                        <i class="bi bi-table"></i>
                                        <span>0 tables</span>
                                    </span>
                                    <span class="editor-chip" id="sqliteRowMetaChip">
                                        <i class="bi bi-grid-3x3-gap"></i>
                                        <span>No table selected</span>
                                    </span>
                                </div>
                                <div class="sqlite-toolbar-meta">
                                    <span class="editor-chip">
                                        <i class="bi bi-exclamation-triangle"></i>
                                        <span>Editing first 200 rows per table</span>
                                    </span>
                                </div>
                            </div>
                            <div class="sqlite-warning-banner d-none" id="sqliteWarningBanner"></div>
                            <div class="sqlite-browser">
                                <aside class="sqlite-tables">
                                    <div class="sqlite-table-list" id="sqliteTablesList">
                                        <div class="sqlite-empty">No tables loaded yet.</div>
                                    </div>
                                </aside>
                                <section class="sqlite-grid">
                                    <div class="sqlite-grid-header">
                                        <div class="editor-chip" id="sqliteCurrentTableChip">
                                            <i class="bi bi-table"></i>
                                            <span>No table selected</span>
                                        </div>
                                        <div class="sqlite-grid-controls">
                                            <input type="search" class="form-control form-control-sm bg-dark text-light border-secondary sqlite-search-input" id="sqliteSearchInput" placeholder="Search current table">
                                            <button type="button" class="btn-action px-2 py-1" id="btnClearSQLiteSearch" title="Clear search">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                            <button type="button" class="btn-action px-2 py-1" id="btnInsertSQLiteRow" title="Insert row">
                                                <i class="bi bi-plus-lg"></i>
                                                Row
                                            </button>
                                        </div>
                                    </div>
                                    <div class="sqlite-grid-body" id="sqliteGridBody">
                                        <div class="sqlite-empty">Open a SQLite file to inspect its tables.</div>
                                    </div>
                                </section>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" data-turbo-eval="false"></script>
        <script src="https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs/loader.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/ace-builds@1.32.6/src-min-noconflict/ace.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sql.js@1.13.0/dist/sql-wasm.js"></script>

        <script>
            // Parse Hash for file path
            function getFilePathFromHash() {
                const hash = window.location.hash;
                if (hash.startsWith('#file=')) {
                    return decodeURIComponent(hash.substring(6));
                }
                return null;
            }

            const initialFilePath = getFilePathFromHash();
            if (!initialFilePath) {
                window.location.href = `/server/<%= server.containerId %>/files`;
            }

            // Return Button
            document.getElementById('btnReturn').addEventListener('click', () => {
                const parentDir = getCurrentDirectoryPath();
                window.location.href = `/server/<%= server.containerId %>/files?path=${encodeURIComponent(parentDir)}`;
            });

            // Handle Ctrl+S
            document.addEventListener('keydown', e => {
                if (e.ctrlKey && e.key === 's') {
                    e.preventDefault();
                    document.getElementById('btnSave').click();
                }
            });

            // WebSocket & Editor Init
            const serverId = '<%= server.containerId %>';
            const wsToken = '<%= wsToken %>';
            const wsUrl = window.location.protocol.replace('http', 'ws') + '//' + window.location.host + '/ws/server/' + serverId + '?token=' + encodeURIComponent(wsToken);

            let ws;
            let monacoEditor;
            let aceEditor;
            let currentContent = '';
            let isUnsaved = false;
            let fileLanguage = 'plaintext';
            let currentFilePath = initialFilePath;
            let activeEditorMode = 'monaco';
            const wordWrapSettingKey = `cpanel_editor_wrap_${serverId}`;
            let wordWrapEnabled = localStorage.getItem(wordWrapSettingKey) !== '0';
            const treeViewSettingKey = `cpanel_editor_tree_${serverId}`;
            const editorModeSettingKey = `cpanel_editor_mode_${serverId}`;
            let treeViewEnabled = false;
            const treeCache = new Map();
            const treeExpandedPaths = new Set();
            const treeLoadingPaths = new Set();
            const sqliteExtensions = new Set(['sqlite', 'sqlite3', 'db', 'db3']);
            let sqlJsPromise = null;
            let sqliteDb = null;
            let sqliteOriginalBase64 = '';
            let sqliteCurrentTable = '';
            let sqliteTableNames = [];
            let sqliteTableColumns = [];
            let sqliteTableRows = [];
            let sqliteTableEditable = false;
            let sqliteTableTotalRows = 0;
            let sqliteSearchTerm = '';
            let sqliteSearchDebounceTimer = null;
            let sqliteJournalMode = '';
            let sqliteViewerWarning = '';
            let sqliteLoadError = '';
            let sqliteRawPreview = '';
            let fileReadOnly = false;
            let fileReadOnlyReason = '';

            function escapeHtml(value) {
                return String(value || '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function escapeCssAttributeValue(value) {
                if (window.CSS && typeof window.CSS.escape === 'function') {
                    return window.CSS.escape(String(value || ''));
                }
                return String(value || '').replace(/["\\]/g, '\\$&');
            }

            function normalizeServerPath(pathValue) {
                const raw = String(pathValue || '/').trim() || '/';
                let normalized = raw.startsWith('/') ? raw : `/${raw}`;
                normalized = normalized.replace(/\/+/g, '/');
                if (normalized.length > 1 && normalized.endsWith('/')) {
                    normalized = normalized.slice(0, -1);
                }
                return normalized || '/';
            }

            function joinServerPath(parentPath, entryName) {
                const base = normalizeServerPath(parentPath);
                return base === '/' ? `/${entryName}` : `${base}/${entryName}`;
            }

            function sortFileEntries(entries) {
                return (Array.isArray(entries) ? [...entries] : []).sort((a, b) => {
                    if (a.isDirectory && !b.isDirectory) return -1;
                    if (!a.isDirectory && b.isDirectory) return 1;
                    return String(a.name || '').localeCompare(String(b.name || ''));
                });
            }

            async function fetchTreeEntries(path, force = false) {
                const normalizedPath = normalizeServerPath(path);
                if (!force && treeCache.has(normalizedPath)) {
                    return treeCache.get(normalizedPath);
                }
                treeLoadingPaths.add(normalizedPath);
                renderTreeView();
                try {
                    const response = await fetch(`/server/${serverId}/files-fetch?path=${encodeURIComponent(normalizedPath)}`);
                    if (!response.ok) {
                        throw new Error(`Failed to load path ${normalizedPath}`);
                    }
                    const data = await response.json();
                    const files = sortFileEntries(Array.isArray(data.files) ? data.files : []);
                    treeCache.set(normalizedPath, files);
                    return files;
                } catch (error) {
                    console.warn('Editor tree fetch failed:', error);
                    return treeCache.get(normalizedPath) || [];
                } finally {
                    treeLoadingPaths.delete(normalizedPath);
                    renderTreeView();
                }
            }

            async function ensureTreeContext(path) {
                if (!treeViewEnabled) return;
                const normalizedPath = normalizeServerPath(path);
                const segments = normalizedPath.split('/').filter(Boolean);
                let walker = '/';
                treeExpandedPaths.add('/');
                await fetchTreeEntries('/', false);
                for (const segment of segments) {
                    const nextPath = walker === '/' ? `/${segment}` : `${walker}/${segment}`;
                    treeExpandedPaths.add(walker);
                    await fetchTreeEntries(walker, false);
                    walker = nextPath;
                }
                if (normalizedPath !== '/') {
                    treeExpandedPaths.add(normalizedPath);
                    await fetchTreeEntries(normalizedPath, false);
                }
                renderTreeView();
            }

            function getCurrentDirectoryPath() {
                const normalized = normalizeServerPath(currentFilePath);
                const lastSlash = normalized.lastIndexOf('/');
                if (lastSlash <= 0) return '/';
                return normalized.slice(0, lastSlash);
            }

            function renderTreeChildren(parentPath, entries) {
                const normalizedParent = normalizeServerPath(parentPath);
                return sortFileEntries(entries).map((entry) => {
                    const entryName = String(entry && entry.name || '');
                    const childPath = joinServerPath(normalizedParent, entryName);
                    const isDirectory = Boolean(entry && entry.isDirectory);
                    const isExpanded = isDirectory && treeExpandedPaths.has(childPath);
                    const isActive = normalizeServerPath(currentFilePath) === childPath;
                    const loading = treeLoadingPaths.has(childPath);
                    return `
                        <div class="tree-entry">
                            <div class="tree-node ${isActive ? 'active' : ''}" data-tree-path="${escapeHtml(childPath)}" data-tree-type="${isDirectory ? 'directory' : 'file'}">
                                <span class="tree-toggle" data-tree-toggle="${escapeHtml(childPath)}">${isDirectory ? `<i class="bi ${isExpanded ? 'bi-caret-down-fill' : 'bi-caret-right-fill'}"></i>` : '<i class="bi bi-dot"></i>'}</span>
                                <span class="tree-icon"><i class="bi ${isDirectory ? 'bi-folder-fill text-warning' : 'bi-file-earmark-text text-info'}"></i></span>
                                <span class="tree-label">${escapeHtml(entryName)}</span>
                                ${loading ? '<span class="spinner-border spinner-border-sm text-secondary ms-auto" role="status"></span>' : ''}
                            </div>
                            ${isDirectory && isExpanded ? `<div class="tree-children">${renderTreeChildren(childPath, treeCache.get(childPath) || [])}</div>` : ''}
                        </div>
                    `;
                }).join('');
            }

            function renderTreeView() {
                const panel = document.getElementById('editorTreePanel');
                const body = document.getElementById('editorTreeBody');
                const currentPathLabel = document.getElementById('editorTreeCurrentPath');
                const toggleBtn = document.getElementById('btnToggleTreeView');
                if (!panel || !body || !toggleBtn) return;

                const treeAllowed = treeViewEnabled && window.innerWidth > 768;
                panel.classList.toggle('d-none', !treeAllowed);
                toggleBtn.classList.toggle('active', treeViewEnabled);

                if (currentPathLabel) {
                    currentPathLabel.textContent = normalizeServerPath(currentFilePath);
                }

                if (!treeAllowed) {
                    setTimeout(layoutActiveEditor, 20);
                    return;
                }

                const rootEntries = treeCache.get('/') || [];
                if (!rootEntries.length && treeLoadingPaths.has('/')) {
                    body.innerHTML = '<div class="editor-tree-empty">Loading tree...</div>';
                    return;
                }

                body.innerHTML = `
                    <div class="tree-node" data-tree-path="/" data-tree-type="directory">
                        <span class="tree-toggle" data-tree-toggle="/"><i class="bi ${treeExpandedPaths.has('/') ? 'bi-caret-down-fill' : 'bi-caret-right-fill'}"></i></span>
                        <span class="tree-icon"><i class="bi bi-hdd-stack-fill text-info"></i></span>
                        <span class="tree-label">/root</span>
                    </div>
                    ${treeExpandedPaths.has('/') ? `<div class="tree-children">${renderTreeChildren('/', rootEntries)}</div>` : ''}
                `;

                setTimeout(layoutActiveEditor, 20);
            }

            function goToFilePath(targetPath) {
                const normalizedTarget = normalizeServerPath(targetPath);
                if (normalizeServerPath(currentFilePath) === normalizedTarget) return;
                if (isUnsaved) {
                    const proceed = window.confirm('You have unsaved changes. Leave this file anyway?');
                    if (!proceed) return;
                }
                window.location.hash = `file=${encodeURIComponent(normalizedTarget)}`;
            }

            function guessLanguage(fileExtension) {
                const ext = String(fileExtension || '').toLowerCase();
                if (['json'].includes(ext)) return 'json';
                if (['js', 'jsx', 'ts', 'tsx'].includes(ext)) return 'javascript';
                if (['html', 'htm'].includes(ext)) return 'html';
                if (['css', 'scss', 'less'].includes(ext)) return 'css';
                if (['yml', 'yaml'].includes(ext)) return 'yaml';
                if (['xml'].includes(ext)) return 'xml';
                if (['md', 'markdown'].includes(ext)) return 'markdown';
                if (['sh', 'bash'].includes(ext)) return 'shell';
                if (['py'].includes(ext)) return 'python';
                if (['php'].includes(ext)) return 'php';
                return 'plaintext';
            }

            function guessAceMode(languageName) {
                const lang = String(languageName || 'text').toLowerCase();
                if (lang === 'javascript') return 'javascript';
                if (lang === 'json') return 'json';
                if (lang === 'html') return 'html';
                if (lang === 'css') return 'css';
                if (lang === 'yaml') return 'yaml';
                if (lang === 'xml') return 'xml';
                if (lang === 'markdown') return 'markdown';
                if (lang === 'shell') return 'sh';
                if (lang === 'python') return 'python';
                if (lang === 'php') return 'php';
                return 'text';
            }

            function getSQLiteFileInfo(pathValue) {
                const normalized = normalizeServerPath(pathValue);
                const fileName = normalized.split('/').pop() || '';
                const lowerName = fileName.toLowerCase();
                const sidecarSuffix = lowerName.endsWith('-wal') ? '-wal' : (lowerName.endsWith('-shm') ? '-shm' : '');
                const candidateName = sidecarSuffix ? fileName.slice(0, -sidecarSuffix.length) : fileName;
                const dotIndex = candidateName.lastIndexOf('.');
                if (dotIndex === -1) {
                    return {
                        isSQLite: false,
                        isSidecar: false,
                        sidecarType: '',
                        basePath: normalized,
                        targetPath: normalized,
                        extension: ''
                    };
                }

                const ext = candidateName.slice(dotIndex + 1).toLowerCase();
                const isSQLite = sqliteExtensions.has(ext);
                const basePath = sidecarSuffix
                    ? `${normalized.slice(0, -fileName.length)}${candidateName}`
                    : normalized;

                return {
                    isSQLite,
                    isSidecar: Boolean(isSQLite && sidecarSuffix),
                    sidecarType: sidecarSuffix ? sidecarSuffix.slice(1) : '',
                    basePath,
                    targetPath: isSQLite ? basePath : normalized,
                    extension: ext
                };
            }

            function isSQLitePath(pathValue) {
                return getSQLiteFileInfo(pathValue).isSQLite;
            }

            function getSQLiteTargetPath(pathValue) {
                return getSQLiteFileInfo(pathValue).targetPath;
            }

            function quoteSqlIdentifier(identifier) {
                return `"${String(identifier || '').replace(/"/g, '""')}"`;
            }

            function base64ToUint8Array(base64Value) {
                const normalized = String(base64Value || '').trim();
                const binary = window.atob(normalized);
                const bytes = new Uint8Array(binary.length);
                for (let index = 0; index < binary.length; index += 1) {
                    bytes[index] = binary.charCodeAt(index);
                }
                return bytes;
            }

            function uint8ArrayToBase64(bytes) {
                const source = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes || []);
                let binary = '';
                const chunkSize = 0x8000;
                for (let offset = 0; offset < source.length; offset += chunkSize) {
                    const chunk = source.subarray(offset, offset + chunkSize);
                    binary += String.fromCharCode(...chunk);
                }
                return window.btoa(binary);
            }

            function decodeBase64ToText(base64Value) {
                const bytes = base64ToUint8Array(base64Value);
                try {
                    return new TextDecoder('utf-8', { fatal: false }).decode(bytes);
                } catch {
                    let text = '';
                    for (let index = 0; index < bytes.length; index += 1) {
                        text += String.fromCharCode(bytes[index]);
                    }
                    return text;
                }
            }

            function setReadOnlyState(nextValue, reason = '') {
                fileReadOnly = Boolean(nextValue);
                fileReadOnlyReason = fileReadOnly ? String(reason || '').trim() : '';

                if (monacoEditor) {
                    monacoEditor.updateOptions({ readOnly: fileReadOnly });
                }
                if (aceEditor && typeof aceEditor.setReadOnly === 'function') {
                    aceEditor.setReadOnly(fileReadOnly);
                }
                const plainEditor = document.getElementById('plain-editor');
                if (plainEditor) {
                    plainEditor.readOnly = fileReadOnly;
                }

                const saveBtn = document.getElementById('btnSave');
                if (saveBtn) {
                    saveBtn.disabled = fileReadOnly;
                    saveBtn.classList.toggle('disabled', fileReadOnly);
                    saveBtn.title = fileReadOnlyReason || '';
                }
            }

            function syncEditorModeAvailability() {
                const select = document.getElementById('editorModeSelect');
                const saveBtn = document.getElementById('btnSave');
                const wordWrapBtn = document.getElementById('btnWordWrapToggle');
                const databaseChip = document.getElementById('sqliteDatabaseChip');
                if (!select) return;
                const sqliteInfo = getSQLiteFileInfo(currentFilePath);
                const sqliteMode = sqliteInfo.isSQLite;
                Array.from(select.options).forEach((option) => {
                    if (option.value === 'sqlite') {
                        option.disabled = !sqliteMode;
                        option.hidden = !sqliteMode;
                    }
                });
                select.classList.toggle('sqlite-mode-lock', sqliteMode);
                if (!sqliteMode && activeEditorMode === 'sqlite') {
                    activeEditorMode = 'monaco';
                }
                select.value = activeEditorMode;
                if (saveBtn) {
                    saveBtn.innerHTML = `
                        <span class="spinner-border spinner-border-sm d-none me-2" role="status" aria-hidden="true" id="saveSpinner"></span>
                        <i class="bi ${activeEditorMode === 'sqlite' ? 'bi-database-check' : 'bi-save'} me-2" id="saveIcon"></i>${activeEditorMode === 'sqlite' ? 'Save Database' : 'Save File'}
                    `;
                    saveBtn.disabled = fileReadOnly;
                    saveBtn.classList.toggle('disabled', fileReadOnly);
                    saveBtn.title = fileReadOnlyReason || '';
                }
                if (wordWrapBtn) {
                    const disableWrap = activeEditorMode === 'sqlite';
                    wordWrapBtn.disabled = disableWrap;
                    wordWrapBtn.classList.toggle('opacity-50', disableWrap);
                    wordWrapBtn.classList.toggle('disabled', disableWrap);
                }
                if (databaseChip) {
                    const text = databaseChip.querySelector('span');
                    if (text) {
                        if (sqliteInfo.isSidecar) {
                            text.textContent = `SQLite via ${sqliteInfo.sidecarType.toUpperCase()} sidecar`;
                        } else {
                            text.textContent = 'SQLite database';
                        }
                    }
                    databaseChip.title = sqliteInfo.isSidecar
                        ? `Opened from companion file ${currentFilePath}, reading main database ${sqliteInfo.basePath}`
                        : currentFilePath;
                }
            }

            async function ensureSqlJs() {
                if (sqlJsPromise) return sqlJsPromise;
                if (typeof window.initSqlJs !== 'function') {
                    throw new Error('sql.js is unavailable in this browser session.');
                }
                sqlJsPromise = window.initSqlJs({
                    locateFile: (file) => `https://cdn.jsdelivr.net/npm/sql.js@1.13.0/dist/${file}`
                });
                return sqlJsPromise;
            }

            function formatSQLiteCellValue(value) {
                if (value === null || value === undefined) return '';
                if (value instanceof Uint8Array) return `[BLOB ${value.length} bytes]`;
                return String(value);
            }

            function coerceSQLiteInputValue(rawValue, declaredType) {
                if (rawValue === null || rawValue === undefined) return null;
                const normalizedType = String(declaredType || '').toUpperCase();
                const value = String(rawValue);
                if (normalizedType.includes('INT')) {
                    const parsedInt = Number.parseInt(value, 10);
                    return Number.isFinite(parsedInt) ? parsedInt : value;
                }
                if (normalizedType.includes('REAL') || normalizedType.includes('FLOA') || normalizedType.includes('DOUB') || normalizedType.includes('NUM')) {
                    const parsedFloat = Number.parseFloat(value);
                    return Number.isFinite(parsedFloat) ? parsedFloat : value;
                }
                return value;
            }

            function renderSQLiteTableList() {
                const listEl = document.getElementById('sqliteTablesList');
                const countChip = document.getElementById('sqliteTableCountChip');
                const warningBanner = document.getElementById('sqliteWarningBanner');
                if (countChip) {
                    const countText = countChip.querySelector('span');
                    if (countText) countText.textContent = `${sqliteTableNames.length} table${sqliteTableNames.length === 1 ? '' : 's'}`;
                }
                if (warningBanner) {
                    if (sqliteViewerWarning) {
                        warningBanner.classList.remove('d-none');
                        warningBanner.innerHTML = sqliteViewerWarning;
                    } else {
                        warningBanner.classList.add('d-none');
                        warningBanner.innerHTML = '';
                    }
                }
                if (!listEl) return;
                if (!sqliteTableNames.length) {
                    const sqliteInfo = getSQLiteFileInfo(currentFilePath);
                    listEl.innerHTML = `
                        <div class="sqlite-empty">
                            This database has no user tables visible.
                            ${sqliteInfo.isSidecar ? '<br><br>Note: this file is a WAL/SHM sidecar. The viewer reads the main database file and may miss live WAL-only changes.' : '<br><br>If this server uses WAL mode, recent data may still live in the companion <code>-wal</code> file.'}
                            <br><br>You can switch the editor dropdown back to <strong>Monaco</strong>, <strong>Ace</strong>, or <strong>Plain Text</strong> to inspect the raw file.
                        </div>
                    `;
                    return;
                }
                listEl.innerHTML = sqliteTableNames.map((tableName) => `
                    <button type="button" class="sqlite-table-btn ${sqliteCurrentTable === tableName ? 'active' : ''}" data-sqlite-table="${escapeHtml(tableName)}">
                        <i class="bi bi-table me-2"></i>${escapeHtml(tableName)}
                    </button>
                `).join('');
            }

            function renderSQLiteGrid() {
                const gridBody = document.getElementById('sqliteGridBody');
                const tableChip = document.getElementById('sqliteCurrentTableChip');
                const rowMetaChip = document.getElementById('sqliteRowMetaChip');
                const searchInput = document.getElementById('sqliteSearchInput');
                const insertBtn = document.getElementById('btnInsertSQLiteRow');
                if (tableChip) {
                    const text = tableChip.querySelector('span');
                    if (text) text.textContent = sqliteCurrentTable || 'No table selected';
                }
                if (searchInput && searchInput.value !== sqliteSearchTerm) {
                    searchInput.value = sqliteSearchTerm;
                }
                if (insertBtn) {
                    insertBtn.disabled = !sqliteCurrentTable || !sqliteTableEditable;
                    insertBtn.classList.toggle('disabled', insertBtn.disabled);
                }
                if (rowMetaChip) {
                    const text = rowMetaChip.querySelector('span');
                    if (text) {
                        if (!sqliteCurrentTable) {
                            text.textContent = 'No table selected';
                        } else if (sqliteSearchTerm) {
                            text.textContent = `${Math.min(sqliteTableRows.length, 200)} visible / ${sqliteTableTotalRows} matching rows · ${sqliteTableEditable ? 'Editable' : 'Read-only'}`;
                        } else {
                            text.textContent = `${Math.min(sqliteTableRows.length, 200)} visible / ${sqliteTableTotalRows} rows · ${sqliteTableEditable ? 'Editable' : 'Read-only'}`;
                        }
                    }
                }
                if (!gridBody) return;
                if (sqliteLoadError) {
                    gridBody.innerHTML = `
                        <div class="sqlite-empty">
                            ${escapeHtml(sqliteLoadError)}
                            <br><br>This file stays in SQLite viewer mode, but editing is disabled.
                        </div>
                        <div class="sqlite-table-wrap">
                            <textarea class="form-control bg-dark text-light border-0 rounded-0" style="min-height:420px; font-family:'JetBrains Mono', monospace;" readonly>${escapeHtml(sqliteRawPreview)}</textarea>
                        </div>
                    `;
                    return;
                }
                if (!sqliteCurrentTable) {
                    gridBody.innerHTML = `
                        <div class="sqlite-empty">
                            Select a table from the left to inspect its rows.
                            ${sqliteTableNames.length ? '' : '<br><br>No table list was detected. Try a raw editor mode if you need to inspect the underlying bytes/text.'}
                        </div>
                    `;
                    return;
                }
                if (!sqliteTableRows.length) {
                    gridBody.innerHTML = `
                        ${sqliteTableEditable ? renderSQLiteInsertPanel() : ''}
                        <div class="sqlite-empty">${sqliteSearchTerm ? 'No rows match the current search.' : 'This table has no rows to display.'}</div>
                    `;
                    return;
                }

                const headerColumns = sqliteTableColumns.map((column) => `<th>${escapeHtml(column.name)}</th>`).join('');
                const bodyRows = sqliteTableRows.map((row) => {
                    const rowIdCell = `<td class="sqlite-rowid-col">${escapeHtml(row.__cpanelRowId)}</td>`;
                    const cells = sqliteTableColumns.map((column) => {
                        const rawValue = row[column.name];
                        if (rawValue instanceof Uint8Array) {
                            return `<td><span class="sqlite-blob-pill"><i class="bi bi-file-binary"></i> BLOB ${rawValue.length}b</span></td>`;
                        }
                        const safeValue = rawValue === null || rawValue === undefined ? '' : String(rawValue);
                        const nullButton = sqliteTableEditable
                            ? `<button type="button" class="sqlite-cell-null" data-sqlite-null="1" data-rowid="${escapeHtml(row.__cpanelRowId)}" data-column="${escapeHtml(column.name)}">NULL</button>`
                            : '';
                        return `
                            <td>
                                <div class="sqlite-cell-editor">
                                    <input
                                        type="text"
                                        class="form-control form-control-sm bg-dark text-light border-secondary sqlite-cell-input"
                                        value="${escapeHtml(safeValue)}"
                                        data-rowid="${escapeHtml(row.__cpanelRowId)}"
                                        data-column="${escapeHtml(column.name)}"
                                        data-coltype="${escapeHtml(column.type || '')}"
                                        ${sqliteTableEditable ? '' : 'disabled'}
                                    >
                                    ${nullButton}
                                </div>
                            </td>
                        `;
                    }).join('');
                    const deleteCell = sqliteTableEditable
                        ? `
                            <td class="sqlite-row-actions">
                                <button type="button" class="btn-action px-2 py-1 text-danger border-danger-subtle" data-sqlite-delete-row="${escapeHtml(row.__cpanelRowId)}" title="Delete row">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        `
                        : '<td class="sqlite-row-actions text-secondary small">locked</td>';
                    return `<tr>${rowIdCell}${cells}${deleteCell}</tr>`;
                }).join('');

                gridBody.innerHTML = `
                    ${sqliteTableEditable ? renderSQLiteInsertPanel() : ''}
                    <div class="sqlite-table-wrap">
                        <div class="table-responsive">
                            <table class="table table-dark table-sm sqlite-table-view">
                                <thead>
                                    <tr>
                                        <th class="sqlite-rowid-col">rowid</th>
                                        ${headerColumns}
                                        <th class="sqlite-row-actions">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${bodyRows}
                                </tbody>
                            </table>
                        </div>
                    </div>
                `;
            }

            function renderSQLiteInsertPanel() {
                if (!sqliteCurrentTable || !sqliteTableEditable) return '';
                const fields = sqliteTableColumns.map((column) => `
                    <div class="sqlite-insert-field">
                        <label for="sqlite_insert_${escapeHtml(column.name)}">${escapeHtml(column.name)}${column.type ? ` <span class="text-secondary">(${escapeHtml(column.type)})</span>` : ''}</label>
                        <input
                            type="text"
                            class="form-control form-control-sm bg-dark text-light border-secondary sqlite-insert-input"
                            id="sqlite_insert_${escapeHtml(column.name)}"
                            data-column="${escapeHtml(column.name)}"
                            data-coltype="${escapeHtml(column.type || '')}"
                            placeholder="blank = default/NULL"
                        >
                    </div>
                `).join('');
                return `
                    <div class="sqlite-insert-panel">
                        <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                            <div>
                                <div class="fw-semibold">Insert Row</div>
                                <div class="text-secondary small">Leave a field blank to let SQLite use DEFAULT or NULL.</div>
                            </div>
                            <button type="button" class="btn-action px-3 py-2" id="btnSubmitSQLiteInsert">
                                <i class="bi bi-plus-circle"></i>
                                Insert Row
                            </button>
                        </div>
                        <div class="sqlite-insert-grid">
                            ${fields || '<div class="sqlite-empty">This table has no editable columns.</div>'}
                        </div>
                    </div>
                `;
            }

            function buildSQLiteSearchQuery(columns, rawSearchTerm) {
                const searchTerm = String(rawSearchTerm || '').trim();
                if (!searchTerm) {
                    return { whereClause: '', params: [] };
                }
                const expressions = columns.map((column) => `COALESCE(CAST(${quoteSqlIdentifier(column.name)} AS TEXT), '')`);
                if (!expressions.length) {
                    return { whereClause: '', params: [] };
                }
                const searchExpression = expressions.join(` || ' ' || `);
                return {
                    whereClause: ` WHERE (${searchExpression}) LIKE ? COLLATE NOCASE`,
                    params: [`%${searchTerm}%`]
                };
            }

            async function loadSQLiteTable(tableName, options = {}) {
                const normalizedTable = String(tableName || '').trim();
                if (Object.prototype.hasOwnProperty.call(options, 'searchTerm')) {
                    sqliteSearchTerm = String(options.searchTerm || '').trim();
                }
                sqliteCurrentTable = normalizedTable;
                renderSQLiteTableList();
                if (!sqliteDb || !normalizedTable) {
                    sqliteTableColumns = [];
                    sqliteTableRows = [];
                    sqliteTableEditable = false;
                    sqliteTableTotalRows = 0;
                    renderSQLiteGrid();
                    return;
                }

                const tableIdentifier = quoteSqlIdentifier(normalizedTable);
                const infoResult = sqliteDb.exec(`PRAGMA table_info(${tableIdentifier})`);
                sqliteTableColumns = (infoResult[0] && Array.isArray(infoResult[0].values))
                    ? infoResult[0].values.map((entry) => ({
                        cid: entry[0],
                        name: String(entry[1] || ''),
                        type: String(entry[2] || ''),
                        notNull: Boolean(entry[3]),
                        defaultValue: entry[4],
                        primaryKey: Boolean(entry[5])
                    }))
                    : [];

                let rowResult = [];
                let tableEditable = true;
                const searchQuery = buildSQLiteSearchQuery(sqliteTableColumns, sqliteSearchTerm);
                try {
                    const rowStatement = sqliteDb.prepare(`SELECT rowid AS __cpanelRowId, * FROM ${tableIdentifier}${searchQuery.whereClause} LIMIT 200`);
                    try {
                        rowStatement.bind(searchQuery.params);
                        const values = [];
                        const columns = rowStatement.getColumnNames();
                        while (rowStatement.step()) {
                            values.push(rowStatement.get());
                        }
                        rowResult = values.length ? [{ columns, values }] : [];
                    } finally {
                        rowStatement.free();
                    }
                } catch (error) {
                    console.warn('SQLite rowid mode unavailable, falling back to read-only table view:', error);
                    tableEditable = false;
                    const readOnlyStatement = sqliteDb.prepare(`SELECT * FROM ${tableIdentifier}${searchQuery.whereClause} LIMIT 200`);
                    try {
                        readOnlyStatement.bind(searchQuery.params);
                        const values = [];
                        const columns = readOnlyStatement.getColumnNames();
                        while (readOnlyStatement.step()) {
                            values.push(readOnlyStatement.get());
                        }
                        rowResult = values.length ? [{ columns, values }] : [];
                    } finally {
                        readOnlyStatement.free();
                    }
                }

                const countStatement = sqliteDb.prepare(`SELECT COUNT(*) AS total FROM ${tableIdentifier}${searchQuery.whereClause}`);
                try {
                    countStatement.bind(searchQuery.params);
                    sqliteTableTotalRows = countStatement.step() ? (Number.parseInt(countStatement.get()[0], 10) || 0) : 0;
                } finally {
                    countStatement.free();
                }
                sqliteTableEditable = tableEditable;

                if (!rowResult[0]) {
                    sqliteTableRows = [];
                    renderSQLiteGrid();
                    return;
                }

                const rowColumns = Array.isArray(rowResult[0].columns) ? rowResult[0].columns : [];
                sqliteTableRows = Array.isArray(rowResult[0].values)
                    ? rowResult[0].values.map((values) => {
                        const row = {};
                        rowColumns.forEach((columnName, columnIndex) => {
                            row[columnName] = values[columnIndex];
                        });
                        return row;
                    })
                    : [];

                renderSQLiteGrid();
            }

            async function loadSQLiteContent(contentBase64) {
                const overlay = document.getElementById('loadingOverlay');
                if (overlay) {
                    overlay.style.opacity = '1';
                }

                const SQL = await ensureSqlJs();
                const bytes = base64ToUint8Array(contentBase64);
                if (sqliteDb) {
                    try {
                        sqliteDb.close();
                    } catch {
                        // Ignore close failures.
                    }
                }
                sqliteDb = new SQL.Database(bytes);
                sqliteOriginalBase64 = contentBase64;
                sqliteTableNames = [];
                sqliteCurrentTable = '';
                sqliteTableColumns = [];
                sqliteTableRows = [];
                sqliteTableEditable = false;
                sqliteTableTotalRows = 0;
                sqliteJournalMode = '';
                sqliteViewerWarning = '';
                sqliteLoadError = '';
                sqliteRawPreview = '';

                try {
                    const journalResult = sqliteDb.exec('PRAGMA journal_mode;');
                    sqliteJournalMode = (journalResult[0] && journalResult[0].values && journalResult[0].values[0] && String(journalResult[0].values[0][0] || '').toLowerCase()) || '';
                } catch {
                    sqliteJournalMode = '';
                }

                const sqliteInfo = getSQLiteFileInfo(currentFilePath);
                const warningParts = [];
                if (sqliteInfo.extension === 'db') {
                    warningParts.push('Read-only mode is enforced for <code>.db</code> files in SQLite viewer to avoid damaging unknown database formats.');
                    setReadOnlyState(true, '.db files are read-only in SQLite viewer.');
                } else {
                    setReadOnlyState(false, '');
                }
                if (sqliteInfo.isSidecar) {
                    warningParts.push(`You opened a <strong>${sqliteInfo.sidecarType.toUpperCase()}</strong> companion file. The viewer reads the main database <code>${escapeHtml(sqliteInfo.basePath)}</code>, so unsynced sidecar-only changes may be missing. Switch to <strong>Monaco</strong> or <strong>Plain Text</strong> if you need raw inspection.`);
                } else if (sqliteJournalMode === 'wal') {
                    warningParts.push('WAL mode detected for this database. The browser viewer reads the main database file only, so recent rows that still live in the companion <code>-wal</code> file may not appear here yet. Use a raw editor mode if you need the file contents exactly as stored.');
                }
                sqliteViewerWarning = warningParts.join('<br><br>');

                const tablesResult = sqliteDb.exec("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' ORDER BY name ASC");
                sqliteTableNames = (tablesResult[0] && Array.isArray(tablesResult[0].values))
                    ? tablesResult[0].values.map((entry) => String(entry[0] || '')).filter(Boolean)
                    : [];

                fileLanguage = 'sqlite';
                syncEditorModeAvailability();
                await switchEditorMode('sqlite');
                setUnsavedState(false);
                updateEditorMeta('');
                renderSQLiteTableList();
                await loadSQLiteTable(sqliteTableNames[0] || '');
                updateDisplayedFileName();
                renderTreeView();

                if (overlay) {
                    setTimeout(() => {
                        overlay.style.opacity = '0';
                        setTimeout(() => overlay.remove(), 300);
                    }, 100);
                }
            }

            function exportCurrentSQLiteBase64() {
                if (!sqliteDb) return '';
                return uint8ArrayToBase64(sqliteDb.export());
            }

            function updateSQLiteCellValue(rowId, columnName, columnType, nextValue) {
                if (!sqliteDb || !sqliteCurrentTable || !sqliteTableEditable) return;
                const tableIdentifier = quoteSqlIdentifier(sqliteCurrentTable);
                const columnIdentifier = quoteSqlIdentifier(columnName);
                const statement = sqliteDb.prepare(`UPDATE ${tableIdentifier} SET ${columnIdentifier} = ? WHERE rowid = ?`);
                try {
                    statement.run([coerceSQLiteInputValue(nextValue, columnType), rowId]);
                    setUnsavedState(exportCurrentSQLiteBase64() !== sqliteOriginalBase64);
                } finally {
                    statement.free();
                }
                if (sqliteSearchTerm) {
                    loadSQLiteTable(sqliteCurrentTable, { searchTerm: sqliteSearchTerm });
                }
            }

            function setSQLiteCellNull(rowId, columnName) {
                if (!sqliteDb || !sqliteCurrentTable || !sqliteTableEditable) return;
                const tableIdentifier = quoteSqlIdentifier(sqliteCurrentTable);
                const columnIdentifier = quoteSqlIdentifier(columnName);
                const statement = sqliteDb.prepare(`UPDATE ${tableIdentifier} SET ${columnIdentifier} = NULL WHERE rowid = ?`);
                try {
                    statement.run([rowId]);
                    setUnsavedState(exportCurrentSQLiteBase64() !== sqliteOriginalBase64);
                } finally {
                    statement.free();
                }
                if (sqliteSearchTerm) {
                    loadSQLiteTable(sqliteCurrentTable, { searchTerm: sqliteSearchTerm });
                }
            }

            async function insertSQLiteRowFromInputs() {
                if (!sqliteDb || !sqliteCurrentTable || !sqliteTableEditable) return;
                const gridBody = document.getElementById('sqliteGridBody');
                if (!gridBody) return;
                const inputs = Array.from(gridBody.querySelectorAll('.sqlite-insert-input'));
                const filledInputs = inputs.filter((input) => String(input.value || '').trim() !== '');
                const tableIdentifier = quoteSqlIdentifier(sqliteCurrentTable);

                try {
                    if (!filledInputs.length) {
                        sqliteDb.run(`INSERT INTO ${tableIdentifier} DEFAULT VALUES`);
                    } else {
                        const columnNames = filledInputs.map((input) => String(input.getAttribute('data-column') || ''));
                        const columnTypes = filledInputs.map((input) => String(input.getAttribute('data-coltype') || ''));
                        const placeholders = filledInputs.map(() => '?').join(', ');
                        const columnsSql = columnNames.map((columnName) => quoteSqlIdentifier(columnName)).join(', ');
                        const params = filledInputs.map((input, index) => coerceSQLiteInputValue(input.value, columnTypes[index]));
                        const statement = sqliteDb.prepare(`INSERT INTO ${tableIdentifier} (${columnsSql}) VALUES (${placeholders})`);
                        try {
                            statement.run(params);
                        } finally {
                            statement.free();
                        }
                    }
                    setUnsavedState(exportCurrentSQLiteBase64() !== sqliteOriginalBase64);
                    await loadSQLiteTable(sqliteCurrentTable, { searchTerm: sqliteSearchTerm });
                    if (window.showStatusModal) {
                        window.showStatusModal('Row inserted locally. Save the database to persist it.', 'success');
                    }
                } catch (error) {
                    console.error('SQLite insert failed:', error);
                    if (window.showStatusModal) {
                        window.showStatusModal(`Failed to insert row: ${error.message}`, 'error');
                    }
                }
            }

            async function deleteSQLiteRow(rowId) {
                if (!sqliteDb || !sqliteCurrentTable || !sqliteTableEditable) return;
                const parsedRowId = Number.parseInt(rowId, 10);
                if (!Number.isFinite(parsedRowId)) return;
                const proceed = window.confirm(`Delete row ${parsedRowId} from ${sqliteCurrentTable}?`);
                if (!proceed) return;

                const tableIdentifier = quoteSqlIdentifier(sqliteCurrentTable);
                const statement = sqliteDb.prepare(`DELETE FROM ${tableIdentifier} WHERE rowid = ?`);
                try {
                    statement.run([parsedRowId]);
                    setUnsavedState(exportCurrentSQLiteBase64() !== sqliteOriginalBase64);
                } catch (error) {
                    console.error('SQLite delete failed:', error);
                    if (window.showStatusModal) {
                        window.showStatusModal(`Failed to delete row: ${error.message}`, 'error');
                    }
                    return;
                } finally {
                    statement.free();
                }

                await loadSQLiteTable(sqliteCurrentTable, { searchTerm: sqliteSearchTerm });
                if (window.showStatusModal) {
                    window.showStatusModal('Row deleted locally. Save the database to persist it.', 'success');
                }
            }

            function updateDisplayedFileName() {
                const nameEl = document.getElementById('displayFileName');
                if (nameEl) {
                    nameEl.textContent = currentFilePath.split('/').pop() || currentFilePath;
                }
            }

            function setSuppressEditorChanges(value) {
                window.__suppressEditorChanges = Boolean(value);
            }

            function isSuppressingEditorChanges() {
                return Boolean(window.__suppressEditorChanges);
            }

            function handleEditorValueChanged(nextValue) {
                if (isSuppressingEditorChanges()) return;
                setUnsavedState(nextValue !== currentContent);
                updateEditorMeta(nextValue);
            }

            function ensureMonacoEditor() {
                return new Promise((resolve) => {
                    if (monacoEditor) {
                        resolve(monacoEditor);
                        return;
                    }
                    require.config({ paths: { 'vs': 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs' } });
                    require(['vs/editor/editor.main'], function () {
                        monaco.editor.defineTheme('cpanel-dark', {
                            base: 'vs-dark',
                            inherit: true,
                            rules: [],
                            colors: {
                                'editor.background': '#0f0f12',
                                'editor.lineHighlightBackground': '#1a1a20',
                                'editorLineNumber.foreground': '#4b5563',
                                'editorLineNumber.activeForeground': '#9ca3af',
                                'editorIndentGuide.background': '#1f2937'
                            }
                        });
                        monacoEditor = monaco.editor.create(document.getElementById('monaco-editor-container'), {
                            value: '',
                            language: fileLanguage,
                            theme: 'cpanel-dark',
                            automaticLayout: true,
                            minimap: { enabled: true },
                            fontSize: 14,
                            fontFamily: "'JetBrains Mono', 'Fira Code', monospace",
                            scrollBeyondLastLine: false,
                            readOnly: fileReadOnly,
                            wordWrap: wordWrapEnabled ? 'on' : 'off',
                            padding: { top: 16 }
                        });
                        monacoEditor.onDidChangeModelContent(() => {
                            handleEditorValueChanged(monacoEditor.getValue());
                        });
                        resolve(monacoEditor);
                    });
                });
            }

            function ensureAceEditor() {
                return new Promise((resolve) => {
                    if (aceEditor) {
                        resolve(aceEditor);
                        return;
                    }
                    if (!window.ace) {
                        resolve(null);
                        return;
                    }
                    const aceContainer = document.getElementById('ace-editor-container');
                    aceEditor = window.ace.edit(aceContainer);
                    aceEditor.setTheme('ace/theme/monokai');
                    aceEditor.session.setUseWrapMode(wordWrapEnabled);
                    aceEditor.setFontSize(14);
                    aceEditor.setReadOnly(fileReadOnly);
                    aceEditor.setOptions({
                        showPrintMargin: false,
                        useWorker: false
                    });
                    aceEditor.session.on('change', () => {
                        handleEditorValueChanged(aceEditor.getValue());
                    });
                    resolve(aceEditor);
                });
            }

            function ensurePlainEditor() {
                const plainEditor = document.getElementById('plain-editor');
                if (!plainEditor.dataset.bound) {
                    plainEditor.addEventListener('input', () => {
                        handleEditorValueChanged(plainEditor.value);
                    });
                    plainEditor.dataset.bound = '1';
                }
                plainEditor.wrap = wordWrapEnabled ? 'soft' : 'off';
                plainEditor.readOnly = fileReadOnly;
                return plainEditor;
            }

            function getActiveEditorValue() {
                if (activeEditorMode === 'sqlite') return '';
                if (activeEditorMode === 'ace' && aceEditor) return aceEditor.getValue();
                if (activeEditorMode === 'plain') return ensurePlainEditor().value;
                if (monacoEditor) return monacoEditor.getValue();
                return currentContent || '';
            }

            function setActiveEditorValue(value) {
                if (activeEditorMode === 'sqlite') {
                    updateEditorMeta('');
                    return;
                }
                const safeValue = typeof value === 'string' ? value : '';
                setSuppressEditorChanges(true);
                if (activeEditorMode === 'ace' && aceEditor) {
                    aceEditor.setValue(safeValue, -1);
                } else if (activeEditorMode === 'plain') {
                    ensurePlainEditor().value = safeValue;
                } else if (monacoEditor) {
                    monacoEditor.setValue(safeValue);
                }
                setSuppressEditorChanges(false);
                updateEditorMeta(safeValue);
            }

            function applyEditorLanguage() {
                if (activeEditorMode === 'sqlite') {
                    return;
                }
                if (monacoEditor && window.monaco) {
                    window.monaco.editor.setModelLanguage(monacoEditor.getModel(), fileLanguage);
                }
                if (aceEditor) {
                    aceEditor.session.setMode(`ace/mode/${guessAceMode(fileLanguage)}`);
                }
            }

            function layoutActiveEditor() {
                const sqliteContainer = document.getElementById('sqlite-editor-container');
                if (sqliteContainer && !sqliteContainer.classList.contains('d-none')) return;
                if (monacoEditor) monacoEditor.layout();
                if (aceEditor) aceEditor.resize();
            }

            function setSaveLoadingState(isLoading) {
                const saveBtn = document.getElementById('btnSave');
                const saveIcon = document.getElementById('saveIcon');
                const saveSpinner = document.getElementById('saveSpinner');
                if (isLoading) {
                    saveBtn.classList.add('disabled');
                    saveIcon.classList.add('d-none');
                    saveSpinner.classList.remove('d-none');
                } else {
                    saveSpinner.classList.add('d-none');
                    saveIcon.classList.remove('d-none');
                    saveBtn.classList.remove('disabled');
                }
            }

            function setUnsavedState(value) {
                isUnsaved = Boolean(value);
                document.getElementById('unsavedBadge').classList.toggle('d-none', !isUnsaved);
            }

            function updateEditorMeta(content) {
                const safeContent = typeof content === 'string' ? content : '';
                const languageChip = document.getElementById('editorLanguageChip');
                const lengthChip = document.getElementById('editorLengthChip');
                const pathChip = document.getElementById('displayFilePath');
                if (languageChip) {
                    const text = languageChip.querySelector('span');
                    if (text) text.textContent = fileLanguage;
                }
                if (lengthChip) {
                    const text = lengthChip.querySelector('span');
                    if (text) {
                        if (isSQLitePath(currentFilePath)) {
                            text.textContent = `${sqliteTableNames.length.toLocaleString()} tables`;
                        } else {
                            text.textContent = `${safeContent.length.toLocaleString()} chars`;
                        }
                    }
                }
                if (pathChip) {
                    const text = pathChip.querySelector('span');
                    if (text) text.textContent = currentFilePath;
                }
            }

            function updateWordWrapButton() {
                const btn = document.getElementById('btnWordWrapToggle');
                if (!btn) return;
                btn.innerHTML = wordWrapEnabled
                    ? '<i class="bi bi-text-wrap"></i> Wrap On'
                    : '<i class="bi bi-arrows-collapse"></i> Wrap Off';
            }

            function applyWordWrap() {
                if (activeEditorMode === 'sqlite') {
                    updateWordWrapButton();
                    return;
                }
                if (monacoEditor) {
                    monacoEditor.updateOptions({
                        wordWrap: wordWrapEnabled ? 'on' : 'off'
                    });
                }
                if (aceEditor) {
                    aceEditor.session.setUseWrapMode(wordWrapEnabled);
                    aceEditor.resize();
                }
                const plainEditor = document.getElementById('plain-editor');
                if (plainEditor) {
                    plainEditor.wrap = wordWrapEnabled ? 'soft' : 'off';
                }
                updateWordWrapButton();
                try {
                    localStorage.setItem(wordWrapSettingKey, wordWrapEnabled ? '1' : '0');
                } catch {
                    // Ignore localStorage issues.
                }
            }

            async function switchEditorMode(nextMode, providedContent = null) {
                const sqliteMode = isSQLitePath(currentFilePath);
                const allowedMode = sqliteMode
                    ? (['monaco', 'ace', 'plain', 'sqlite'].includes(nextMode) ? nextMode : 'sqlite')
                    : (['monaco', 'ace', 'plain'].includes(nextMode) ? nextMode : 'monaco');
                const contentToPreserve = typeof providedContent === 'string' ? providedContent : getActiveEditorValue();
                activeEditorMode = allowedMode;
                syncEditorModeAvailability();
                document.getElementById('editorModeSelect').value = activeEditorMode;
                document.getElementById('monaco-editor-container').classList.toggle('d-none', activeEditorMode !== 'monaco');
                document.getElementById('ace-editor-container').classList.toggle('d-none', activeEditorMode !== 'ace');
                document.getElementById('plain-editor-container').classList.toggle('d-none', activeEditorMode !== 'plain');
                document.getElementById('sqlite-editor-container').classList.toggle('d-none', activeEditorMode !== 'sqlite');

                if (activeEditorMode === 'sqlite') {
                    renderSQLiteTableList();
                    renderSQLiteGrid();
                } else if (activeEditorMode === 'monaco') {
                    await ensureMonacoEditor();
                } else if (activeEditorMode === 'ace') {
                    const aceInstance = await ensureAceEditor();
                    if (!aceInstance) {
                        activeEditorMode = 'plain';
                        document.getElementById('editorModeSelect').value = activeEditorMode;
                        ensurePlainEditor();
                    }
                } else {
                    ensurePlainEditor();
                }

                document.getElementById('editorModeSelect').value = activeEditorMode;
                document.getElementById('monaco-editor-container').classList.toggle('d-none', activeEditorMode !== 'monaco');
                document.getElementById('ace-editor-container').classList.toggle('d-none', activeEditorMode !== 'ace');
                document.getElementById('plain-editor-container').classList.toggle('d-none', activeEditorMode !== 'plain');
                document.getElementById('sqlite-editor-container').classList.toggle('d-none', activeEditorMode !== 'sqlite');

                try {
                    if (activeEditorMode !== 'sqlite') {
                        localStorage.setItem(editorModeSettingKey, activeEditorMode);
                    }
                } catch {
                    // Ignore localStorage issues.
                }

                applyEditorLanguage();
                applyWordWrap();
                if (activeEditorMode !== 'sqlite') {
                    setActiveEditorValue(contentToPreserve);
                    setUnsavedState(contentToPreserve !== currentContent);
                } else {
                    setUnsavedState(exportCurrentSQLiteBase64() !== sqliteOriginalBase64);
                }
                setReadOnlyState(fileReadOnly, fileReadOnlyReason);
                layoutActiveEditor();
            }

            async function loadEditorContent(content, fileExtension) {
                if (isSQLitePath(currentFilePath) && activeEditorMode === 'sqlite') {
                    const binary = uint8ArrayToBase64(new TextEncoder().encode(String(content || '')));
                    await loadSQLiteContent(binary);
                    return;
                }
                fileLanguage = guessLanguage(fileExtension);
                await switchEditorMode(activeEditorMode, content);
                setUnsavedState(false);
                updateEditorMeta(content);
                updateDisplayedFileName();
                renderTreeView();
                setReadOnlyState(fileReadOnly, fileReadOnlyReason);

                const overlay = document.getElementById('loadingOverlay');
                if (overlay) {
                    setTimeout(() => {
                        overlay.style.opacity = '0';
                        setTimeout(() => overlay.remove(), 300);
                    }, 100);
                }
            }

            function requestCurrentFileContent() {
                updateDisplayedFileName();
                updateEditorMeta(getActiveEditorValue());
                renderTreeView();
                if (!ws || ws.readyState !== WebSocket.OPEN) return;
                const requestedPath = isSQLitePath(currentFilePath) ? getSQLiteTargetPath(currentFilePath) : currentFilePath;
                const payload = {
                    type: 'read_file',
                    filePath: requestedPath
                };
                if (isSQLitePath(currentFilePath) && activeEditorMode === 'sqlite') {
                    payload.encoding = 'base64';
                }
                ws.send(JSON.stringify(payload));
            }

            async function applyCurrentFilePath(nextPath) {
                currentFilePath = normalizeServerPath(nextPath);
                fileLanguage = guessLanguage(currentFilePath.split('.').pop() || '');
                setReadOnlyState(false, '');
                if (isSQLitePath(currentFilePath) && !['monaco', 'ace', 'plain', 'sqlite'].includes(activeEditorMode)) {
                    activeEditorMode = 'sqlite';
                }
                syncEditorModeAvailability();
                updateDisplayedFileName();
                updateEditorMeta(getActiveEditorValue());
                await ensureTreeContext(getCurrentDirectoryPath());
                requestCurrentFileContent();
            }

            function connect() {
                ws = new WebSocket(wsUrl);

                ws.onopen = () => {
                    console.log('WS Connected');
                    requestCurrentFileContent();
                };

                ws.onmessage = (event) => {
                    try {
                        const data = JSON.parse(event.data);

                        if (data.type === 'file_content') {
                            const expectedPath = isSQLitePath(currentFilePath) ? getSQLiteTargetPath(currentFilePath) : currentFilePath;
                            if (normalizeServerPath(data.filePath) === normalizeServerPath(expectedPath)) {
                                const ext = currentFilePath.split('.').pop() || '';
                                if (isSQLitePath(currentFilePath) && activeEditorMode === 'sqlite') {
                                    const sqliteBase64 = String(data.contentBase64 || '').trim();
                                    if (!sqliteBase64) {
                                        if (window.showStatusModal) {
                                            window.showStatusModal('Failed to load SQLite database: connector did not return binary content.', 'error');
                                        }
                                        return;
                                    }
                                    loadSQLiteContent(sqliteBase64).catch((error) => {
                                        console.error('SQLite load failed:', error);
                                        sqliteLoadError = `SQLite viewer could not parse this file: ${error.message}`;
                                        sqliteRawPreview = decodeBase64ToText(sqliteBase64);
                                        sqliteTableNames = [];
                                        sqliteCurrentTable = '';
                                        sqliteTableColumns = [];
                                        sqliteTableRows = [];
                                        sqliteTableEditable = false;
                                        sqliteTableTotalRows = 0;
                                        setReadOnlyState(true, 'This file could not be parsed as SQLite. Viewer is read-only.');
                                        renderSQLiteTableList();
                                        renderSQLiteGrid();
                                        const overlay = document.getElementById('loadingOverlay');
                                        if (overlay) {
                                            setTimeout(() => {
                                                overlay.style.opacity = '0';
                                                setTimeout(() => overlay.remove(), 300);
                                            }, 100);
                                        }
                                        if (window.showStatusModal) {
                                            window.showStatusModal(`SQLite viewer fallback: ${error.message}. Showing read-only raw preview inside SQLite mode.`, 'error');
                                        }
                                    });
                                } else {
                                    setReadOnlyState(false, '');
                                    currentContent = data.content || '';
                                    loadEditorContent(currentContent, ext);
                                }
                            }
                        } else if (data.type === 'write_success') {
                            const expectedPath = isSQLitePath(currentFilePath) ? getSQLiteTargetPath(currentFilePath) : currentFilePath;
                            if (normalizeServerPath(data.filePath) === normalizeServerPath(expectedPath)) {
                                if (isSQLitePath(currentFilePath)) {
                                    sqliteOriginalBase64 = exportCurrentSQLiteBase64();
                                } else {
                                    currentContent = getActiveEditorValue();
                                }
                                setUnsavedState(false);
                                setSaveLoadingState(false);
                                updateEditorMeta(isSQLitePath(currentFilePath) ? '' : currentContent);

                                if (window.showStatusModal) {
                                    window.showStatusModal(isSQLitePath(currentFilePath) ? 'Database saved successfully.' : 'File saved successfully.', 'success');
                                }
                            }
                        } else if (data.type === 'error') {
                            if (window.showStatusModal) {
                                window.showStatusModal(data.message, 'error');
                            } else {
                                alert(data.message);
                            }

                            // Reset save button if saving failed
                            setSaveLoadingState(false);

                            // If load failed, go back
                            if (!monacoEditor && !aceEditor) {
                                setTimeout(() => {
                                    document.getElementById('btnReturn').click();
                                }, 2000);
                            }
                        }
                    } catch (e) {
                        console.error('WS Parse Error', e);
                    }
                };

                ws.onclose = () => {
                    console.log('WS Disconnected');
                    setTimeout(connect, 2000);
                };
            }

            // Save File Action
            document.getElementById('btnSave').addEventListener('click', () => {
                if (!ws || ws.readyState !== WebSocket.OPEN) {
                    if (window.showStatusModal) window.showStatusModal('Not connected to server.', 'error');
                    return;
                }
                if (fileReadOnly) {
                    if (window.showStatusModal) {
                        window.showStatusModal(fileReadOnlyReason || 'This file is read-only in the current mode.', 'error');
                    }
                    return;
                }

                setSaveLoadingState(true);
                if (isSQLitePath(currentFilePath)) {
                    ws.send(JSON.stringify({
                        type: 'write_file',
                        filePath: getSQLiteTargetPath(currentFilePath),
                        encoding: 'base64',
                        contentBase64: exportCurrentSQLiteBase64()
                    }));
                    return;
                }

                ws.send(JSON.stringify({
                    type: 'write_file',
                    filePath: currentFilePath,
                    content: getActiveEditorValue()
                }));
            });

            // Prevent closing unsaved changes
            window.addEventListener('beforeunload', (e) => {
                if (isUnsaved) {
                    e.preventDefault();
                    e.returnValue = '';
                }
            });

            // Start connection
            connect();

            try {
                treeViewEnabled = window.localStorage.getItem(treeViewSettingKey) === '1';
            } catch {
                treeViewEnabled = false;
            }

            let storedEditorMode = '';
            try {
                storedEditorMode = window.localStorage.getItem(editorModeSettingKey) || '';
                if (['monaco', 'ace', 'plain', 'sqlite'].includes(storedEditorMode)) {
                    activeEditorMode = storedEditorMode;
                }
            } catch {
                activeEditorMode = 'monaco';
            }

            if (isSQLitePath(currentFilePath) && !storedEditorMode) {
                activeEditorMode = 'sqlite';
            }

            if (treeViewEnabled) {
                ensureTreeContext(getCurrentDirectoryPath());
            }
            document.getElementById('editorModeSelect').value = activeEditorMode;
            syncEditorModeAvailability();
            updateDisplayedFileName();
            renderTreeView();

            const wordWrapBtn = document.getElementById('btnWordWrapToggle');
            if (wordWrapBtn) {
                wordWrapBtn.addEventListener('click', () => {
                    wordWrapEnabled = !wordWrapEnabled;
                    applyWordWrap();
                });
            }

            const editorModeSelect = document.getElementById('editorModeSelect');
            if (editorModeSelect) {
                editorModeSelect.addEventListener('change', async () => {
                    await switchEditorMode(editorModeSelect.value);
                });
            }

            const treeToggleBtn = document.getElementById('btnToggleTreeView');
            if (treeToggleBtn) {
                treeToggleBtn.addEventListener('click', async () => {
                    treeViewEnabled = !treeViewEnabled;
                    try {
                        window.localStorage.setItem(treeViewSettingKey, treeViewEnabled ? '1' : '0');
                    } catch {
                        // Ignore localStorage issues.
                    }
                    if (treeViewEnabled) {
                        await ensureTreeContext(getCurrentDirectoryPath());
                    }
                    renderTreeView();
                });
            }

            const refreshTreeBtn = document.getElementById('btnRefreshEditorTree');
            if (refreshTreeBtn) {
                refreshTreeBtn.addEventListener('click', async () => {
                    treeCache.clear();
                    await ensureTreeContext(getCurrentDirectoryPath());
                });
            }

            const editorTreeBody = document.getElementById('editorTreeBody');
            if (editorTreeBody) {
                editorTreeBody.addEventListener('click', async (event) => {
                    const toggleEl = event.target.closest('[data-tree-toggle]');
                    if (toggleEl) {
                        event.preventDefault();
                        event.stopPropagation();
                        const targetPath = normalizeServerPath(toggleEl.getAttribute('data-tree-toggle'));
                        if (treeExpandedPaths.has(targetPath)) {
                            treeExpandedPaths.delete(targetPath);
                            renderTreeView();
                            return;
                        }
                        treeExpandedPaths.add(targetPath);
                        await fetchTreeEntries(targetPath, false);
                        renderTreeView();
                        return;
                    }

                    const nodeEl = event.target.closest('[data-tree-path]');
                    if (!nodeEl) return;
                    event.preventDefault();
                    const targetPath = normalizeServerPath(nodeEl.getAttribute('data-tree-path'));
                    const targetType = String(nodeEl.getAttribute('data-tree-type') || 'directory');
                    if (targetType === 'directory') {
                        treeExpandedPaths.add(targetPath);
                        await fetchTreeEntries(targetPath, false);
                        renderTreeView();
                        return;
                    }
                    goToFilePath(targetPath);
                });
            }

            const sqliteTablesList = document.getElementById('sqliteTablesList');
            if (sqliteTablesList) {
                sqliteTablesList.addEventListener('click', async (event) => {
                    const button = event.target.closest('[data-sqlite-table]');
                    if (!button) return;
                    event.preventDefault();
                    await loadSQLiteTable(button.getAttribute('data-sqlite-table'));
                });
            }

            const sqliteGridBody = document.getElementById('sqliteGridBody');
            if (sqliteGridBody) {
                sqliteGridBody.addEventListener('change', (event) => {
                    const input = event.target.closest('.sqlite-cell-input');
                    if (!input) return;
                    const rowId = Number.parseInt(input.getAttribute('data-rowid'), 10);
                    const columnName = String(input.getAttribute('data-column') || '');
                    const columnType = String(input.getAttribute('data-coltype') || '');
                    if (!Number.isFinite(rowId) || !columnName) return;
                    updateSQLiteCellValue(rowId, columnName, columnType, input.value);
                });

                sqliteGridBody.addEventListener('click', (event) => {
                    const nullBtn = event.target.closest('[data-sqlite-null]');
                    if (nullBtn) {
                        event.preventDefault();
                        const rowId = Number.parseInt(nullBtn.getAttribute('data-rowid'), 10);
                        const columnName = String(nullBtn.getAttribute('data-column') || '');
                        if (!Number.isFinite(rowId) || !columnName) return;
                        setSQLiteCellNull(rowId, columnName);
                        const input = sqliteGridBody.querySelector(`.sqlite-cell-input[data-rowid="${rowId}"][data-column="${escapeCssAttributeValue(columnName)}"]`);
                        if (input) {
                            input.value = '';
                        }
                        return;
                    }

                    const deleteBtn = event.target.closest('[data-sqlite-delete-row]');
                    if (deleteBtn) {
                        event.preventDefault();
                        deleteSQLiteRow(deleteBtn.getAttribute('data-sqlite-delete-row'));
                        return;
                    }

                    const insertBtn = event.target.closest('#btnSubmitSQLiteInsert');
                    if (insertBtn) {
                        event.preventDefault();
                        insertSQLiteRowFromInputs();
                    }
                });
            }

            const sqliteSearchInput = document.getElementById('sqliteSearchInput');
            if (sqliteSearchInput) {
                sqliteSearchInput.addEventListener('input', () => {
                    window.clearTimeout(sqliteSearchDebounceTimer);
                    sqliteSearchDebounceTimer = window.setTimeout(() => {
                        loadSQLiteTable(sqliteCurrentTable, { searchTerm: sqliteSearchInput.value });
                    }, 180);
                });
            }

            const clearSQLiteSearchBtn = document.getElementById('btnClearSQLiteSearch');
            if (clearSQLiteSearchBtn) {
                clearSQLiteSearchBtn.addEventListener('click', () => {
                    sqliteSearchTerm = '';
                    if (sqliteSearchInput) {
                        sqliteSearchInput.value = '';
                    }
                    loadSQLiteTable(sqliteCurrentTable, { searchTerm: '' });
                });
            }

            const insertSQLiteRowBtn = document.getElementById('btnInsertSQLiteRow');
            if (insertSQLiteRowBtn) {
                insertSQLiteRowBtn.addEventListener('click', () => {
                    const insertSubmit = document.getElementById('btnSubmitSQLiteInsert');
                    if (insertSubmit) {
                        insertSubmit.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                });
            }

            // Sidebar toggle
            const sidebarBtn = document.getElementById('sidebarToggle');
            if (sidebarBtn) {
                sidebarBtn.addEventListener('click', () => {
                    document.getElementById('sidebar').classList.toggle('collapsed');
                    setTimeout(layoutActiveEditor, 350);
                });
            }

            // Layout editor strictly on window resize
            window.addEventListener('resize', () => {
                renderTreeView();
                layoutActiveEditor();
            });

            window.addEventListener('hashchange', async () => {
                const nextHashPath = getFilePathFromHash();
                if (!nextHashPath) return;
                const normalizedNext = normalizeServerPath(nextHashPath);
                if (normalizedNext === normalizeServerPath(currentFilePath)) return;
                if (isUnsaved) {
                    const proceed = window.confirm('You have unsaved changes. Leave this file anyway?');
                    if (!proceed) {
                        window.location.hash = `file=${encodeURIComponent(currentFilePath)}`;
                        return;
                    }
                }
                await applyCurrentFilePath(normalizedNext);
            });
        </script>
</body>

</html>
