<%
const currentAdminPath = String(path || '');
const adminSidebarRuntimeBadges = (typeof adminSidebarBadges !== 'undefined' && adminSidebarBadges) ? adminSidebarBadges : {};
const buildAdminBadge = (label, tone = 'info') => label ? { label, tone } : null;
const adminRedisEnabled = Boolean(typeof redisInfo !== 'undefined' && redisInfo && redisInfo.enabled);
const adminRedisReady = Boolean(typeof redisInfo !== 'undefined' && redisInfo && redisInfo.enabled && redisInfo.ready);
const navBadgeForItem = (item) => {
    if (isAdminNavActive(item)) return buildAdminBadge('Open', 'info');
    return item.badge || null;
};
const adminNavSections = [
    {
        title: 'Core',
        items: [
            { href: '/', icon: 'bi-house', label: 'Exit admin mode' },
            { href: '/admin/overview', icon: 'bi-house-door', label: 'Overview', badge: buildAdminBadge('Home', 'info') },
            { href: '/admin/settings', icon: 'bi-gear', label: 'Settings' },
            { href: '/admin/platform', icon: 'bi-command', label: 'Platform Ops' },
            { href: '/admin/incidents', icon: 'bi-exclamation-triangle', label: 'Incident Center', badge: adminSidebarRuntimeBadges.incidents || buildAdminBadge('Live', 'danger') },
            { href: '/admin/logs', icon: 'bi-file-text', label: 'Logs' }
        ]
    },
    {
        title: 'Commerce',
        items: [
            { href: '/admin/let-user-create', icon: 'bi-shop', label: 'Let User Create' },
            { href: '/admin/revenue-plans', icon: 'bi-cash-stack', label: 'Revenue Plans' },
            { href: '/admin/store/deals', icon: 'bi-stars', label: 'Store Deals' },
            { href: '/admin/store/redeem-codes', icon: 'bi-ticket-perforated', label: 'Redeem Codes' },
            { href: '/admin/forecasting', icon: 'bi-graph-up-arrow', label: 'Forecasting' }
        ]
    },
    {
        title: 'Infrastructure',
        items: [
            { href: '/admin/connectors', icon: 'bi-diagram-3', label: 'Connectors', badge: buildAdminBadge('Ops', 'info') },
            { href: '/admin/allocations/drift', icon: 'bi-wrench-adjustable', label: 'Allocation Drift' },
            { href: '/admin/connect-info', icon: 'bi-activity', label: 'Connector(s) Health', badge: buildAdminBadge('Live', 'success') },
            { href: '/admin/locations', icon: 'bi-geo-alt', label: 'Locations' },
            { href: '/admin/users', icon: 'bi-people', label: 'Users' },
            { href: '/admin/servers', icon: 'bi-hdd-stack', label: 'Servers' },
            { href: '/admin/databases', icon: 'bi-database', label: 'Databases' },
            { href: '/admin/mounts', icon: 'bi-link-45deg', label: 'Mounts' },
            { href: '/admin/redis', icon: 'bi-hdd-network', label: 'Redis', badge: adminRedisReady ? buildAdminBadge('Ready', 'success') : (adminRedisEnabled ? buildAdminBadge('Config', 'warning') : buildAdminBadge('Setup', 'muted')) },
            { href: '/admin/ai-agents', icon: 'bi-robot', label: 'AI Agents', badge: buildAdminBadge('AI', 'violet') }
        ]
    },
    {
        title: 'Security',
        items: [
            { href: '/admin/abuse-scores', icon: 'bi-shield-exclamation', label: 'Abuse Scores' },
            { href: '/admin/sentry-seeker', icon: 'bi-shield-lock-fill', label: 'Sentry Seeker', badge: buildAdminBadge('Shield', 'danger') },
            { href: '/admin/service-health-checks', icon: 'bi-heart-pulse', label: 'Health Checks', badge: buildAdminBadge('Live', 'success') },
            { href: '/admin/auth-providers', icon: 'bi-shield-lock', label: 'Auth Providers' },
            { href: '/admin/captcha', icon: 'bi-robot', label: 'Captcha' },
            { href: '/admin/api', icon: 'bi-code-square', label: 'CPanel API' }
        ]
    },
    {
        title: 'Content',
        items: [
            { href: '/admin/images', icon: 'bi-grid-3x3-gap', label: 'Images' },
            { href: '/admin/packages', icon: 'bi-box', label: 'Packages' },
            { href: '/admin/migrations/pterodactyl', icon: 'bi-arrow-left-right', label: 'Migrations' },
            { href: '/admin/extensions', icon: 'bi-puzzle', label: 'Extensions' },
            { href: '/admin/themes', icon: 'bi-palette', label: 'Themes', badge: buildAdminBadge('UI', 'violet') },
            { href: '/admin/lang', icon: 'bi-translate', label: 'Languages' }
        ]
    }
];

const isAdminNavActive = (item) => {
    const matches = Array.isArray(item && item.match) && item.match.length ? item.match : [item && item.href];
    return matches.some((entry) => {
        const value = String(entry || '').trim();
        if (!value) return false;
        return currentAdminPath === value || currentAdminPath.startsWith(`${value}/`);
    });
};
%>

<div id="adminSidebar" class="admin-sidebar-modal-host" aria-hidden="true">
    <div class="sidebar-header admin-sidebar-header">
        <div class="admin-sidebar-brand-wrap">
            <div class="admin-sidebar-brand-mark">
                <img src="<%= settings.faviconUrl %>" alt="Brand" width="28" height="28">
            </div>
            <div class="admin-sidebar-brand-copy">
                <span class="sidebar-brand"><%= (settings.brandName || 'CPanel').toUpperCase() %></span>
                <small>Admin control surface</small>
            </div>
        </div>
    </div>
    <div class="admin-sidebar-panel">
        <% adminNavSections.forEach((section) => { %>
            <section class="admin-sidebar-section">
                <div class="admin-section-head px-3">
                    <div class="small-heading mb-0"><%= section.title %></div>
                    <span class="admin-section-count"><%= section.items.length %></span>
                </div>
                <div class="nav flex-column px-2 mb-2 admin-sidebar-links">
                <% section.items.forEach((item) => { %>
                    <a href="<%= item.href %>" class="nav-link <%= isAdminNavActive(item) ? 'active' : '' %>">
                        <span class="admin-nav-icon-box"><i class="bi <%= item.icon %>"></i></span>
                        <span class="admin-nav-copy">
                            <span class="sidebar-text"><%= item.label %></span>
                            <small><%= item.href === '/' ? 'Back to user panel' : item.href.replace('/admin/', '').replaceAll('-', ' ') %></small>
                        </span>
                        <% const adminBadge = navBadgeForItem(item); %>
                        <% if (adminBadge) { %>
                            <span class="admin-item-badge admin-item-badge-<%= adminBadge.tone || 'info' %>"><%= adminBadge.label %></span>
                        <% } %>
                        <i class="bi bi-chevron-right admin-nav-chevron"></i>
                    </a>
                <% }) %>
                </div>
            </section>
        <% }) %>
        <div class="admin-sidebar-mode px-3 py-3">
            <div class="nav-mode-switch admin-nav-mode-switch">
                <button type="button" class="nav-mode-btn" data-admin-nav-mode="modal">Popup</button>
                <button type="button" class="nav-mode-btn" data-admin-nav-mode="sidebar">Sidebar</button>
                <button type="button" class="nav-mode-btn" data-admin-nav-mode="navbar">Navbar</button>
            </div>
        </div>
        <div class="admin-sidebar-footer px-3 pb-3">
            <div class="admin-sidebar-user-chip">
                <img src="<%= user.avatarUrl || `https://www.gravatar.com/avatar/${user.gravatarHash}?d=retro` %>" alt="<%= user.username %>" width="34" height="34">
                <div>
                    <strong>@<%= user.username %></strong>
                    <small>Administrator</small>
                </div>
            </div>
        </div>
    </div>
    <button type="button" class="admin-menu-toggle" data-bs-toggle="modal" data-bs-target="#adminNavModal" aria-label="Open admin menu">
        <i class="bi bi-shield"></i>
        <span>Admin Menu</span>
    </button>
</div>
<script>
    (() => {
        if (window.__csrfInjected) return;
        const token = <%- JSON.stringify(typeof csrfToken !== 'undefined' ? csrfToken : '') %>;
        if (!token) return;
        window.__csrfInjected = true;

        const ensureFormToken = (form) => {
            if (!form || !form.method || String(form.method).toLowerCase() === 'get') return;
            if (form.querySelector('input[name="_csrf"]')) return;
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = '_csrf';
            input.value = token;
            form.appendChild(input);
        };

        document.querySelectorAll('form').forEach(ensureFormToken);
        document.addEventListener('submit', (event) => ensureFormToken(event.target));
        if (!HTMLFormElement.prototype.__csrfWrapped) {
            const originalSubmit = HTMLFormElement.prototype.submit;
            HTMLFormElement.prototype.submit = function() {
                try { ensureFormToken(this); } catch (_) {}
                return originalSubmit.call(this);
            };
            HTMLFormElement.prototype.__csrfWrapped = true;
        }

        const isSameOrigin = (url) => {
            try {
                const u = new URL(url, window.location.origin);
                return u.origin === window.location.origin;
            } catch (_) {
                return true;
            }
        };

        if (typeof window.fetch === 'function') {
            const originalFetch = window.fetch.bind(window);
            window.fetch = (input, init = {}) => {
                const url = typeof input === 'string' ? input : (input && input.url) || '';
                if (isSameOrigin(url)) {
                    const headers = new Headers((init && init.headers) || {});
                    if (!headers.has('X-CSRF-Token') && !headers.has('CSRF-Token')) {
                        headers.set('X-CSRF-Token', token);
                    }
                    init = Object.assign({}, init, { headers });
                }
                return originalFetch(input, init);
            };
        }

        const originalOpen = XMLHttpRequest.prototype.open;
        const originalSend = XMLHttpRequest.prototype.send;
        XMLHttpRequest.prototype.open = function(method, url, ...rest) {
            this.__csrfUrl = url;
            return originalOpen.call(this, method, url, ...rest);
        };
        XMLHttpRequest.prototype.send = function(body) {
            if (this.__csrfUrl && isSameOrigin(this.__csrfUrl)) {
                try {
                    this.setRequestHeader('X-CSRF-Token', token);
                } catch (_) {}
            }
            return originalSend.call(this, body);
        };
    })();
</script>

<div class="admin-nav-bar">
    <div class="admin-nav-bar-inner">
        <div class="admin-nav-bar-title">Admin Control</div>
        <div class="nav-mode-switch admin-nav-mode-switch">
            <button type="button" class="nav-mode-btn" data-admin-nav-mode="modal">Popup</button>
            <button type="button" class="nav-mode-btn" data-admin-nav-mode="sidebar">Sidebar</button>
            <button type="button" class="nav-mode-btn" data-admin-nav-mode="navbar">Navbar</button>
        </div>
    </div>
    <div class="admin-nav-scroll" id="adminNavScroll">
        <% adminNavSections.forEach((section) => { %>
            <div class="admin-nav-group">
                <div class="admin-nav-group-title"><%= section.title %></div>
                <div class="admin-nav-group-items">
                    <% section.items.forEach((item) => { %>
                        <a href="<%= item.href %>" class="admin-nav-link <%= isAdminNavActive(item) ? 'active' : '' %>">
                            <i class="bi <%= item.icon %>"></i>
                            <span><%= item.label %></span>
                            <% const adminNavbarBadge = navBadgeForItem(item); %>
                            <% if (adminNavbarBadge) { %>
                                <span class="admin-navbar-badge admin-item-badge-<%= adminNavbarBadge.tone || 'info' %>"><%= adminNavbarBadge.label %></span>
                            <% } %>
                        </a>
                    <% }) %>
                </div>
            </div>
        <% }) %>
    </div>
</div>

