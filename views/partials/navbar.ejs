<style>
    .cpanel-topbar {
        position: sticky;
        top: 0;
        z-index: 1030;
        padding: 0.9rem 1rem;
        background:
            radial-gradient(circle at top left, rgba(79, 124, 255, 0.12), transparent 28%),
            linear-gradient(180deg, rgba(12, 18, 34, 0.95), rgba(9, 14, 27, 0.92));
        backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 14px 36px rgba(0, 0, 0, 0.18);
    }

    .cpanel-topbar .container-fluid {
        gap: 1rem;
    }

    .cpanel-brand-shell {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        min-width: 0;
    }

    .cpanel-brand-mark {
        width: 44px;
        height: 44px;
        border-radius: 15px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background:
            radial-gradient(circle at 28% 22%, rgba(255,255,255,0.18), transparent 32%),
            linear-gradient(180deg, rgba(79,124,255,0.26), rgba(79,124,255,0.08));
        border: 1px solid rgba(255,255,255,0.08);
        overflow: hidden;
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.22);
        flex-shrink: 0;
    }

    .cpanel-brand-mark img {
        width: 30px;
        height: 30px;
        object-fit: cover;
        border-radius: 10px;
    }

    .cpanel-brand-copy {
        min-width: 0;
    }

    .cpanel-brand-link {
        display: inline-flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.35rem;
        color: #f3f6ff;
        text-decoration: none;
        font-weight: 800;
        letter-spacing: 0.04em;
    }

    .cpanel-brand-link:hover {
        color: #ffffff;
    }

    .cpanel-brand-section {
        color: #9fb0d9;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .cpanel-brand-meta {
        margin-top: 0.18rem;
        color: rgba(255,255,255,0.48);
        font-size: 0.74rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .cpanel-topbar-actions {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        flex-wrap: wrap;
    }

    .cpanel-chip-btn {
        min-height: 42px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.08);
        background: rgba(255,255,255,0.035);
        color: #edf2ff;
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0 0.95rem;
        text-decoration: none;
        font-weight: 700;
        font-size: 0.84rem;
    }

    .cpanel-chip-btn:hover {
        color: #fff;
        border-color: rgba(79,124,255,0.22);
        background: rgba(79,124,255,0.1);
    }

    .cpanel-chip-btn.coins {
        border-color: rgba(255,191,77,0.22);
        background: rgba(255,191,77,0.1);
        color: #ffe09f;
    }

    .cpanel-profile-btn {
        min-height: 44px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.08);
        background: rgba(255,255,255,0.04);
        color: #edf2ff;
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.25rem 0.8rem 0.25rem 0.35rem;
    }

    .cpanel-profile-btn:hover {
        background: rgba(79,124,255,0.1);
        border-color: rgba(79,124,255,0.22);
    }

    .cpanel-profile-btn img {
        width: 32px;
        height: 32px;
        object-fit: cover;
    }

    .cpanel-profile-copy {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        line-height: 1.05;
    }

    .cpanel-profile-copy strong {
        font-size: 0.82rem;
        color: #eef3ff;
    }

    .cpanel-profile-copy small {
        color: rgba(255,255,255,0.48);
        font-size: 0.7rem;
    }

    .cpanel-topbar .navbar-toggler {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        border: 1px solid rgba(255,255,255,0.08);
        background: rgba(255,255,255,0.035);
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .cpanel-profile-modal .modal-content {
        background: linear-gradient(180deg, #10192c, #0b1221);
        border: 1px solid rgba(255,255,255,0.08);
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.34);
    }

    .cpanel-profile-grid .btn {
        border-radius: 14px;
        min-height: 42px;
        border-color: rgba(255,255,255,0.08);
        background: rgba(255,255,255,0.03);
    }

    .cpanel-profile-grid .btn:hover {
        background: rgba(79,124,255,0.1);
        border-color: rgba(79,124,255,0.2);
    }

    .cpanel-notify-btn {
        position: relative;
        min-width: 44px;
        justify-content: center;
    }

    .cpanel-notify-badge {
        position: absolute;
        top: -5px;
        right: -4px;
        min-width: 20px;
        height: 20px;
        border-radius: 999px;
        background: #ef4444;
        color: #fff;
        font-size: 0.72rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 6px;
        border: 2px solid rgba(12, 18, 34, 0.95);
    }

    .cpanel-notify-menu {
        width: min(420px, calc(100vw - 24px));
        background: #0f172a;
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 18px;
        padding: 0;
        overflow: hidden;
    }

    .cpanel-notify-list {
        max-height: 360px;
        overflow: auto;
    }

    .cpanel-notify-item {
        border-bottom: 1px solid rgba(148, 163, 184, 0.12);
        padding: 14px 16px;
    }

    .cpanel-notify-item:last-child {
        border-bottom: 0;
    }

    @media (max-width: 768px) {
        .cpanel-topbar {
            padding: 0.75rem 0.85rem;
        }

        .cpanel-brand-meta,
        .cpanel-profile-copy {
            display: none;
        }

        .cpanel-chip-btn {
            padding: 0 0.8rem;
        }
    }
</style>

<nav class="navbar navbar-expand-lg navbar-dark cpanel-topbar" data-turbo="false">
    <div class="container-fluid">
        <% const userCreateEnabled = String((settings && settings.featureUserCreateEnabled) || 'false') === 'true'; %>
        <% const storeDealsEnabled = String((settings && settings.featureStoreDealsEnabled) || 'false') === 'true'; %>
        <% const storeRedeemCodesEnabled = String((settings && settings.featureStoreRedeemCodesEnabled) || 'false') === 'true'; %>

        <div class="cpanel-brand-shell">
            <div class="cpanel-brand-mark">
                <img src="<%= settings.faviconUrl %>" alt="Favicon">
            </div>
            <div class="cpanel-brand-copy">
                <a class="cpanel-brand-link navbar-brand mb-0" href="/">
                    <span class="brand-main"><%= (settings.brandName || 'CPanel' ).toUpperCase() %></span>
                    <% if (locals.title) { %>
                        <span class="cpanel-brand-section"><%= title.toUpperCase() %></span>
                    <% } %>
                </a>
                <div class="cpanel-brand-meta">Panel runtime, identity, and server operations in one shell.</div>
            </div>
        </div>

        <div class="cpanel-topbar-actions order-lg-3">
            <% if (user) { %>
                <a href="/rewards" class="cpanel-chip-btn coins">
                    <i class="bi bi-coin"></i>
                    <span><%= new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 }).format(Number(user.coins || 0)) %></span>
                </a>

                <div class="dropdown">
                    <button type="button" class="cpanel-chip-btn cpanel-notify-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" id="notificationBellButton">
                        <i class="bi bi-bell"></i>
                        <span class="cpanel-notify-badge d-none" id="notificationBellCount">0</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end cpanel-notify-menu">
                        <div class="d-flex justify-content-between align-items-center px-3 py-3 border-bottom border-secondary border-opacity-25">
                            <strong class="text-light">Notifications</strong>
                            <a href="/notifications" class="btn btn-sm btn-outline-light">Open All</a>
                        </div>
                        <div class="cpanel-notify-list" id="notificationDropdownList">
                            <div class="text-center text-muted py-4">Loading...</div>
                        </div>
                        <div class="px-3 py-2 border-top border-secondary border-opacity-25 text-end">
                            <button type="button" class="btn btn-sm btn-link text-decoration-none text-info" id="notificationMarkAllBtn">Mark all read</button>
                        </div>
                    </div>
                </div>

                <button type="button"
                    class="btn cpanel-profile-btn border-0 shadow-none"
                    id="userProfileButton"
                    data-bs-toggle="modal"
                    data-bs-target="#userProfileModal"
                    aria-label="Open profile menu">
                    <img src="<%= (user.avatarProvider === 'url' && user.avatarUrl) ? user.avatarUrl : `https://www.gravatar.com/avatar/${user.gravatarHash}?d=retro` %>"
                        alt="Avatar" class="rounded-circle border border-secondary border-opacity-25"
                        style="object-fit: cover;" width="30" height="30">
                    <span class="cpanel-profile-copy">
                        <strong><%= user.username %></strong>
                        <small><%= user.isAdmin ? 'Admin account' : 'Panel account' %></small>
                    </span>
                    <i class="bi bi-list"></i>
                </button>
            <% } %>

            <button class="navbar-toggler border-0 shadow-none px-0" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>

        <div class="collapse navbar-collapse order-lg-2" id="navbarNav">
            <ul class="navbar-nav me-auto"></ul>
        </div>
    </div>
</nav>

<% if (user) { %>
<script>
    (() => {
        if (window.__cpanelNotificationUiInit) return;
        window.__cpanelNotificationUiInit = true;
        const countEl = document.getElementById('notificationBellCount');
        const listEl = document.getElementById('notificationDropdownList');
        const markAllBtn = document.getElementById('notificationMarkAllBtn');
        if (!countEl || !listEl) return;

        const escapeHtml = (value) => String(value || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');

        const setCount = (value) => {
            const count = Number(value || 0);
            countEl.textContent = String(count);
            countEl.classList.toggle('d-none', count <= 0);
        };

        const renderList = (notifications) => {
            if (!Array.isArray(notifications) || notifications.length === 0) {
                listEl.innerHTML = '<div class="text-center text-muted py-4">No notifications.</div>';
                return;
            }
            listEl.innerHTML = notifications.map((notification) => {
                const link = notification.linkUrl
                    ? `<a href="${escapeHtml(notification.linkUrl)}" class="btn btn-sm btn-outline-info mt-2">Open</a>`
                    : '';
                const markRead = notification.isRead
                    ? ''
                    : `<button type="button" class="btn btn-sm btn-outline-light mt-2" data-navbar-mark-read="${notification.id}">Mark read</button>`;
                return `
                    <div class="cpanel-notify-item text-light" data-navbar-notification="${notification.id}">
                        <div class="d-flex justify-content-between gap-2">
                            <strong>${escapeHtml(notification.title)}</strong>
                            <span class="badge ${notification.isRead ? 'bg-secondary' : 'bg-primary'}">${notification.isRead ? 'Read' : 'Unread'}</span>
                        </div>
                        <div class="text-muted small mt-1">${escapeHtml(new Date(notification.createdAt).toLocaleString())}</div>
                        <div class="small mt-2" style="white-space:pre-wrap;">${escapeHtml(notification.message)}</div>
                        <div class="d-flex gap-2">${link}${markRead}</div>
                    </div>
                `;
            }).join('');
            listEl.querySelectorAll('[data-navbar-mark-read]').forEach((button) => {
                button.addEventListener('click', async () => {
                    const id = button.getAttribute('data-navbar-mark-read');
                    const response = await fetch('/api/account/notifications/' + encodeURIComponent(id) + '/read', { method: 'POST' });
                    const payload = await response.json().catch(() => ({}));
                    if (!response.ok) return;
                    setCount(payload.unreadCount || 0);
                    await loadNotifications();
                });
            });
        };

        const loadNotifications = async () => {
            const response = await fetch('/api/account/notifications?limit=8', { headers: { Accept: 'application/json' } });
            const payload = await response.json().catch(() => ({}));
            if (!response.ok) {
                listEl.innerHTML = '<div class="text-center text-warning py-4">Failed to load notifications.</div>';
                return;
            }
            setCount(payload.unreadCount || 0);
            renderList(payload.notifications || []);
        };

        markAllBtn?.addEventListener('click', async () => {
            const response = await fetch('/api/account/notifications/read-all', { method: 'POST' });
            const payload = await response.json().catch(() => ({}));
            if (!response.ok) return;
            setCount(payload.unreadCount || 0);
            await loadNotifications();
        });

        try {
            const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
            const ws = new WebSocket(`${protocol}//${window.location.host}/ws/ui`);
            ws.onmessage = (event) => {
                try {
                    const data = JSON.parse(event.data);
                    if (data.type === 'notification:unread_count') {
                        setCount(data.unreadCount || 0);
                    }
                    if (data.type === 'notification:new' || data.type === 'notification:read') {
                        loadNotifications().catch(() => {});
                    }
                    if (data.type === 'notification:new' && data.browserDelivery && window.Notification && Notification.permission === 'granted' && data.notification) {
                        const browserNotification = new Notification(data.notification.title, {
                            body: data.notification.message,
                            tag: `cpanel-notification-${data.notification.id}`
                        });
                        browserNotification.onclick = () => {
                            window.focus();
                            window.location.href = data.notification.linkUrl || '/notifications';
                        };
                    }
                } catch (_) {}
            };
        } catch (_) {}

        loadNotifications().catch(() => {});
    })();
</script>
<% } %>

<% if (user) { %>
<div class="modal fade" id="userProfileModal" tabindex="-1" aria-labelledby="userProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg cpanel-profile-modal">
            <div class="modal-header border-bottom border-secondary border-opacity-25">
                <div class="d-flex align-items-center gap-2">
                    <img src="<%= (user.avatarProvider === 'url' && user.avatarUrl) ? user.avatarUrl : `https://www.gravatar.com/avatar/${user.gravatarHash}?d=retro` %>"
                        alt="Avatar" class="rounded-circle border border-secondary border-opacity-25"
                        style="object-fit: cover;" width="32" height="32">
                    <div>
                        <h5 class="modal-title fs-6 fw-bold mb-0" id="userProfileModalLabel"><%= user.username %></h5>
                        <small class="text-muted">Profile menu</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-2">
                <div class="d-grid gap-1 cpanel-profile-grid">
                    <a class="btn btn-dark text-start" href="/"><i class="bi bi-house-door-fill me-2"></i>Home</a>
                    <a class="btn btn-dark text-start" href="/account"><i class="bi bi-person-fill me-2"></i>Account Settings</a>
                    <a class="btn btn-dark text-start" href="/themes"><i class="bi bi-palette-fill me-2"></i>Themes</a>
                    <a class="btn btn-dark text-start" href="/rewards"><i class="bi bi-coin me-2"></i>Rewards</a>
                    <a class="btn btn-dark text-start" href="/afk"><i class="bi bi-hourglass-split me-2"></i>AFK Timer</a>
                    <a class="btn btn-dark text-start" href="/connectors-check"><i class="bi bi-hdd-network me-2"></i>Connectors Check</a>
                    <a class="btn btn-outline-info text-start" href="https://ko-fi.com/S6S11A22SE" target="_blank" rel="noopener noreferrer">
                        <i class="bi bi-cup-hot me-2"></i>Support The Dev
                    </a>

                    <% if (userCreateEnabled) { %>
                        <a class="btn btn-dark text-start" href="/store"><i class="bi bi-shop me-2"></i>Store</a>
                        <% if (storeDealsEnabled) { %>
                            <a class="btn btn-dark text-start" href="/store/deals"><i class="bi bi-stars me-2"></i>Store Deals</a>
                        <% } %>
                        <% if (storeRedeemCodesEnabled) { %>
                            <a class="btn btn-dark text-start" href="/store/redeem"><i class="bi bi-ticket-perforated me-2"></i>Redeem Codes</a>
                        <% } %>
                        <a class="btn btn-dark text-start" href="/user/create"><i class="bi bi-plus-square me-2"></i>Create Server</a>
                    <% } %>

                    <% if (user.isAdmin) { %>
                        <hr class="my-1 border-secondary border-opacity-25">
                        <a class="btn btn-outline-danger text-start" href="/admin"><i class="bi bi-shield-lock-fill me-2"></i>Admin Panel</a>
                    <% } %>

                    <hr class="my-1 border-secondary border-opacity-25">
                    <a class="btn btn-outline-danger text-start" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a>
                </div>
            </div>
        </div>
    </div>
</div>
<% } %>
