<%
const serverSidebarRuntimeBadges = (typeof serverSidebarBadges !== 'undefined' && serverSidebarBadges) ? serverSidebarBadges : {};
const buildServerBadge = (label, tone = 'info') => label ? { label, tone } : null;
const serverStatusText = String(server && server.status || '').toLowerCase();
const currentServerStatusBadge = serverStatusText === 'running'
    ? buildServerBadge('On', 'success')
    : (serverStatusText === 'installing' || serverStatusText === 'starting'
        ? buildServerBadge('Wait', 'warning')
        : buildServerBadge('Off', 'muted'));
const coreItems = [
    { id: 'dashboard', label: 'Back to Dashboard', icon: 'bi-grid-1x2', link: `/` },
    { id: 'overview', label: 'Overview', icon: 'bi-speedometer2', link: `/server/${server.containerId}/overview` },
    { id: 'console', label: 'Console', icon: 'bi-terminal', link: `/server/${server.containerId}`, turbo: false, badge: currentServerStatusBadge },
    { id: 'files', label: 'File Manager', icon: 'bi-folder2-open', link: `/server/${server.containerId}/files`, turbo: false, badge: buildServerBadge('Hot', 'info') },
    { id: 'dbs', label: 'Databases', icon: 'bi-database', link: `/server/${server.containerId}/databases` },
    { id: 'users', label: 'Users', icon: 'bi-people', link: `/server/${server.containerId}/users` },
    { id: 'api', label: 'API Keys', icon: 'bi-key', link: `/server/${server.containerId}/api` },
    { id: 'backups', label: 'Backups', icon: 'bi-archive', link: `/server/${server.containerId}/backups`, badge: serverSidebarRuntimeBadges.backups || buildServerBadge('Safe', 'success') }
];

const automationItems = [
    { id: 'schedules', label: 'Schedules', icon: 'bi-calendar-event', link: `/server/${server.containerId}/schedules` },
    { id: 'macros', label: 'Command Macros', icon: 'bi-lightning-charge', link: `/server/${server.containerId}/macros`, badge: buildServerBadge('Flow', 'violet') },
    { id: 'smartalerts', label: 'Smart Alerts', icon: 'bi-bell', link: `/server/${server.containerId}/smartalerts`, badge: serverSidebarRuntimeBadges.smartalerts || buildServerBadge('Live', 'danger') }
];

if (String(settings.featureScheduledScalingEnabled || 'false') === 'true') {
    automationItems.push({ id: 'scaling', label: 'Scheduled Scaling', icon: 'bi-sliders2-vertical', link: `/server/${server.containerId}/scaling` });
}
if (String(settings.featurePolicyEngineEnabled || 'false') === 'true') {
    automationItems.push({ id: 'policy', label: 'Policy Engine', icon: 'bi-shield-check', link: `/server/${server.containerId}/policy` });
}

const networkItems = [
    { id: 'network', label: 'Network', icon: 'bi-hdd-network', link: `/server/${server.containerId}/network` },
    { id: 'mounts', label: 'Mounts', icon: 'bi-link-45deg', link: `/server/${server.containerId}/mounts` }
];

const insightItems = [
    { id: 'activity', label: 'Activity', icon: 'bi-activity', link: `/server/${server.containerId}/activity`, badge: buildServerBadge('Logs', 'muted') },
    { id: 'auditconsole', label: 'Audit Console', icon: 'bi-journal-text', link: `/server/${server.containerId}/audit-console` },
    { id: 'timeline', label: 'Resource Timeline', icon: 'bi-graph-up-arrow', link: `/server/${server.containerId}/timeline`, badge: buildServerBadge('Live', 'success') },
    { id: 'performance', label: 'Performance', icon: 'bi-speedometer2', link: `/server/${server.containerId}/performance` },
    { id: 'debuglogs', label: 'Debug Logs', icon: 'bi-bug', link: `/server/${server.containerId}/debug-logs` }
];

const minecraftItems = [
    { id: 'mccenter', label: 'Minecraft Center', icon: 'bi-grid-1x2', link: `/server/${server.containerId}/minecraft-center`, badge: buildServerBadge('MC', 'warning') },
    { id: 'mcinstaller', label: 'Version Installer', icon: 'bi-cloud-download', link: `/server/${server.containerId}/minecraft/installer`, badge: buildServerBadge('Setup', 'info') }
];

const systemItems = [
    { id: 'startup', label: 'Startup', icon: 'bi-play-circle', link: `/server/${server.containerId}/startup` },
    { id: 'ai', label: 'AI Controls', icon: 'bi-robot', link: `/server/${server.containerId}/ai-manage`, badge: buildServerBadge('AI', 'violet') },
    { id: 'recovery', label: 'Recovery Assistant', icon: 'bi-life-preserver', link: `/server/${server.containerId}/recovery`, badge: buildServerBadge('Fix', 'warning') }
];

const navSections = [
    { title: 'Core', items: coreItems },
    { title: 'Automation', items: automationItems },
    { title: 'Network', items: networkItems },
    { title: 'Insights', items: insightItems },
    { title: 'Minecraft', items: minecraftItems },
    { title: 'System', items: systemItems }
].filter((section) => Array.isArray(section.items) && section.items.length > 0);
const serverNavBadgeForItem = (item) => {
    if (active === item.id) return buildServerBadge('Open', 'info');
    return item.badge || null;
};
%>

<div class="server-sidebar-panel">
    <div class="server-sidebar-header">
        <div class="server-sidebar-headline">
            <div class="server-sidebar-brand-mark">
                <img src="<%= settings.faviconUrl %>" alt="Brand" width="26" height="26">
            </div>
            <div class="server-sidebar-title-wrap">
                <div class="server-sidebar-title">Server Menu</div>
                <div class="server-sidebar-subtitle"><%= server.name %></div>
            </div>
        </div>
        <div class="nav-mode-switch server-nav-mode-switch">
            <button type="button" class="nav-mode-btn" data-server-nav-mode="modal">Popup</button>
            <button type="button" class="nav-mode-btn" data-server-nav-mode="sidebar">Sidebar</button>
            <button type="button" class="nav-mode-btn" data-server-nav-mode="navbar">Navbar</button>
        </div>
    </div>
    <% if (typeof serverPolicyBanner !== 'undefined' && serverPolicyBanner && serverPolicyBanner.visible && serverPolicyBanner.text) { %>
        <div class="server-policy-banner server-policy-banner-<%= serverPolicyBanner.tone === 'warning' ? 'warning' : 'info' %>">
            <i class="bi <%= serverPolicyBanner.tone === 'warning' ? 'bi-shield-exclamation' : 'bi-info-circle' %>"></i>
            <span><%= serverPolicyBanner.text %></span>
        </div>
    <% } %>
    <% navSections.forEach((section) => { %>
        <div class="sidebar-section">
            <div class="sidebar-section-head">
                <div class="sidebar-section-title"><%= section.title %></div>
                <span class="sidebar-section-count"><%= section.items.length %></span>
            </div>
            <div class="sidebar-section-items">
                <% section.items.forEach((item) => { %>
                    <a href="<%= item.link %>" class="sidebar-item <%= active === item.id ? 'active' : '' %>" <%= item.turbo === false ? 'data-turbo="false"' : '' %>>
                        <span class="sidebar-item-icon"><i class="bi <%= item.icon %>"></i></span>
                        <span class="sidebar-item-copy">
                            <span><%= item.label %></span>
                            <small><%= item.id === 'dashboard' ? 'Return to main dashboard' : `Open ${item.label.toLowerCase()}` %></small>
                        </span>
                        <% const serverBadge = serverNavBadgeForItem(item); %>
                        <% if (serverBadge) { %>
                            <span class="server-item-badge server-item-badge-<%= serverBadge.tone || 'info' %>"><%= serverBadge.label %></span>
                        <% } %>
                        <i class="bi bi-chevron-right sidebar-item-chevron"></i>
                    </a>
                <% }) %>
            </div>
        </div>
    <% }) %>
    <div class="server-sidebar-footer">
        <div class="server-sidebar-server-chip">
            <div class="server-sidebar-server-chip-icon">
                <i class="bi bi-hdd-stack"></i>
            </div>
            <div class="server-sidebar-server-chip-copy">
                <strong><%= server.name %></strong>
                <small><%= server.containerId %></small>
            </div>
        </div>
    </div>
</div>

<button type="button" class="server-menu-toggle" data-bs-toggle="modal" data-bs-target="#serverNavModal" aria-label="Open server menu">
    <i class="bi bi-grid"></i>
    <span>Server Menu</span>
</button>

<% if (typeof serverPolicyBanner !== 'undefined' && serverPolicyBanner && serverPolicyBanner.visible && serverPolicyBanner.text) { %>
    <div class="server-policy-inline-banner server-policy-banner-<%= serverPolicyBanner.tone === 'warning' ? 'warning' : 'info' %>">
        <i class="bi <%= serverPolicyBanner.tone === 'warning' ? 'bi-shield-exclamation' : 'bi-info-circle' %>"></i>
        <span><%= serverPolicyBanner.text %></span>
    </div>
<% } %>

<div class="server-nav-bar">
    <div class="server-nav-bar-inner">
        <div class="server-nav-bar-title"><%= server.name %></div>
        <div class="nav-mode-switch server-nav-mode-switch">
            <button type="button" class="nav-mode-btn" data-server-nav-mode="modal">Popup</button>
            <button type="button" class="nav-mode-btn" data-server-nav-mode="sidebar">Sidebar</button>
            <button type="button" class="nav-mode-btn" data-server-nav-mode="navbar">Navbar</button>
        </div>
    </div>
    <div class="server-nav-scroll" id="serverNavScroll">
        <% navSections.forEach((section) => { %>
            <div class="server-nav-group">
                <div class="server-nav-group-title"><%= section.title %></div>
                <div class="server-nav-group-items">
                    <% section.items.forEach((item) => { %>
                        <a href="<%= item.link %>" class="server-nav-link <%= active === item.id ? 'active' : '' %>" <%= item.turbo === false ? 'data-turbo="false"' : '' %>>
                            <i class="bi <%= item.icon %>"></i>
                            <span><%= item.label %></span>
                            <% const serverNavbarBadge = serverNavBadgeForItem(item); %>
                            <% if (serverNavbarBadge) { %>
                                <span class="server-navbar-badge server-item-badge-<%= serverNavbarBadge.tone || 'info' %>"><%= serverNavbarBadge.label %></span>
                            <% } %>
                        </a>
                    <% }) %>
                </div>
            </div>
        <% }) %>
    </div>
</div>

<div class="modal fade" id="serverNavModal" tabindex="-1" aria-labelledby="serverNavModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg">
        <div class="modal-content server-menu-modal">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-2">
                    <img src="<%= settings.faviconUrl %>" alt="Logo" width="32" height="32" class="rounded">
                    <div>
                        <div class="server-menu-title" id="serverNavModalLabel"><%= server.name %></div>
                        <div class="server-menu-subtitle"><%= settings.brandName %> server tools</div>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <% navSections.forEach((section) => { %>
                    <div class="server-menu-section">
                        <div class="server-menu-section-title"><%= section.title %></div>
                        <div class="server-menu-grid">
                            <% section.items.forEach((item) => { %>
                                <a href="<%= item.link %>" class="server-menu-link <%= active === item.id ? 'active' : '' %>" data-turbo="false">
                                    <div class="server-menu-icon"><i class="bi <%= item.icon %>"></i></div>
                                    <div>
                                        <div class="server-menu-label"><%= item.label %></div>
                                        <div class="server-menu-desc">Go to <%= item.label.toLowerCase() %></div>
                                    </div>
                                    <% const serverMenuBadge = serverNavBadgeForItem(item); %>
                                    <% if (serverMenuBadge) { %>
                                        <span class="server-menu-badge server-item-badge-<%= serverMenuBadge.tone || 'info' %>"><%= serverMenuBadge.label %></span>
                                    <% } %>
                                </a>
                            <% }) %>
                        </div>
                    </div>
                <% }) %>
            </div>
            <div class="modal-footer server-menu-footer">
                <div class="nav-mode-switch server-nav-mode-switch">
                    <button type="button" class="nav-mode-btn" data-server-nav-mode="modal">Popup</button>
                    <button type="button" class="nav-mode-btn" data-server-nav-mode="sidebar">Sidebar</button>
                    <button type="button" class="nav-mode-btn" data-server-nav-mode="navbar">Navbar</button>
                </div>
                <a href="https://ko-fi.com/S6S11A22SE" target="_blank" rel="noopener noreferrer" class="server-menu-support">
                    <i class="bi bi-cup-hot"></i>
                    Support The Dev
                </a>
                <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<style>
    :root[data-server-nav="modal"] #sidebarToggle,
    :root[data-server-nav="modal"] .navbar-toggle,
    :root[data-server-nav="modal"] .sidebar-toggle {
        display: none !important;
    }

    :root[data-server-nav="modal"] .sidebar {
        width: 0 !important;
        min-width: 0 !important;
        padding: 0 !important;
        border: 0 !important;
        background: transparent !important;
        overflow: visible !important;
    }

    :root[data-server-nav="modal"] .server-sidebar-panel {
        display: none;
    }

    :root[data-server-nav="sidebar"] .server-menu-toggle,
    :root[data-server-nav="navbar"] .server-menu-toggle {
        display: none;
    }

    :root[data-server-nav="navbar"] .sidebar {
        width: 0 !important;
        min-width: 0 !important;
        padding: 0 !important;
        border: 0 !important;
        background: transparent !important;
        overflow: visible !important;
    }

    :root[data-server-nav="navbar"] .server-sidebar-panel {
        display: none;
    }

    :root[data-server-nav="modal"] .server-nav-bar,
    :root[data-server-nav="sidebar"] .server-nav-bar {
        display: none;
    }

    :root[data-server-nav="navbar"] .server-nav-bar {
        display: block;
    }

    :root[data-server-nav="navbar"] .content,
    :root[data-server-nav="navbar"] .main-content,
    :root[data-server-nav="navbar"] .terminal-wrapper,
    :root[data-server-nav="navbar"] .scroll,
    :root[data-server-nav="navbar"] .scroll-area {
        padding-top: 4.25rem;
    }

    .server-sidebar-panel {
        padding: 0.75rem 0.55rem 1rem;
    }

    .server-policy-banner {
        display: flex;
        align-items: flex-start;
        gap: 0.65rem;
        margin: 0 0.75rem 1rem;
        padding: 0.85rem 0.9rem;
        border-radius: 14px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        font-size: 0.82rem;
        line-height: 1.45;
    }

    .server-policy-banner i {
        font-size: 1rem;
        margin-top: 0.08rem;
        flex-shrink: 0;
    }

    .server-policy-banner-warning {
        background: rgba(245, 158, 11, 0.11);
        border-color: rgba(245, 158, 11, 0.32);
        color: #fcd34d;
    }

    .server-policy-banner-info {
        background: rgba(59, 130, 246, 0.11);
        border-color: rgba(59, 130, 246, 0.28);
        color: #bfdbfe;
    }

    .server-policy-inline-banner {
        position: fixed;
        right: 1.2rem;
        bottom: 5.8rem;
        max-width: min(420px, calc(100vw - 2.4rem));
        z-index: 1035;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
    }

    :root[data-server-nav="sidebar"] .server-policy-inline-banner {
        display: none;
    }

    :root[data-server-nav="navbar"] .server-policy-inline-banner {
        top: 4.7rem;
        bottom: auto;
        left: 1rem;
        right: 1rem;
        max-width: none;
        margin: 0 auto;
    }

    @media (max-width: 768px) {
        .server-policy-inline-banner {
            left: 1rem;
            right: 1rem;
            bottom: 5.2rem;
            max-width: none;
        }
    }

    .server-sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.55rem 0.75rem 0.85rem;
    }

    .server-sidebar-headline {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        min-width: 0;
    }

    .server-sidebar-brand-mark {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background:
            radial-gradient(circle at 30% 25%, rgba(255,255,255,0.18), transparent 30%),
            linear-gradient(180deg, rgba(59,130,246,0.24), rgba(59,130,246,0.08));
        border: 1px solid rgba(255,255,255,0.08);
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.18);
        overflow: hidden;
        flex-shrink: 0;
    }

    .server-sidebar-brand-mark img {
        width: 26px;
        height: 26px;
        object-fit: cover;
        border-radius: 9px;
    }

    .server-sidebar-title-wrap {
        min-width: 0;
        display: flex;
        flex-direction: column;
    }

    .server-sidebar-title {
        font-weight: 700;
        font-size: 0.95rem;
        color: #eef2ff;
        line-height: 1.05;
    }

    .server-sidebar-subtitle {
        color: rgba(255, 255, 255, 0.46);
        font-size: 0.73rem;
        margin-top: 0.18rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .nav-mode-switch {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.25rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .nav-mode-btn {
        border: 0;
        background: transparent;
        color: #aab0bf;
        font-size: 0.72rem;
        padding: 0.25rem 0.6rem;
        border-radius: 999px;
        font-weight: 600;
        letter-spacing: 0.02em;
        transition: all 0.2s ease;
    }

    .nav-mode-btn.active {
        background: rgba(59, 130, 246, 0.25);
        color: #fff;
    }

    .nav-mode-btn:hover {
        color: #fff;
    }

    .sidebar-section {
        margin-bottom: 0.8rem;
    }

    .sidebar-section-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin: 0.45rem 0.9rem 0.4rem;
    }

    .sidebar-section-title {
        font-size: 0.68rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.4);
        font-weight: 700;
        margin: 0;
    }

    .sidebar-section-count {
        min-width: 22px;
        height: 22px;
        padding: 0 0.35rem;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(59, 130, 246, 0.12);
        border: 1px solid rgba(59, 130, 246, 0.18);
        color: #9ec5ff;
        font-size: 0.68rem;
        font-weight: 700;
    }

    .sidebar-section-items {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        padding: 0 0.5rem;
    }

    .sidebar-section-items .sidebar-item {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: 0.72rem;
        padding: 0.68rem 0.78rem;
        min-height: 56px;
        border-radius: 16px;
        color: #d7e0f7;
        text-decoration: none;
        border: 1px solid transparent;
        transition: all 0.2s ease;
    }

    .sidebar-section-items .sidebar-item:hover {
        background: rgba(59, 130, 246, 0.08);
        border-color: rgba(59, 130, 246, 0.16);
        color: #fff;
        transform: translateX(1px);
    }

    .sidebar-section-items .sidebar-item.active {
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.22), rgba(59, 130, 246, 0.08));
        color: #fff;
        box-shadow: inset 0 0 0 1px rgba(59, 130, 246, 0.25);
    }

    .sidebar-item-icon {
        width: 36px;
        height: 36px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.06);
        color: #9cc4ff;
        flex-shrink: 0;
    }

    .sidebar-item.active .sidebar-item-icon {
        background: rgba(59, 130, 246, 0.16);
        border-color: rgba(59, 130, 246, 0.18);
        color: #fff;
    }

    .sidebar-item-copy {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.12rem;
    }

    .sidebar-item-copy > span {
        line-height: 1.1;
        font-weight: 700;
    }

    .sidebar-item-copy small {
        color: rgba(255, 255, 255, 0.42);
        font-size: 0.72rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .sidebar-item-chevron {
        color: rgba(255, 255, 255, 0.26);
        font-size: 0.82rem;
    }

    .server-item-badge,
    .server-navbar-badge,
    .server-menu-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 20px;
        padding: 0 0.45rem;
        border-radius: 999px;
        border: 1px solid rgba(59, 130, 246, 0.24);
        background: rgba(59, 130, 246, 0.14);
        color: #bdd9ff;
        font-size: 0.64rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        flex-shrink: 0;
    }

    .server-item-badge-info {
        border-color: rgba(59, 130, 246, 0.24);
        background: rgba(59, 130, 246, 0.14);
        color: #bdd9ff;
    }

    .server-item-badge-success {
        border-color: rgba(53, 211, 138, 0.26);
        background: rgba(53, 211, 138, 0.14);
        color: #bdf5d3;
    }

    .server-item-badge-warning {
        border-color: rgba(255, 191, 77, 0.26);
        background: rgba(255, 191, 77, 0.14);
        color: #ffe2a6;
    }

    .server-item-badge-danger {
        border-color: rgba(255, 114, 114, 0.26);
        background: rgba(255, 114, 114, 0.14);
        color: #ffc4c4;
    }

    .server-item-badge-violet {
        border-color: rgba(144, 128, 255, 0.26);
        background: rgba(144, 128, 255, 0.14);
        color: #dad2ff;
    }

    .server-item-badge-muted {
        border-color: rgba(255, 255, 255, 0.12);
        background: rgba(255, 255, 255, 0.06);
        color: #d7def0;
    }

    .sidebar-item:hover .sidebar-item-chevron,
    .sidebar-item.active .sidebar-item-chevron {
        color: rgba(255,255,255,0.68);
    }

    .server-sidebar-footer {
        padding: 0.2rem 0.75rem 0;
    }

    .server-sidebar-server-chip {
        display: flex;
        align-items: center;
        gap: 0.72rem;
        padding: 0.8rem 0.85rem;
        border-radius: 18px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.07);
    }

    .server-sidebar-server-chip-icon {
        width: 36px;
        height: 36px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(59, 130, 246, 0.12);
        border: 1px solid rgba(59, 130, 246, 0.14);
        color: #a6ccff;
    }

    .server-sidebar-server-chip-copy {
        min-width: 0;
    }

    .server-sidebar-server-chip-copy strong {
        display: block;
