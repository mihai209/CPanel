<script>
    (function () {
        const storageKey = 'cpanel.serverNavMode';
        const root = document.documentElement;
        const modeButtons = Array.from(document.querySelectorAll('[data-server-nav-mode]'));
        const modalEl = document.getElementById('serverNavModal');
        const serverId = "<%= server.containerId %>";
        const applyMode = (mode) => {
            const next = ['modal', 'sidebar', 'navbar'].includes(mode) ? mode : 'modal';
            root.dataset.serverNav = next;
            localStorage.setItem(storageKey, next);
            modeButtons.forEach((button) => {
                button.classList.toggle('active', button.dataset.serverNavMode === next);
            });
            if (next !== 'modal' && modalEl && window.bootstrap) {
                const modal = window.bootstrap.Modal.getInstance(modalEl);
                if (modal) modal.hide();
            }
        };
        const savedMode = localStorage.getItem(storageKey);
        applyMode(savedMode || 'modal');
        modeButtons.forEach((button) => {
            button.addEventListener('click', () => {
                applyMode(button.dataset.serverNavMode);
            });
        });

        const isEditableTarget = (target) => {
            if (!target) return false;
            const tag = String(target.tagName || '').toLowerCase();
            return target.isContentEditable || tag === 'input' || tag === 'textarea' || tag === 'select';
        };

        const openServerMenu = () => {
            if (root.dataset.serverNav !== 'modal') return;
            const modalEl = document.getElementById('serverNavModal');
            if (!modalEl || !window.bootstrap) return;
            const modal = window.bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        };

        const sidebarEl = document.querySelector('.sidebar');
        const sidebarScrollKey = `cpanel.serverSidebarScroll.${serverId}`;
        if (sidebarEl) {
            const savedScroll = Number.parseInt(localStorage.getItem(sidebarScrollKey), 10);
            if (Number.isFinite(savedScroll)) {
                sidebarEl.scrollTop = savedScroll;
            }
            let sidebarScrollTimer;
            sidebarEl.addEventListener('scroll', () => {
                window.clearTimeout(sidebarScrollTimer);
                sidebarScrollTimer = window.setTimeout(() => {
                    localStorage.setItem(sidebarScrollKey, String(sidebarEl.scrollTop || 0));
                }, 120);
            });
        }

        const navScrollEl = document.getElementById('serverNavScroll');
        const navScrollKey = `cpanel.serverNavbarScroll.${serverId}`;
        if (navScrollEl) {
            const savedLeft = Number.parseInt(localStorage.getItem(navScrollKey), 10);
            if (Number.isFinite(savedLeft)) {
                navScrollEl.scrollLeft = savedLeft;
            }
            let navScrollTimer;
            navScrollEl.addEventListener('scroll', () => {
                window.clearTimeout(navScrollTimer);
                navScrollTimer = window.setTimeout(() => {
                    localStorage.setItem(navScrollKey, String(navScrollEl.scrollLeft || 0));
                }, 120);
            });
        }

        const menuButton = document.querySelector('.server-menu-toggle');
        const menuPosKey = `cpanel.serverMenuButtonPos`;
        if (menuButton) {
            const clamp = (value, min, max) => Math.min(Math.max(value, min), max);
            const applyMenuPos = (pos) => {
                if (!pos || typeof pos.left !== 'number' || typeof pos.top !== 'number') return;
                menuButton.style.position = 'fixed';
                menuButton.style.left = `${pos.left}px`;
                menuButton.style.top = `${pos.top}px`;
                menuButton.style.right = 'auto';
                menuButton.style.bottom = 'auto';
                menuButton.style.zIndex = '1090';
            };
            try {
                const stored = JSON.parse(localStorage.getItem(menuPosKey) || 'null');
                if (stored) applyMenuPos(stored);
            } catch (_) {}

            let dragging = false;
            let dragOffsetX = 0;
            let dragOffsetY = 0;

            const stopDragging = () => {
                if (!dragging) return;
                dragging = false;
                menuButton.dataset.dragging = 'false';
                document.body.style.userSelect = '';
                document.body.style.cursor = '';
                const rect = menuButton.getBoundingClientRect();
                const pos = { left: Math.round(rect.left), top: Math.round(rect.top) };
                localStorage.setItem(menuPosKey, JSON.stringify(pos));
            };

            menuButton.addEventListener('pointerdown', (event) => {
                if (!event.shiftKey) return;
                event.preventDefault();
                event.stopPropagation();
                const rect = menuButton.getBoundingClientRect();
                dragging = true;
                menuButton.dataset.dragging = 'true';
                dragOffsetX = event.clientX - rect.left;
                dragOffsetY = event.clientY - rect.top;
                document.body.style.userSelect = 'none';
                document.body.style.cursor = 'grabbing';
                menuButton.setPointerCapture(event.pointerId);
            });

            menuButton.addEventListener('pointermove', (event) => {
                if (!dragging) return;
                event.preventDefault();
                const rect = menuButton.getBoundingClientRect();
                const maxLeft = window.innerWidth - rect.width;
                const maxTop = window.innerHeight - rect.height;
                const left = clamp(event.clientX - dragOffsetX, 0, maxLeft);
                const top = clamp(event.clientY - dragOffsetY, 0, maxTop);
                applyMenuPos({ left, top });
            });

            menuButton.addEventListener('pointerup', (event) => {
                if (!dragging) return;
                event.preventDefault();
                stopDragging();
            });

            menuButton.addEventListener('pointercancel', stopDragging);

            menuButton.addEventListener('click', (event) => {
                if (menuButton.dataset.dragging === 'true') {
                    event.preventDefault();
                    event.stopPropagation();
                    menuButton.dataset.dragging = 'false';
                }
            });
        }

        document.addEventListener('keydown', (event) => {
            if (event.defaultPrevented) return;
            if (isEditableTarget(event.target)) return;
            const key = String(event.key || '').toLowerCase();
            if ((event.ctrlKey || event.metaKey) && !event.shiftKey && key === 'k') {
                event.preventDefault();
                openServerMenu();
            }
        });
    })();
</script>
<script>
    (() => {
        if (window.__csrfInjected) return;
        const token = <%- JSON.stringify(typeof csrfToken !== 'undefined' ? csrfToken : '') %>;
        if (!token) return;
        window.__csrfInjected = true;

        const ensureFormToken = (form) => {
            if (!form || !form.method || String(form.method).toLowerCase() === 'get') return;
            if (form.querySelector('input[name="_csrf"]')) return;
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = '_csrf';
            input.value = token;
            form.appendChild(input);
        };

        document.querySelectorAll('form').forEach(ensureFormToken);
        document.addEventListener('submit', (event) => ensureFormToken(event.target));
        if (!HTMLFormElement.prototype.__csrfWrapped) {
            const originalSubmit = HTMLFormElement.prototype.submit;
            HTMLFormElement.prototype.submit = function() {
                try { ensureFormToken(this); } catch (_) {}
                return originalSubmit.call(this);
            };
            HTMLFormElement.prototype.__csrfWrapped = true;
        }

        const isSameOrigin = (url) => {
            try {
                const u = new URL(url, window.location.origin);
                return u.origin === window.location.origin;
            } catch (_) {
                return true;
            }
        };

        if (typeof window.fetch === 'function') {
            const originalFetch = window.fetch.bind(window);
            window.fetch = (input, init = {}) => {
                const url = typeof input === 'string' ? input : (input && input.url) || '';
                if (isSameOrigin(url)) {
                    const headers = new Headers((init && init.headers) || {});
                    if (!headers.has('X-CSRF-Token') && !headers.has('CSRF-Token')) {
                        headers.set('X-CSRF-Token', token);
                    }
                    init = Object.assign({}, init, { headers });
                }
                return originalFetch(input, init);
            };
        }

        const originalOpen = XMLHttpRequest.prototype.open;
        const originalSend = XMLHttpRequest.prototype.send;
        XMLHttpRequest.prototype.open = function(method, url, ...rest) {
            this.__csrfUrl = url;
            return originalOpen.call(this, method, url, ...rest);
        };
        XMLHttpRequest.prototype.send = function(body) {
            if (this.__csrfUrl && isSameOrigin(this.__csrfUrl)) {
                try {
                    this.setRequestHeader('X-CSRF-Token', token);
                } catch (_) {}
            }
            return originalSend.call(this, body);
        };
    })();
</script>
