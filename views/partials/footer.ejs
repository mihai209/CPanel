<style>
    .cpanel-footer-shell {
        border-radius: 22px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background:
            radial-gradient(circle at top left, rgba(79, 124, 255, 0.12), transparent 35%),
            linear-gradient(180deg, rgba(255,255,255,0.035), rgba(255,255,255,0.012));
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.02);
        overflow: hidden;
    }

    .copyright-footer {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) auto;
        gap: 1rem;
        align-items: center;
        padding: 0.75rem 0.9rem;
        color: #94a3c3;
        font-size: 0.78rem;
    }

    .copyright-main {
        min-width: 0;
    }

    .copyright-brand-row {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        flex-wrap: wrap;
    }

    .copyright-brand-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        min-height: 36px;
        padding: 0 0.8rem 0 0.5rem;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.08);
        background: rgba(255,255,255,0.03);
        color: #edf2ff;
        font-weight: 800;
        letter-spacing: 0.04em;
    }

    .copyright-brand-chip img {
        width: 24px;
        height: 24px;
        border-radius: 10px;
        object-fit: cover;
    }

    .copyright-copy {
        margin-top: 0.4rem;
        line-height: 1.45;
    }

    .copyright-copy strong {
        color: #eef2ff;
        font-weight: 700;
    }

    .copyright-footer a {
        color: #b4c2df;
        text-decoration: none;
        font-weight: 700;
        transition: color 0.2s;
    }

    .copyright-footer a:hover {
        color: #ffffff;
    }

    .copyright-links {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        flex-wrap: wrap;
        margin-top: 0.55rem;
    }

    .copyright-link-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.42rem;
        min-height: 30px;
        padding: 0 0.7rem;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.08);
        background: rgba(255,255,255,0.03);
        color: #d9e2f7;
        font-size: 0.72rem;
        font-weight: 800;
    }

    .copyright-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.6rem;
        flex-wrap: wrap;
    }

    .copyright-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        min-height: 34px;
        padding: 0 0.8rem;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.08);
        background: rgba(255,255,255,0.035);
        color: #edf2ff;
        font-size: 0.74rem;
        font-weight: 800;
        text-decoration: none;
    }

    .copyright-info-btn {
        background: rgba(79, 124, 255, 0.14);
        border: 1px solid rgba(79, 124, 255, 0.22);
        color: #dce7ff;
        font: inherit;
        cursor: pointer;
        padding: 0 0.8rem;
        min-height: 34px;
        border-radius: 999px;
        font-size: 0.74rem;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
    }

    .copyright-info-btn:hover {
        color: #ffffff;
    }

    .copyright-info-modal .modal-dialog {
        max-width: min(680px, calc(100vw - 2rem));
        margin: 1rem auto;
    }

    .copyright-info-modal .modal-content {
        border-radius: 26px;
        overflow: hidden;
        background:
            radial-gradient(circle at top left, rgba(79, 124, 255, 0.12), transparent 34%),
            linear-gradient(180deg, rgba(10, 18, 32, 0.98), rgba(7, 12, 24, 0.98)) !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        box-shadow: 0 28px 80px rgba(0, 0, 0, 0.42);
        color: #ecf3ff;
    }

    .copyright-info-modal .modal-header,
    .copyright-info-modal .modal-footer {
        background: rgba(255, 255, 255, 0.02);
        border-color: rgba(255, 255, 255, 0.08) !important;
    }

    .copyright-info-modal .modal-title {
        font-size: 1rem;
        letter-spacing: 0.01em;
    }

    .copyright-info-modal .modal-body {
        padding: 1.25rem 1.35rem 1.1rem;
    }

    .copyright-info-modal .modal-body h6 {
        font-size: 0.95rem;
        letter-spacing: 0.01em;
    }

    .copyright-info-modal .modal-body p,
    .copyright-info-modal .modal-body div {
        line-height: 1.65;
    }

    .copyright-info-modal .modal-body .text-muted {
        color: #aab8d8 !important;
    }

    .copyright-info-modal .btn-secondary {
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.12);
    }

    @media (max-width: 900px) {
        .copyright-footer {
            grid-template-columns: 1fr;
            align-items: start;
        }

        .copyright-actions {
            justify-content: flex-start;
        }
    }

</style>

<div class="cpanel-footer-shell">
    <div class="copyright-footer">
        <div class="copyright-main">
            <div class="copyright-brand-row">
                <span class="copyright-brand-chip">
                    <img src="<%= settings.faviconUrl %>" alt="Brand">
                    <span><%= (settings.brandName || 'CPanel').toUpperCase() %></span>
                </span>
            </div>
            <div class="copyright-copy">
                <strong><a href="https://cpanel-rocky.netlify.app" target="_blank">CPanel Rocky</a></strong> &copy; 2026.
                Developed by <a href="https://github.com/mihai209" target="_blank">Mihai209</a>. Independent project, MIT licensed, and not affiliated with Pterodactyl.
            </div>
            <div class="copyright-links">
                <a class="copyright-link-pill" href="https://ko-fi.com/mihai14launcher" target="_blank">
                    <i class="bi bi-cup-hot"></i> Ko-fi
                </a>
                <a class="copyright-link-pill" href="https://buymeacoffee.com/mihai14launcher" target="_blank">
                    <i class="bi bi-cup-straw"></i> Buy Me a Coffee
                </a>
                <a class="copyright-link-pill" href="https://github.com/sponsors/mihai209" target="_blank">
                    <i class="bi bi-github"></i> GitHub Sponsors
                </a>
            </div>
        </div>
        <div class="copyright-actions">
            <a href="https://cpanel-rocky.netlify.app" target="_blank" class="copyright-action-btn">
                <i class="bi bi-box-arrow-up-right"></i>
                Website
            </a>
            <button type="button" class="copyright-info-btn" data-bs-toggle="modal" data-bs-target="#copyrightInfoModal">
                <i class="bi bi-info-circle"></i>
                Licensing & Support
            </button>
        </div>
    </div>
</div>
<script>
    (() => {
        if (window.__csrfInjected) return;
        const token = <%- JSON.stringify(typeof csrfToken !== 'undefined' ? csrfToken : '') %>;
        if (!token) return;
        window.__csrfInjected = true;

        const ensureFormToken = (form) => {
            if (!form || !form.method || String(form.method).toLowerCase() === 'get') return;
            if (form.querySelector('input[name="_csrf"]')) return;
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = '_csrf';
            input.value = token;
            form.appendChild(input);
        };

        document.querySelectorAll('form').forEach(ensureFormToken);
        document.addEventListener('submit', (event) => ensureFormToken(event.target));
        if (!HTMLFormElement.prototype.__csrfWrapped) {
            const originalSubmit = HTMLFormElement.prototype.submit;
            HTMLFormElement.prototype.submit = function() {
                try { ensureFormToken(this); } catch (_) {}
                return originalSubmit.call(this);
            };
            HTMLFormElement.prototype.__csrfWrapped = true;
        }

        const isSameOrigin = (url) => {
            try {
                const u = new URL(url, window.location.origin);
                return u.origin === window.location.origin;
            } catch (_) {
                return true;
            }
        };

        if (typeof window.fetch === 'function') {
            const originalFetch = window.fetch.bind(window);
            window.fetch = (input, init = {}) => {
                const url = typeof input === 'string' ? input : (input && input.url) || '';
                if (isSameOrigin(url)) {
                    const headers = new Headers((init && init.headers) || {});
                    if (!headers.has('X-CSRF-Token') && !headers.has('CSRF-Token')) {
                        headers.set('X-CSRF-Token', token);
                    }
                    init = Object.assign({}, init, { headers });
                }
                return originalFetch(input, init);
            };
        }

        const originalOpen = XMLHttpRequest.prototype.open;
        const originalSend = XMLHttpRequest.prototype.send;
        XMLHttpRequest.prototype.open = function(method, url, ...rest) {
            this.__csrfUrl = url;
            return originalOpen.call(this, method, url, ...rest);
        };
        XMLHttpRequest.prototype.send = function(body) {
            if (this.__csrfUrl && isSameOrigin(this.__csrfUrl)) {
                try {
                    this.setRequestHeader('X-CSRF-Token', token);
                } catch (_) {}
            }
            return originalSend.call(this, body);
        };
    })();
</script>

<!-- Copyright Info Modal -->
<div class="modal fade copyright-info-modal" id="copyrightInfoModal" tabindex="-1" aria-labelledby="copyrightInfoModalLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg text-start"
            style="background-color: #1a1a20; border: 1px solid #2d2d35 !important;">
            <div class="modal-header border-bottom border-secondary border-opacity-10">
                <h5 class="modal-title fs-6 fw-bold text-light" id="copyrightInfoModalLabel">Licensing & Support</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                    aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <h6 class="text-light fw-bold mb-2">MIT License</h6>
                <p class="text-muted small mb-4">
                    CPanel is distributed under the MIT License. You are free to use, copy, modify, merge, publish,
                    distribute, sublicense, and/or sell copies of the software, subject to the conditions of the
                    license.
                </p>

                <h6 class="text-light fw-bold mb-2">Disclaimer</h6>
                <p class="text-muted small mb-4">
                    CPanel is <strong>not associated</strong> with <a href="https://pterodactyl.io" target="_blank"
                        class="text-info text-decoration-none">pterodactyl.io</a> or the Pterodactyl Panel. This
                    software
                    is merely inspired by its design and concepts, but remains an independent project.
                </p>

                <hr class="border-secondary border-opacity-10 mb-4">

                <h6 class="text-warning fw-bold mb-2">Support & Modification Policy</h6>
                <div class="text-light small opacity-75">
                    <p class="mb-3">
                        You are free to <strong>modify any assets, styles, and logic</strong> within the panel and
                        connector to suit your needs.
                    </p>
                    <p class="mb-3">
                        However, please be advised that <strong>removing or modifying the copyright notices in the
                            footer</strong> will result in the <strong>immediate and automatic termination of
                            support</strong> from the developer.
                    </p>
                    <p class="mb-0">
                        Support is provided solely by Mihai209 to users who maintain the original branding in the
                        footer. By using this software, you agree to keep the copyright links visible.
                    </p>
                </div>
            </div>
            <div class="modal-footer border-top border-secondary border-opacity-10">
                <button type="button" class="btn btn-secondary px-4 fw-bold" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script>
    (() => {
        const moveFooterModalToBody = () => {
            const modal = document.getElementById('copyrightInfoModal');
            if (!modal || modal.dataset.portalMounted === 'true') return;
            document.body.appendChild(modal);
            modal.dataset.portalMounted = 'true';
        };

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', moveFooterModalToBody, { once: true });
        } else {
            moveFooterModalToBody();
        }
    })();
</script>
